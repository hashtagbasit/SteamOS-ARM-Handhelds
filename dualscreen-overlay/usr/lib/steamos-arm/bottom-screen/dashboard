        return False
    try:
        mx = int(rd(f"{d}/max_brightness", "0"))
    except ValueError:
        return False
    value = max(1, round(mx * max(1, min(100, percent)) / 100))
    path = session_path()
    if not path:
        return False
    run("busctl", "call", "org.freedesktop.login1", path, "org.freedesktop.login1.Session",
        "SetBrightness", "ssu", "backlight", name, str(value))
    return True


THOR_BACKLIGHT_SOCK = "/run/steamos-arm/thor-backlight.sock"


def dual_backlight(req: dict | None = None) -> dict | None:
    """thor-backlightd: Steam's level for both Thor screens, the bottom
    screen's share of it, and the bottom screen on/off. None elsewhere."""
    if not os.path.exists(THOR_BACKLIGHT_SOCK):
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(2)
            sock.connect(THOR_BACKLIGHT_SOCK)
            sock.sendall(json.dumps(req or {"op": "get"}).encode() + b"\n")
            data = b""
            while not data.endswith(b"\n"):
                chunk = sock.recv(4096)
                if not chunk:
                    break
                data += chunk
        reply = json.loads(data or b"{}")
        return None if "error" in reply else reply
    except (OSError, ValueError):
        return None


