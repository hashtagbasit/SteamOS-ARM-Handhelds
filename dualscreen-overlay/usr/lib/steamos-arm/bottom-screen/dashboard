# ------------------------------------------------------- frame generation --
# lsfg-vk's per-game profiles (decky-lsfg-vk writes them, keyed by app id).
# lsfg-vk rereads the file while the game runs, so a change shows at once.
LSFG_CONF = Path.home() / ".config/lsfg-vk/conf.toml"
FG_DEFAULTS = {"pacing_mode": '"vsync"', "flow_scale": "0.5", "performance_mode": "true",
               "override_present_mode": "true", "preserve_swapchain_image_count": "false"}


def _fg_blocks(text: str) -> list[tuple[int, int, str]]:
    """(start, end, block text) of every [[profile]] table."""
    starts = [m.start() for m in re.finditer(r"(?m)^\[\[profile\]\]\s*$", text)]
    return [(a, b, text[a:b]) for a, b in zip(starts, starts[1:] + [len(text)])]


def fg_state(appid: int) -> dict | None:
    if not appid or not LSFG_CONF.is_file():
        return None
    try:
        text = LSFG_CONF.read_text(encoding="utf-8")
    except OSError:
        return None
    for _a, _b, block in _fg_blocks(text):
        if re.search(r'active_in\s*=\s*\[[^\]]*"%d"' % appid, block):
            mult = re.search(r"(?m)^multiplier\s*=\s*(\d+)", block)
            flow = re.search(r"(?m)^flow_scale\s*=\s*([\d.]+)", block)
            return {"multiplier": int(mult.group(1)) if mult else 1,
                    "flow": float(flow.group(1)) if flow else 1.0, "profile": True}
    return {"multiplier": 1, "flow": float(FG_DEFAULTS["flow_scale"]), "profile": False}


def fg_set(appid: int, name: str, multiplier: int) -> bool:
    """Set the running game's frame generation (1 = off), making its profile
    with the Adreno defaults (performance mode, flow 0.5) if it has none."""
    if not appid or not LSFG_CONF.is_file() or not 1 <= multiplier <= 4:
        return False
    text = LSFG_CONF.read_text(encoding="utf-8")
    for a, b, block in _fg_blocks(text):
        if re.search(r'active_in\s*=\s*\[[^\]]*"%d"' % appid, block):
            if re.search(r"(?m)^multiplier\s*=", block):
                block = re.sub(r"(?m)^multiplier\s*=\s*\d+", f"multiplier = {multiplier}", block)
            else:
                block = block.rstrip("\n") + f"\nmultiplier = {multiplier}\n\n"
            text = text[:a] + block + text[b:]
            break
    else:
        title = (name or str(appid)).replace("\\", "").replace('"', "")
        text = text.rstrip("\n") + "\n\n[[profile]]\n" + f'name = "{title}"\nactive_in = [ "{appid}" ]\n' \
            + f"multiplier = {multiplier}\n" + "".join(f"{k} = {v}\n" for k, v in FG_DEFAULTS.items())
    tmp = LSFG_CONF.with_name(".conf.toml.dash")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, LSFG_CONF)
    return True


