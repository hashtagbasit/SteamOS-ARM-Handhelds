# ------------------------------------------------------- recent games ----
# "Jump back in" on the home screen: what was played last, from Steam's own
# records (localconfig.vdf for Steam games, shortcuts.vdf for the rest, the
# Emulator Hub's included), with the library art Steam already has.
def vdf_text(text: str) -> dict:
    """Steam's text VDF as nested dicts."""
    tokens = re.findall(r'"((?:[^"\\]|\\.)*)"|([{}])', text)
    root: dict = {}
    stack = [root]
    key = None
    for quoted, brace in tokens:
        if brace == "{":
            new: dict = {}
            stack[-1][key if key is not None else ""] = new
            stack.append(new)
            key = None
        elif brace == "}":
            if len(stack) > 1:
                stack.pop()
            key = None
        elif key is None:
            key = quoted
        else:
            stack[-1][key] = quoted
            key = None
    return root


def vdf_binary(data: bytes) -> dict:
    pos = 0

    def cstr() -> str:
        nonlocal pos
        end = data.index(b"\0", pos)
        out = data[pos:end].decode(errors="replace")
        pos = end + 1
        return out

    def obj() -> dict:
        nonlocal pos
        out: dict = {}
        while pos < len(data):
            t = data[pos]
            pos += 1
            if t == 8:
                return out
            k = cstr()
            if t == 0:
                out[k] = obj()
            elif t == 1:
                out[k] = cstr()
            elif t == 2:
                out[k] = int.from_bytes(data[pos:pos + 4], "little")
                pos += 4
            else:
                raise ValueError(t)
        return out
    return obj()


_recent_cache: tuple[float, list] = (0.0, [])


def steam_art(appid: int, user_dir: Path | None = None, shortcut: bool = False) -> str:
    if shortcut and user_dir:
        for ext in ("png", "jpg"):
            p = user_dir / "config" / "grid" / f"{appid}p.{ext}"
            if p.exists():
                return str(p)
        return ""
    cache = STEAM_HOME / "appcache" / "librarycache"
    for p in (cache / str(appid) / "library_600x900.jpg", cache / f"{appid}_library_600x900.jpg",
              cache / str(appid) / "header.jpg", cache / f"{appid}_header.jpg"):
        if p.exists():
            return str(p)
    return ""


def recent_games(count: int = 8) -> list[dict]:
    global _recent_cache
    if time.monotonic() - _recent_cache[0] < 30:
        return _recent_cache[1]
    found: list[dict] = []
    for user_dir in (STEAM_HOME / "userdata").glob("[0-9]*"):
        try:
            lc = vdf_text((user_dir / "config" / "localconfig.vdf").read_text(errors="replace"))
            apps = lc["UserLocalConfigStore"]["Software"]["Valve"]["Steam"]["apps"]
        except (OSError, KeyError, TypeError):
            apps = {}
        for appid, info in apps.items():
            try:
                last, aid = int(info.get("LastPlayed", 0)), int(appid)
            except (ValueError, AttributeError):
                continue
            name = GAMES.name(aid) if last else ""
            if name and aid not in NOT_GAMES:
                found.append({"gameid": str(aid), "name": name, "last": last, "art": steam_art(aid)})
        try:
            sc = vdf_binary((user_dir / "config" / "shortcuts.vdf").read_bytes()).get("shortcuts", {})
        except (OSError, ValueError, IndexError):
            sc = {}
        for item in sc.values():
            last = int(item.get("LastPlayTime", 0) or 0)
            appid = int(item.get("appid", 0)) & 0xFFFFFFFF
            if last and appid:
                found.append({"gameid": str((appid << 32) | 0x02000000), "name": item.get("AppName", ""),
                              "last": last, "art": steam_art(appid, user_dir, shortcut=True)})
    found.sort(key=lambda g: g["last"], reverse=True)
    seen, out = set(), []
    for g in found:
        if g["gameid"] not in seen:
            seen.add(g["gameid"])
            out.append(g)
    _recent_cache = (time.monotonic(), out[:count])
    return _recent_cache[1]


def play_game(gameid: str) -> bool:
    """Start it on the top screen: the running Steam takes the URL."""
    if not re.fullmatch(r"\d+", gameid) or DESKTOP:
        return False
    env = dict(os.environ, DISPLAY=steam_display())
    try:
        subprocess.Popen(["steam", f"steam://rungameid/{gameid}"], env=env, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except OSError:
        return False


# ------------------------------------------------------------ media ----
# Now Playing: whatever plays through MPRIS (Firefox, Spotify, a web app...).
_media_cache: tuple[float, dict] = (0.0, {})


def _mpris():
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    return Gio, GLib, Gio.bus_get_sync(Gio.BusType.SESSION, None)


def media() -> dict:
    global _media_cache
    if time.monotonic() - _media_cache[0] < 1.0:
        return _media_cache[1]
    out: dict = {}
    try:
        Gio, GLib, bus = _mpris()
        names = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                              "ListNames", None, None, Gio.DBusCallFlags.NONE, 500, None).unpack()[0]
        players = []
        for n in names:
            if not n.startswith("org.mpris.MediaPlayer2."):
                continue
            props = bus.call_sync(n, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties", "GetAll",
                                  GLib.Variant("(s)", ("org.mpris.MediaPlayer2.Player",)), None,
                                  Gio.DBusCallFlags.NONE, 500, None).unpack()[0]
            md = props.get("Metadata", {}) or {}
            title = md.get("xesam:title") or ""
            if not title:
                continue
            players.append({"player": n, "title": title,
                            "artist": ", ".join(md.get("xesam:artist") or []),
                            "art": md.get("mpris:artUrl") or "",
                            "status": props.get("PlaybackStatus", ""),
                            "app": n.split(".")[3] if len(n.split(".")) > 3 else ""})
        # The one playing, else the last one paused.
        players.sort(key=lambda p: p["status"] != "Playing")
        out = players[0] if players else {}
    except Exception as exc:  # no session bus (tests), a player going away
        log(f"media: {exc}")
    _media_cache = (time.monotonic(), out)
    return out


def media_control(action: str) -> bool:
    method = {"playpause": "PlayPause", "next": "Next", "previous": "Previous"}.get(action)
    player = media().get("player")
    if not method or not player:
        return False
    try:
        Gio, GLib, bus = _mpris()
        bus.call_sync(player, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", method,
                      None, None, Gio.DBusCallFlags.NONE, 1000, None)
    except Exception as exc:
        log(f"media {action}: {exc}")
        return False
    global _media_cache
    _media_cache = (0.0, {})
    return True


