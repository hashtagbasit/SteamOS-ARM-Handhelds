        elif path == ["word-ends"]:
            prefix = str(b.get("prefix", ""))[:24]
            self.reply({"prefix": prefix, "words": swipetype.complete(prefix)})
            return
        elif path == ["keyboard"]:
            KEYBOARD.set(bool(b.get("shown")))
        elif path == ["volume"]:
            set_volume(b.get("percent"), b.get("mute"))
        elif path[0] == "hub" and len(path) == 2:
            global _hub_cache
            act, app = path[1], str(b.get("app", ""))
            if act in ("install", "update") and app:
                if b.get("pin"):
                    cfg = load_config()
                    cfg.setdefault("pin_after", [])
                    if app not in cfg["pin_after"]:
                        cfg["pin_after"].append(app)
                    save_config(cfg)
                out = hub(act, app)
            elif act == "remove" and app:
                out = hub("remove", app, *(["--wipe"] if b.get("wipe") else []))
            elif act == "cancel":
                out = hub("cancel", str(b.get("job", "")))
            elif act == "reset" and app:
                out = hub("reset", app)
            elif act == "desktop":
                out = hub("desktop")
            elif act in ("starter", "update-all"):
                out = hub(act)
            elif act == "check-updates":
                out = hub(act, timeout=180)
            elif act == "library" and b.get("where") in ("internal", "sd"):
                out = hub("library", b["where"], timeout=900)
            else:
                out = {"error": "unknown"}
            _hub_cache = (0.0, {})
            self.reply(out)
            return
        elif path == ["launch"]:
            ok = APPS.launch(str(b.get("id", "")))
        elif path == ["focus"]:
            ok = focus_app(str(b.get("id", "")), APPS)
        elif path == ["close"]:
            ok = APPS.close(str(b.get("id", "")))
        elif path == ["home"]:
            NAV.home()
        elif path == ["nav"]:
            page = str(b.get("page", ""))
            if page in PAGES:
                NAV.ui_page(page)
            else:
                ok = False
        elif path == ["play"]:
            ok = play_game(str(b.get("gameid", "")))
        elif path == ["media"]:
            ok = media_control(str(b.get("action", "")))
        elif path == ["show"]:
            # From outside (the Desktop Mode launcher run again): bring the
            # window forward on that page.
            page = str(b.get("page", "home"))
            NAV.show(page if page in PAGES else "home")
        elif path == ["dash-done"]:
            NAV.back_from_dash()
        elif path == ["notes"]:
            try:
                ok = notes_put(int(b.get("appid", 0)), str(b.get("text", "")))
            except (TypeError, ValueError):
                ok = False
        elif path == ["remember"]:
            ok = GAMES.remember(bool(b.get("on")))
        elif path == ["toggle"]:
            ok = set_toggle(str(b.get("name", "")), bool(b.get("on")))
        elif path == ["webapp"]:
            # Add ({"name", "url"}) or remove ({"remove": id}) your own web app.
            cfg = load_config()
            apps = [w for w in cfg.get("webapps", []) if isinstance(w, dict)]
            if b.get("remove"):
                apps = [w for w in apps if w.get("id") != b["remove"]]
                APPS.close(f"web:u-{b['remove']}")
            else:
                name, url = str(b.get("name", "")).strip()[:40], str(b.get("url", "")).strip()
                if url and "://" not in url:
                    url = "https://" + url
                if not name or not re.match(r"https?://[^\s]+$", url):
                    self.reply({"ok": False, "error": "a name and a web address"})
                    return
                apps.append({"id": secrets.token_hex(4), "name": name, "url": url})
            cfg["webapps"] = apps
            save_config(cfg)
        elif path == ["refresh"]:
            try:
                ok = set_refresh(int(b.get("hz", 0)))
            except (TypeError, ValueError):
                ok = False
        elif path == ["pin"]:
            cfg = load_config()
            app_id = str(b.get("id", ""))
            pinned = [p for p in cfg["pinned"] if p != app_id]
            if b.get("pinned") and app_by_id(app_id):
                pinned.append(app_id)
            cfg["pinned"] = pinned
            save_config(cfg)
        elif path == ["settings"]:
            cfg = load_config()
            for k, default in DEFAULT_CONFIG.items():
                if k in LIST_KEYS or k not in b:
                    continue
                v = b[k]
                if k == "skin":
                    if isinstance(v, str) and any(x["id"] == v for x in skins()):
                        cfg[k] = v
                elif isinstance(default, bool):
                    cfg[k] = bool(v)
                elif k == "layout":
                    if v in LAYOUTS:
                        cfg[k] = v
                elif isinstance(default, (int, float)):
                    try:
                        cfg[k] = type(default)(v)
                    except (TypeError, ValueError):
                        continue
            cfg["dash_idle_s"] = max(0, min(600, int(cfg["dash_idle_s"])))
            cfg["pad_speed"] = max(0.4, min(5.0, float(cfg["pad_speed"])))
            save_config(cfg)
        elif path == ["launcher"]:
            # Lower Deck: the tiles' order and which are hidden.
            cfg = load_config()
            known = {i["id"] for i in launcher_items(cfg)}
            if isinstance(b.get("order"), list):
                cfg["home_order"] = [str(x) for x in b["order"] if str(x) in known]
            if isinstance(b.get("hidden"), list):
                cfg["home_hidden"] = [str(x) for x in b["hidden"] if str(x) in known and not str(x).startswith(("page:pad", "page:keys"))]
            save_config(cfg)
        elif path == ["companions"]:
            # Lower Deck: the apps that open here with a game ({"appid", "apps"}),
            # or {"close": bool} for closing them when it ends.
            cfg = load_config()
            if "close" in b:
                cfg["companions_close"] = bool(b["close"])
            if "appid" in b:
                try:
                    appid = str(int(b["appid"]))
                except (TypeError, ValueError):
                    self.reply({"ok": False})
                    return
                apps = [str(a) for a in (b.get("apps") or []) if app_by_id(str(a)) or str(a).startswith("web:")]
                comp = dict(cfg.get("companions") or {})
                if apps:
                    comp[appid] = apps[:6]
                else:
                    comp.pop(appid, None)
                cfg["companions"] = comp
            save_config(cfg)
        else:
            self.reply({"error": "not found"}, 404)
            return
        self.reply({"ok": bool(ok)})


def main() -> int:
    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    port = server.server_address[1]
    threading.Thread(target=server.serve_forever, daemon=True).start()
    threading.Thread(target=watch_home_gesture, daemon=True).start()
    threading.Thread(target=watch_touch_activity, daemon=True).start()
    threading.Thread(target=hub_pin_watch, daemon=True).start()
    threading.Thread(target=GAMES.watch, daemon=True).start()
    log(f"api on 127.0.0.1:{port}, model {MODEL!r}")
    # The UI reads the API address + token from a private file (argv and the
    # environment are readable by other users through /proc).
    api_file = RUNTIME / "bottom-screen.api"
    fd = os.open(api_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump({"url": f"http://127.0.0.1:{port}", "token": TOKEN}, fh)
    # KDE platform theme: Breeze icons for the buttons and apps. EGL straight
    # on the GPU: through GLX the UI ended up on zink with gamescope's WSI
    # layer in between, which recreated its swapchains and stuttered.
    env = dict(os.environ, QT_QPA_PLATFORM="xcb", QT_XCB_GL_INTEGRATION="xcb_egl",
               DISABLE_GAMESCOPE_WSI="1", QT_QUICK_CONTROLS_MOBILE="1",
               QML_XHR_ALLOW_FILE_READ="1", QT_QPA_PLATFORMTHEME="kde",
               XDG_CURRENT_DESKTOP="KDE")
    env.pop("WAYLAND_DISPLAY", None)
    if DESKTOP:
        env = dict(os.environ, QT_QUICK_CONTROLS_MOBILE="1", QML_XHR_ALLOW_FILE_READ="1",
                   QT_QPA_PLATFORMTHEME="kde", XDG_CURRENT_DESKTOP="KDE")
        env.pop("QT_QPA_PLATFORM", None)
        threading.Thread(target=kwin_pin_panel, daemon=True).start()

    def keep_running(qml: Path, name: str, after_start=None) -> None:
        while True:
            started = time.monotonic()
            proc = subprocess.Popen(["qml6", str(qml), "--", str(api_file)], env=env)
            if after_start:
                threading.Thread(target=after_start, daemon=True).start()
            rc = proc.wait()
            if time.monotonic() - started < 3:
                log(f"{name} exited right away ({rc}), retrying in 5 s")
                time.sleep(5)

    if DESKTOP:
        log(f"Desktop Mode: the UI goes on {BOTTOM_OUTPUT or 'the second panel'}, Plasma types")
        keep_running(QML, "UI")
        return 0
    # The keyboard first, so it is an overlay before the dashboard maps.
    threading.Thread(target=keep_running, args=(QML.parent / "Keyboard.qml", "keyboard", KEYBOARD.adopt),
                     daemon=True).start()
    threading.Thread(target=watch_text_focus, daemon=True).start()
    time.sleep(1)
    keep_running(QML, "UI")


if __name__ == "__main__":
    sys.exit(main())
