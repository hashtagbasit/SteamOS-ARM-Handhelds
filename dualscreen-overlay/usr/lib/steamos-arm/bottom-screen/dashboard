class Typer:
    """Types into whatever has keyboard focus on THIS screen's X display
    (XTest), so the bottom screen's apps get the keys and the top never does.
    Characters missing from the keymap borrow a spare key code for a moment."""
    XK_SHIFT_L = 0xFFE1

    def __init__(self):
        self.lock = threading.Lock()
        self.dpy = None
        self.x11 = self.xtst = None
        self.borrowed: dict[int, int] = {}      # keysym -> spare key code, oldest first

    def _open(self) -> bool:
        if self.dpy:
            return True
        import ctypes
        try:
            self.x11 = ctypes.CDLL("libX11.so.6")
            self.xtst = ctypes.CDLL("libXtst.so.6")
        except OSError as exc:
            log(f"typing: {exc}")
            return False
        x, c = self.x11, ctypes
        x.XOpenDisplay.restype = c.c_void_p
        x.XOpenDisplay.argtypes = [c.c_char_p]
        x.XKeysymToKeycode.argtypes = [c.c_void_p, c.c_ulong]
        x.XKeysymToKeycode.restype = c.c_ubyte
        x.XkbKeycodeToKeysym.argtypes = [c.c_void_p, c.c_ubyte, c.c_int, c.c_int]
        x.XkbKeycodeToKeysym.restype = c.c_ulong
        x.XStringToKeysym.argtypes = [c.c_char_p]
        x.XStringToKeysym.restype = c.c_ulong
        x.XDisplayKeycodes.argtypes = [c.c_void_p, c.POINTER(c.c_int), c.POINTER(c.c_int)]
        x.XGetKeyboardMapping.argtypes = [c.c_void_p, c.c_ubyte, c.c_int, c.POINTER(c.c_int)]
        x.XGetKeyboardMapping.restype = c.POINTER(c.c_ulong)
        x.XChangeKeyboardMapping.argtypes = [c.c_void_p, c.c_int, c.c_int, c.POINTER(c.c_ulong), c.c_int]
        x.XFree.argtypes = [c.c_void_p]
        x.XSync.argtypes = [c.c_void_p, c.c_int]
        x.XFlush.argtypes = [c.c_void_p]
        self.xtst.XTestFakeKeyEvent.argtypes = [c.c_void_p, c.c_uint, c.c_int, c.c_ulong]
        self.dpy = x.XOpenDisplay(None)
        return bool(self.dpy)

    def _spare_keycode(self) -> int:
        """An unused key code; once none is left, the longest-borrowed one."""
        import ctypes as c
        lo, hi, per = c.c_int(), c.c_int(), c.c_int()
        self.x11.XDisplayKeycodes(self.dpy, c.byref(lo), c.byref(hi))
        syms = self.x11.XGetKeyboardMapping(self.dpy, lo.value, hi.value - lo.value + 1, c.byref(per))
        try:
            for kc in range(hi.value, lo.value - 1, -1):
                row = (kc - lo.value) * per.value
                if all(syms[row + i] == 0 for i in range(per.value)):
                    return kc
        finally:
            self.x11.XFree(syms)
        if self.borrowed:
            oldest = next(iter(self.borrowed))
            return self.borrowed.pop(oldest)
        return 0

    def _tap(self, keysym: int) -> None:
        import ctypes as c
        x, t, d = self.x11, self.xtst, self.dpy
        kc = x.XKeysymToKeycode(d, keysym)
        shift = False
        if kc:
            shift = x.XkbKeycodeToKeysym(d, kc, 0, 0) != keysym and x.XkbKeycodeToKeysym(d, kc, 0, 1) == keysym
        else:
            # Map it onto a spare key and leave it there (apps pick up a new
            # mapping a moment after MappingNotify; a key pressed before that,
            # or a mapping taken back right after, types nothing).
            kc = self._spare_keycode()
            if not kc:
                return
            arr = (c.c_ulong * 2)(keysym, keysym)
            x.XChangeKeyboardMapping(d, kc, 2, arr, 1)
            x.XSync(d, 0)
            self.borrowed[keysym] = kc
            time.sleep(0.05)
        sk = x.XKeysymToKeycode(d, self.XK_SHIFT_L) if shift else 0
        if sk:
            t.XTestFakeKeyEvent(d, sk, 1, 0)
        t.XTestFakeKeyEvent(d, kc, 1, 0)
        t.XTestFakeKeyEvent(d, kc, 0, 0)
        if sk:
            t.XTestFakeKeyEvent(d, sk, 0, 0)
        x.XSync(d, 0)

    MOD_SYMS = {"ctrl": 0xFFE3, "alt": 0xFFE9, "super": 0xFFEB, "shift": 0xFFE1}

    def chord(self, parts) -> bool:
        parts = [str(p) for p in (parts or [])][:6]
        if not parts:
            return False
        with self.lock:
            if not self._open():
                return False
            x, t, d = self.x11, self.xtst, self.dpy
            last = parts[-1]
            ks = self.x11.XStringToKeysym(last.encode()) if len(last) > 1 else ord(last)
            kc = x.XKeysymToKeycode(d, ks) if ks else 0
            if not kc:
                return False
            mods = [x.XKeysymToKeycode(d, self.MOD_SYMS[m]) for m in parts[:-1] if m in self.MOD_SYMS]
            for m in mods:
                t.XTestFakeKeyEvent(d, m, 1, 0)
            t.XTestFakeKeyEvent(d, kc, 1, 0)
            t.XTestFakeKeyEvent(d, kc, 0, 0)
            for m in reversed(mods):
                t.XTestFakeKeyEvent(d, m, 0, 0)
            x.XSync(d, 0)
            return True

    def retype(self, erase: int, chars: str) -> bool:
        for _ in range(max(0, min(64, int(erase)))):
            self.type(None, "BackSpace")
        return self.type(chars, None) if chars else True

    def type(self, text, name) -> bool:
        with self.lock:
            if not self._open():
                return False
            if name:
                ks = self.x11.XStringToKeysym(str(name).encode())
                if ks:
                    self._tap(ks)
                return bool(ks)
            for ch in str(text or "")[:500]:
                cp = ord(ch)
                self._tap(cp if 0x20 <= cp <= 0x7E or 0xA0 <= cp <= 0xFF else 0x1000000 | cp)
            return True


class KeyboardOverlay:
    """The Keyboard.qml window as a gamescope overlay: shown = opaque and
    STEAM_INPUT_FOCUS=2 (takes the touches, X keyboard focus stays on the app
    underneath), hidden = transparent and no input. It stays mapped, as
    Steam's keyboard does: gamescope stops watching an unmapped window."""
    TITLE = "SteamOS Bottom Keyboard"

    def __init__(self):
        self.lock = threading.Lock()
        self.visible = False
        self.top = False
        self.wid: str | None = None

    def adopt(self) -> None:
        """Make the keyboard window an overlay as soon as it maps (until then
        gamescope could take it for the newest app window), hidden."""
        while True:
            with self.lock:
                self.wid = None
                wid = self._window()
                if wid:
                    run("xprop", "-id", wid, "-f", "STEAM_INPUT_FOCUS", "32c", "-set", "STEAM_INPUT_FOCUS", "0")
                    run("xprop", "-id", wid, "-f", "_NET_WM_WINDOW_OPACITY", "32c", "-set", "_NET_WM_WINDOW_OPACITY", "0")
                    self.visible = False
            if wid:
                show_dashboard()
                return
            time.sleep(0.3)

    def _window(self) -> str | None:
        if self.wid and any(w == self.wid for w, _ in toplevel_windows()):
            return self.wid
        self.wid = next((w for w, t in toplevel_windows() if t == self.TITLE), None)
        if self.wid:
            run("xprop", "-id", self.wid, "-f", "STEAM_OVERLAY", "32c", "-set", "STEAM_OVERLAY", "1")
        return self.wid

    def set(self, visible: bool, top=None) -> None:
        with self.lock:
            if top is not None:
                self.top = bool(top)
            if visible == self.visible:
                return
            self.visible = visible
            wid = self._window()
            if not wid:
                return
            run("xprop", "-id", wid, "-f", "STEAM_INPUT_FOCUS", "32c",
                "-set", "STEAM_INPUT_FOCUS", "2" if visible else "0")
            run("xprop", "-id", wid, "-f", "_NET_WM_WINDOW_OPACITY", "32c",
                "-set", "_NET_WM_WINDOW_OPACITY", str(0xFFFFFFFF if visible else 0))

    def state(self) -> dict:
        return {"shown": self.visible, "dock": "upper" if self.top else "lower"}


HIDE_DELAY_MS = 300


def watch_text_focus() -> None:
    """Show the keyboard when a text field in one of this screen's apps gets
    focus, hide it when something else does (AT-SPI). The apps are started
    with accessibility on (see Apps.launch), nothing else in the session is."""
    try:
        import gi
        gi.require_version("Atspi", "2.0")
        from gi.repository import Atspi, GLib
    except (ImportError, ValueError) as exc:
        log(f"keyboard: no AT-SPI ({exc}), the keyboard only opens by hand")
        return
    screen_h = 1080
    try:
        out = run("xwininfo", "-root")
        m = re.search(r"Height:\s+(\d+)", out)
        screen_h = int(m.group(1)) if m else screen_h
    except ValueError:
        pass

    # Hiding waits a moment: focus often passes through something else on
    # its way to the next field, and the keys shouldn't blink out and back.
    hide_at = [0]

    def hide_later() -> None:
        if hide_at[0]:
            return
        def go() -> bool:
            if hide_at[0]:
                hide_at[0] = 0
                KEYBOARD.set(False)
            return False
        hide_at[0] = GLib.timeout_add(HIDE_DELAY_MS, go)

    def keep() -> None:
        if hide_at[0]:
            GLib.source_remove(hide_at[0])
            hide_at[0] = 0

    def on_focus(event) -> None:
        if not event.detail1:
            # a field let go of focus (to nothing, or to another app): hide
            try:
                st = event.source.get_state_set()
                if st.contains(Atspi.StateType.EDITABLE):
                    hide_later()
            except Exception:
                pass
            return
        try:
            src = event.source
            pids = set()
            for app in APPS.running():
                pids |= APPS.pids(app)
            if src.get_process_id() not in pids:
                return
            states = src.get_state_set()
            editable = states.contains(Atspi.StateType.EDITABLE) and not states.contains(Atspi.StateType.READ_ONLY)
            if editable and time.monotonic() - last_touch > TOUCH_GRACE_S:
                return              # focus moved by the app itself, not a tap
            if editable:
                top = False
                try:
                    ext = src.get_extents(Atspi.CoordType.SCREEN)
                    top = ext.y + ext.height / 2 > screen_h / 2
                except Exception:
                    pass
                keep()
                KEYBOARD.set(True, top)
            else:
                hide_later()
        except Exception as exc:  # an app going away mid-event
            log(f"keyboard focus: {exc}")

    Atspi.init()
    listener = Atspi.EventListener.new(on_focus)
    listener.register("object:state-changed:focused")
    log("keyboard: watching text fields")
    GLib.MainLoop().run()


