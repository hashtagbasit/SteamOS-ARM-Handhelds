def game_art(appid: int) -> dict:
    """Steam's own pictures of a game: hero (the wide banner), logo and cover.
    Steam keeps them in its library cache; artwork set by hand on a non-Steam
    game sits in userdata/*/config/grid. Empty for anything without art."""
    if not appid:
        return {}
    if appid in _ART and all(_ART[appid][k] for k in ("hero", "logo", "cover")):
        return _ART[appid]
    art = {"hero": "", "logo": "", "cover": "", "blur": ""}
    cache = STEAM_DIR / "appcache/librarycache" / str(appid)
    for key, names in (("hero", ("library_hero.jpg", "library_hero.png")), ("logo", ("logo.png",)),
                       ("cover", ("library_600x900.jpg", "library_capsule.jpg")),
                       ("blur", ("library_hero_blur.jpg",))):
        for n in names:
            if (cache / n).is_file():
                art[key] = str(cache / n)
                break
    if not all(art[k] for k in ("hero", "logo", "cover")):
        for grid in glob.glob(str(STEAM_DIR / "userdata/*/config/grid")):
            for key, stem in (("hero", f"{appid}_hero"), ("logo", f"{appid}_logo"), ("cover", f"{appid}p")):
                for ext in (".png", ".jpg"):
                    if not art[key] and os.path.isfile(f"{grid}/{stem}{ext}"):
                        art[key] = f"{grid}/{stem}{ext}"
    _ART[appid] = art
    return art


class Games:
    """The game in front on the top screen (gamescope's GAMESCOPE_FOCUSED_APP
    on Steam's display) and its name from Steam's app manifests. Also applies
    per-game settings: when a game with remembered settings comes to the
    front, its profile, fan and refresh rate are set, and what was there
    before goes back when it leaves."""

    def __init__(self):
        self.lock = threading.Lock()
        self.appid = 0
        self.names: dict[int, str] = {}
        self.before: dict | None = None     # settings to restore after a game
        self.opened: dict[int, list[str]] = {}  # companion apps we opened, per game

    def name(self, appid: int) -> str:
        if appid in self.names:
            return self.names[appid]
        name = ""
        for d in _library_dirs():
            m = re.search(r'"name"\s+"([^"]+)"', rd(str(d / f"appmanifest_{appid}.acf")))
            if m:
                name = m.group(1)
                break
        self.names[appid] = name
        return name

    def poll(self) -> int:
        m = re.search(r"= (\d+)", run("env", f"DISPLAY={steam_display()}", "xprop", "-root",
                                      "GAMESCOPE_FOCUSED_APP"))
        appid = int(m.group(1)) if m else 0
        return 0 if appid in NOT_GAMES else appid

    def state(self, cfg: dict) -> dict:
        with self.lock:
            appid = self.appid
        return {"appid": appid, "name": self.name(appid) if appid else "",
                "remembered": str(appid) in cfg.get("per_game", {}), "art": game_art(appid)}

    @staticmethod
    def current_settings() -> dict:
        k = konkrd_state()
        r = refresh_state()
        return {"profile": k["profile"], "fan_mode": k["fan_mode"], "fan_fixed": k["fan_fixed"],
                "refresh": r["choice"] if r else 0}

    @staticmethod
    def apply(st: dict) -> None:
        if st.get("profile") in ("silent", "balanced", "turbo"):
            konkrd(f"profile-{st['profile']}")
        mode = st.get("fan_mode")
        if mode == "boost":
            konkrd("fan-boost-on")
        elif mode == "fixed":
            konkrd(f"fan-fixed:{int(st.get('fan_fixed', 50))}")
        elif mode == "auto":
            konkrd("fan-auto")
        if "refresh" in st:
            set_refresh(int(st["refresh"] or 0))

    def remember(self, on: bool) -> bool:
        with self.lock:
            appid = self.appid
        if not appid:
            return False
        cfg = load_config()
        per = dict(cfg.get("per_game", {}))
        if on:
            per[str(appid)] = self.current_settings()
        else:
            per.pop(str(appid), None)
        cfg["per_game"] = per
        save_config(cfg)
        return True

    def companions(self, left: int, appid: int) -> None:
        """Open this game's companion apps here; close the last game's ones
        (only those we opened for it) when it ends."""
        cfg = load_config()
        comp = cfg.get("companions") or {}
        if left and cfg.get("companions_close", True):
            for a in self.opened.pop(left, []):
                APPS.close(a)
        if appid and str(appid) in comp:
            running = set(APPS.running())
            mine = []
            for a in comp[str(appid)]:
                if a not in running and APPS.launch(a):
                    mine.append(a)
            if mine:
                self.opened[appid] = mine
                log(f"game {appid}: opened {', '.join(mine)}")

    def watch(self) -> None:
        while True:
            time.sleep(3)
            try:
                appid = self.poll()
            except Exception:
                continue
            with self.lock:
                if appid == self.appid:
                    continue
                left, self.appid = self.appid, appid
            self.companions(left, appid)
            per = load_config().get("per_game", {})
            if appid and str(appid) in per:
                if self.before is None:
                    self.before = self.current_settings()
                log(f"game {appid}: its remembered settings")
                self.apply(per[str(appid)])
            elif left and self.before is not None and not (appid and str(appid) in per):
                log("game left: settings from before it")
                self.apply(self.before)
                self.before = None


