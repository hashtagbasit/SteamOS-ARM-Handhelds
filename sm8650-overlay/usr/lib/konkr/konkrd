def remap_choice(st: dict, which: str) -> str:
    """The saved choice for "steam" or "perf": a REMAP_TARGET key or "default"."""
    raw = st.get("remap")
    c = raw.get(which) if isinstance(raw, dict) else None
    return c if c in REMAP_TARGET else "default"


def remap_text(text: str, codes: dict, choice: dict) -> str | None:
    """text with the entries found by their source event_code in `codes`
    (name -> code) pointed at the chosen buttons. choice maps the name to
    "default" or a REMAP_TARGET key; anything else raises ValueError. None if
    an entry is missing, repeated or not shaped as shipped: the caller leaves
    the file alone."""
    want: dict[str, str | None] = {}
    for name in codes:
        c = choice.get(name, "default")
        if not isinstance(c, str) or (c != "default" and c not in REMAP_TARGET):
            raise ValueError(f"bad button choice for {name}: {c!r}")
        want[name] = REMAP_DEFAULT[name] if c == "default" else REMAP_TARGET[c]
    lines = text.split("\n")
    hits: dict[str, int] = {}
    for i, line in enumerate(lines):
        for name, code in codes.items():
            if f"event_code: {code}," in line:
                if name in hits:
                    return None
                hits[name] = i
    if set(hits) != set(codes):
        return None
    for i in hits.values():
        if i + 2 >= len(lines) or lines[i + 1].strip() != "target_event:" \
                or not REMAP_TARGET_LINE.match(lines[i + 2]):
            return None
    for name, i in hits.items():
        if want[name] is not None:
            lines[i + 2] = f"      gamepad: {{button: {want[name]}}}"
    return "\n".join(lines)


def restart_inputplumber() -> None:
    """Queue an InputPlumber restart without waiting for it: the main loop
    must not stall on a service that takes seconds to stop and start."""
    try:
        subprocess.Popen(["systemctl", "--no-block", "try-restart", "inputplumber.service"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as exc:
        log(f"inputplumber restart: {exc}")


def ensure_button_remap(st: dict) -> None:
    """Apply the saved Steam/Performance button choice to the installed maps
    (run at start and on every reload, so an update that replaces the files
    is corrected). Queues an InputPlumber restart only if a file changed."""
    if rd("/sys/firmware/devicetree/base/model").strip("\0 \n") != "KONKR Pocket FIT":
        return
    choice = {k: remap_choice(st, k) for k in REMAP_DEFAULT}
    changed = []
    for path, codes in REMAP_MAPS.items():
        try:
            with open(path, encoding="utf-8") as fh:
                text = fh.read()
            new = remap_text(text, codes, choice)
        except (OSError, UnicodeDecodeError) as exc:
            log(f"button remap: {path}: {exc}")
            continue
        if new is None:
            log(f"button remap: {path} not as expected, left alone")
            continue
        if new == text:
            continue
        tmp = path + ".tmp"
        try:
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.write(new)
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(tmp, path)
        except OSError as exc:
            log(f"button remap: {path}: {exc}")
            try:
                os.unlink(tmp)
            except OSError:
                pass
            continue
        changed.append(path)
    if changed:
        restart_inputplumber()
        log(f"system buttons: steam={choice['steam']}, perf={choice['perf']}")


def ensure_gamepad_mode(conf: configparser.ConfigParser) -> None:
    want = conf.get("controller", "mode", fallback="default")
    if want not in ("default", "xbox"):
        return
    if "KONKR Pocket FIT" not in rd("/sys/firmware/devicetree/base/model"):
        return
    attr = gamepad_mode_attr()
    if not attr:
        return
    in_xbox = any((rd(f"{d}/idVendor"), rd(f"{d}/idProduct")) == XBOX_PAD
                  for d in glob.glob("/sys/bus/usb/devices/*"))
    if (want == "default") == in_xbox and wr(attr, want):
        log(f"controller switched to {want} mode")


def touchscreens() -> list[str]:
    """Direct-touch devices with multitouch positions (the panel)."""
    out = []
    for ev in glob.glob("/sys/class/input/event*"):
        try:
            props = int(rd(f"{ev}/device/properties", "0").split()[-1], 16)
            absbits = int(rd(f"{ev}/device/capabilities/abs", "0").split()[-1], 16)
        except ValueError:
            continue
        if props & 0x2 and absbits & (1 << 0x35):
            out.append(f"/dev/input/{os.path.basename(ev)}")
    return out


class TouchBoost:
    def __init__(self):
        self.fds: dict[int, str] = {}
        self.last_scan = 0.0
        self.last_touch = 0.0
        self.active = False
        big = big_cpus()
        self.floors: dict[str, int] = {}
        for pol in glob.glob("/sys/devices/system/cpu/cpufreq/policy*"):
            cpus = {int(c) for c in rd(f"{pol}/related_cpus").split() if c.isdigit()}
            want = TOUCH_BOOST_HZ["big" if cpus and cpus <= big else "little"]
            freqs = sorted(int(f) for f in rd(f"{pol}/scaling_available_frequencies").split() if f.isdigit())
            pick = next((f for f in freqs if f >= want), freqs[-1] if freqs else 0)
            if pick:
                self.floors[pol] = pick

    def rescan(self) -> None:
        if time.monotonic() - self.last_scan < 5:
            return
        self.last_scan = time.monotonic()
        have = set(self.fds.values())
        for path in touchscreens():
            if path not in have:
                try:
                    self.fds[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
                    log(f"touch boost: watching {path}")
                except OSError:
                    pass

    def watch_fds(self) -> list[int]:
        """fds to select on: none right after a touch (the boost is on and
        the panel reports at ~280 Hz, which must not wake konkrd each time)."""
        self.rescan()
        if time.monotonic() - self.last_touch < TOUCH_SAMPLE_S:
            return []
        return list(self.fds)

    def drain(self, fd: int) -> None:
        try:
            while os.read(fd, INPUT_EVENT.size * 256):
                pass
        except BlockingIOError:
            pass
        except OSError as e:
            if e.errno in (errno.ENODEV, errno.EBADF):
                os.close(fd)
                self.fds.pop(fd, None)
            return
        self.last_touch = time.monotonic()

    def tick(self, standby: bool) -> None:
        want = not standby and time.monotonic() - self.last_touch < TOUCH_BOOST_HOLD_S
        if want == self.active:
            return
        self.active = want
        for pol, floor in self.floors.items():
            wr(f"{pol}/scaling_min_freq", floor if want else rd(f"{pol}/cpuinfo_min_freq"))


class Hotkeys:
    def __init__(self):
        self.fds: dict[int, str] = {}
        self.last_scan = 0.0

    def rescan(self) -> None:
        if time.monotonic() - self.last_scan < 5:
            return
        self.last_scan = time.monotonic()
        have = set(self.fds.values())
        for path in hotkey_devices():
            if path in have:
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                self.fds[fd] = path
                log(f"hotkeys: listening on {path}")
            except OSError:
                pass

    def poll(self, timeout: float, touch: "TouchBoost | None" = None) -> list[int]:
        self.rescan()
        tfds = touch.watch_fds() if touch else []
        if not self.fds and not tfds:
            time.sleep(timeout)
            return []
        r, _, _ = select.select(list(self.fds) + tfds, [], [], timeout)
        keys = []
        for fd in r:
            if fd in tfds:
                touch.drain(fd)
                continue
            try:
                data = os.read(fd, INPUT_EVENT.size * 64)
            except OSError as e:
                if e.errno in (errno.ENODEV, errno.EBADF):
                    os.close(fd)
                    self.fds.pop(fd, None)
                continue
            for off in range(0, len(data) - INPUT_EVENT.size + 1, INPUT_EVENT.size):
                _s, _u, etype, code, value = INPUT_EVENT.unpack_from(data, off)
                if etype == EV_KEY and value in (0, 1):
                    keys.append((code, value))
        return keys


# -------------------------------------------------------------- requests ----
# The bottom-screen dashboard (runs as the user) asks for the same actions the
# extra buttons trigger. Only these names are accepted; nothing else.
REQUEST_SOCK = "/run/konkrd/request"
REQUEST_ACTIONS = {"profile-next", "profile-silent", "profile-balanced",
                   "profile-turbo", "fan-boost", "rgb-next", "sticks-toggle",
                   "fan-auto", "fan-boost-on"}
# Also fan-fixed:<0-100> (a fixed fan speed, the hot-override still applies).


def open_request_socket():
    import socket
    try:
        os.makedirs(os.path.dirname(REQUEST_SOCK), exist_ok=True)
        if os.path.exists(REQUEST_SOCK):
            os.unlink(REQUEST_SOCK)
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        sock.bind(REQUEST_SOCK)
        sock.setblocking(False)
        os.chown(REQUEST_SOCK, 0, 1000)      # the steamos user's group
        os.chmod(REQUEST_SOCK, 0o660)
        return sock
    except OSError as exc:
        log(f"request socket: {exc}")
        return None


# ----------------------------------------------------------------- main ----
# ------------------------------------------------------------ menu clicks ---
DECK_HID = "HID_ID=0003:000028DE:000012F0"      # InputPlumber's virtual Deck pad
RUMBLE_HID = "HID_ID=0003:00004001:00000428"    # the AYANEO DirectInput motors
CLICK_S = 0.025                                  # felt crisp at full level (Pocket FIT)


def find_hidraw(hid_id: str) -> str | None:
    for d in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        if hid_id in rd(f"{d}/device/uevent"):
            return "/dev/" + os.path.basename(d)
    return None


class MenuClicks(threading.Thread):
    """A short tick from the motors while moving through Steam's menus.

    Steam plays haptics only on trackpads, which these handhelds don't have,
    so menus only beep. This reads the controller Steam sees (InputPlumber's
    virtual Deck pad; every hidraw reader gets every report, Steam loses
    nothing) and ticks on a new D-pad or bumper press, or when the left
    stick swings into a new direction. Never while a game runs or in
    standby: that's the game's rumble."""

    STICK_ON, STICK_OFF = 20000, 9000            # of 32767, with hysteresis

    def __init__(self, daemon: "Daemon"):
        super().__init__(name="menu-clicks", daemon=True)
        self.daemon_ref = daemon
        self.motor = -1
        self.last_click = 0.0

    def wanted(self) -> bool:
        return (self.daemon_ref.st.get("menu_clicks", True) and not CURRENT_APPID
                and not os.path.exists(STANDBY_FLAG))

    def click(self) -> None:
        now = time.monotonic()
        if now - self.last_click < 0.06:
            return
        self.last_click = now
        if self.motor < 0:
            path = find_hidraw(RUMBLE_HID)
            if not path:
                return
            try:
                self.motor = os.open(path, os.O_WRONLY | os.O_CLOEXEC)
            except OSError:
                return
        try:
            os.write(self.motor, bytes([0, 0, 0, 0, 0xFF, 0xFF, 0, 0]))
            time.sleep(CLICK_S)
            os.write(self.motor, bytes(8))
        except OSError:
            os.close(self.motor)
            self.motor = -1

    def watch(self, path: str) -> None:
        fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
        try:
            prev_buttons, stick_dir = 0, None
            while True:
                r, _, _ = select.select([fd], [], [], 5.0)
                if not r:
                    continue
                rep = os.read(fd, 64)
                if len(rep) < 52 or rep[2] != 0x09:
                    continue
                # byte 8: L1 0x08, R1 0x04; byte 9: D-pad down/left/right/up
                buttons = ((rep[8] & 0x0C) << 4) | (rep[9] & 0x0F)
                x, y = struct.unpack_from("<hh", rep, 48)
                mag = max(abs(x), abs(y))
                if mag > self.STICK_ON:
                    d = ("x+" if x > 0 else "x-") if abs(x) >= abs(y) else ("y+" if y > 0 else "y-")
                elif mag < self.STICK_OFF:
                    d = None
                else:
                    d = stick_dir
                pressed = buttons & ~prev_buttons
                swung = d is not None and d != stick_dir
                prev_buttons, stick_dir = buttons, d
                if (pressed or swung) and self.wanted():
                    self.click()
        finally:
            os.close(fd)

    def run(self) -> None:
        while True:
            path = find_hidraw(DECK_HID)
            if path:
                try:
                    self.watch(path)
                except OSError:
                    pass                     # pad went away (InputPlumber restart)
            time.sleep(3.0)


class Daemon:
    def __init__(self):
        self.conf = load_conf()
        self.st = load_state()
        self.fan = Fan(self.conf)
        self.games = GameBoost(self.conf)
        self.perf_key = "{}"
        self.leds = Leds()
        self.keys = Hotkeys()
        self.touch = TouchBoost()
        self.clicks = MenuClicks(self)
        self.clicks.start()
        self.reload = False
        self.requests = open_request_socket()
        signal.signal(signal.SIGHUP, lambda *_: setattr(self, "reload", True))
        signal.signal(signal.SIGTERM, self.stop)
        self.apply_profile(flash=False)
        self.leds.apply_sticks(self.st)
        ensure_gamepad_mode(self.conf)
        ensure_sysbtn_map(self.st)
        ensure_button_remap(self.st)

    def stop(self, *_):
        # On shutdown the device is off a few seconds later: the failsafe only
        # ran the fan at full for that long (an RP6 tester heard it on every
        # power off). Keep it for restarts and crashes.
        if shutting_down():
            log("stopped (shutdown, fan left as is)")
            sys.exit(0)
        self.fan.failsafe_now()
        log("stopped (fan at failsafe)")
        sys.exit(0)

    def profile_now(self) -> str:
        """The profile in force: the running game's own, else the chosen one."""
        p = game_perf(self.st).get("profile")
        return p if p in PROFILES else self.st["profile"]

    def apply_profile(self, flash: bool = True) -> None:
        g = game_perf(self.st)
        p = self.profile_now()
        apply_cpu(p)
        apply_gpu(p)
        if power_limits:
            power_limits.apply(self.st)
        # the game's caps go on top, after Steam's TDP limit (which resets the
        # CPU ceiling), and a manual GPU clock from Steam still wins
        if g.get("cpu_max"):
            cap_cpu(max(30, min(100, int(g["cpu_max"]))) / 100)
        if ("gpu_min" in g or "gpu_max" in g) and not self.st.get("gpu_manual_mhz"):
            lo, hi = GPU_RANGE[p]
            cap_gpu(max(0, min(100, int(g.get("gpu_min", lo * 100)))) / 100,
                    max(0, min(100, int(g.get("gpu_max", hi * 100)))) / 100)
        self.games.perf = g
        self.games.done.clear()
        self.perf_key = json.dumps(g, sort_keys=True)
        if flash:
            self.leds.flash(PROFILE_RGB[p])
        log(f"profile {p}" + (f" (game {CURRENT_APPID}: {self.perf_key})" if g else ""))

    def set_rgb(self, req: str) -> None:
        """rgb-set:<static|breath|off>:<rrggbb>:<brightness 0-255> from the
        bottom-screen dashboard's colour picker."""
        parts = req.split(":")
        if len(parts) != 4 or parts[1] not in ("static", "breath", "off", "battery", "heat"):
            return
        color = parts[2].lower()
        if len(color) != 6 or any(c not in "0123456789abcdef" for c in color):
            return
        try:
            bri = max(0, min(255, int(parts[3])))
        except ValueError:
            return
        self.st["rgb"].update(mode=parts[1], color=color, brightness=bri)
        save_state(self.st)
        self.leds.apply_sticks(self.st)

    def action(self, name: str) -> None:
        if name == "profile-next":
            i = PROFILES.index(self.st["profile"])
            self.st["profile"] = PROFILES[(i + 1) % len(PROFILES)]
            save_state(self.st)
            self.apply_profile()
            notify_desktop(PROFILE_LABEL[self.st["profile"]], "Performance profile")
        elif name in ("profile-silent", "profile-balanced", "profile-turbo"):
            self.st["profile"] = name.split("-", 1)[1]
            save_state(self.st)
            self.apply_profile()
            notify_desktop(PROFILE_LABEL[self.st["profile"]], "Performance profile")
        elif name in ("bottom-home", "bottom-dash"):
            # The bottom screen watches these files' mtimes: .home = its home
            # screen, .dash = show/hide the dashboard over the current app.
            try:
                import pwd
                uid = pwd.getpwnam("steamos").pw_uid
                path = f"/run/user/{uid}/bottom-screen.{name.split('-')[1]}"
                if os.path.isdir(os.path.dirname(path)):
                    with open(path, "a"):
                        pass
                    os.utime(path, None)
                    os.chown(path, uid, uid)
            except (KeyError, OSError) as e:
                log(f"{name}: {e}")
        elif name == "fan-boost":
            self.st["fan"]["boost"] = not self.st["fan"].get("boost")
            save_state(self.st)
            self.leds.flash((255, 255, 255) if self.st["fan"]["boost"] else (60, 60, 60))
            log(f"fan boost {'on' if self.st['fan']['boost'] else 'off'}")
            notify_desktop("Fan boost " + ("on" if self.st["fan"]["boost"] else "off"), "")
        elif name in ("fan-auto", "fan-boost-on"):
            self.st["fan"].update(mode="auto", boost=name == "fan-boost-on")
            save_state(self.st)
            log(f"fan {name[4:]}")
        elif name.startswith("fan-fixed:"):
            try:
                pct = max(0, min(100, int(name.split(":", 1)[1])))
            except ValueError:
                return
            self.st["fan"].update(mode="fixed", fixed=pct, boost=False)
            save_state(self.st)
            log(f"fan fixed {pct}%")
        elif name == "sticks-toggle":
            rgb = self.st["rgb"]
            if rgb.get("mode") == "off":
                rgb["mode"] = rgb.get("last_mode", "static")
                rgb["color"] = rgb.get("last_color", "ff3c00")
            else:
                rgb["last_mode"], rgb["last_color"] = rgb.get("mode"), rgb.get("color")
                rgb["mode"] = "off"
            save_state(self.st)
            self.leds.apply_sticks(self.st)
        elif name == "rgb-next":
            cur = (self.st["rgb"].get("mode"), self.st["rgb"].get("color"))
            i = RGB_PRESETS.index(cur) + 1 if cur in RGB_PRESETS else 0
            mode, color = RGB_PRESETS[i % len(RGB_PRESETS)]
            self.st["rgb"].update(mode=mode, color=color)
            save_state(self.st)
            self.leds.apply_sticks(self.st)
            if not self.leds.sticks:
                rgb = tuple(int(color[j:j + 2], 16) for j in (0, 2, 4))
                self.leds.flash(rgb)

    def run(self) -> None:
        keymap = {KEY_F13: "F13", KEY_F14: "F14", KEY_F15: "F15", KEY_F24: "F24"}
        next_slow = 0.0
        next_ui_check = 0.0
        next_live = 0.0
        power_down_at = None
        power_long_sent = False
        ayn_down_at = None
        ayn_long_sent = False
        last_standby = 0.0
        # CLOCK_BOOTTIME runs through a kernel suspend, CLOCK_MONOTONIC does
        # not: a jump in their difference means we just came back from s2idle,
        # and the power key press that woke the device is still queued.
        sleep_offset = time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()
        while True:
            timeout = 0.1 if power_down_at is not None or ayn_down_at is not None else 0.25 if self.touch.active else 0.5
            if os.path.exists(STANDBY_FLAG):
                last_standby = time.monotonic()
            keys = self.keys.poll(timeout, self.touch)
            offset = time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()
            if offset - sleep_offset > 0.5:
                last_standby = time.monotonic()      # resumed from s2idle
            sleep_offset = offset
            self.touch.tick(os.path.exists(STANDBY_FLAG))
            for code, value in keys:
                if os.path.exists(STANDBY_FLAG):
                    last_standby = time.monotonic()
                    continue                 # konkr-standby owns the buttons
                if code == KEY_POWER:
                    if time.monotonic() - last_standby < WAKE_GRACE_S:
                        power_down_at = None     # still waking up
                        continue
                    if value == 1:
                        power_down_at, power_long_sent = time.monotonic(), False
                    elif power_down_at is not None:
                        if not power_long_sent:
                            power_press(long=False)
                        power_down_at = None
                    continue
                name = keymap.get(code)
                if name == "F24" and not (self.st.get("buttons", {}).get(name)
                                          or self.conf.get("buttons", name, fallback="")):
                    # Short press: dashboard; held: home (sent once, below).
                    if value == 1:
                        ayn_down_at, ayn_long_sent = time.monotonic(), False
                    elif ayn_down_at is not None:
                        if not ayn_long_sent:
                            self.action("bottom-dash")
                        ayn_down_at = None
                    continue
                if name and value == 1:
                    act = self.st.get("buttons", {}).get(name) or \
                        self.conf.get("buttons", name, fallback="none")
                    self.action(act)
            while self.requests is not None:
                try:
                    req = self.requests.recv(64).decode(errors="replace").strip()
                except (BlockingIOError, InterruptedError):
                    break
                except OSError:
                    break
                if (req in REQUEST_ACTIONS or re.fullmatch(r"fan-fixed:\d{1,3}", req)) \
                        and not os.path.exists(STANDBY_FLAG):
                    self.action(req)
                elif req.startswith("rgb-set:") and not os.path.exists(STANDBY_FLAG):
                    self.set_rgb(req)
            if (power_down_at is not None and not power_long_sent
                    and time.monotonic() - power_down_at >= LONG_PRESS_S):
                power_press(long=True)
                power_long_sent = True
            if (ayn_down_at is not None and not ayn_long_sent
                    and time.monotonic() - ayn_down_at >= AYN_HOLD_S):
                self.action("bottom-home")
                ayn_long_sent = True
            if self.reload:
                self.reload = False
                self.conf = load_conf()
                self.st = load_state()
                self.apply_profile()
                self.leds.apply_sticks(self.st)
                ensure_gamepad_mode(self.conf)
                ensure_sysbtn_map(self.st)
                ensure_button_remap(self.st)
            now = time.monotonic()
            if now >= next_ui_check:
                next_ui_check = now + 60.0
                ensure_webhelper_vulkan()
                pin_gpu_irqs()
                record_wifi()
                if not os.path.exists(STANDBY_FLAG):
                    ensure_gamepad_mode(self.conf)
            if now >= next_slow:
                next_slow = now + 1.0
                p = self.profile_now()
                self.fan.tick(p, game_fan(self.st), os.path.exists(STANDBY_FLAG))
                self.leds.tick(self.st.get("power_led", True))
                # Battery/heat light modes follow the device every 10 s.
                if now >= next_live and not os.path.exists(STANDBY_FLAG):
                    next_live = now + 10.0
                    mode = self.st["rgb"].get("mode")
                    live = self.leds.live_color(mode) if mode in ("battery", "heat") else None
                    if live is not None and getattr(self.leds, "shown_rgb", None) != (mode, live):
                        self.leds.apply_sticks(self.st)
                self.games.tick(p)
                # a game with settings of its own started or quit
                if json.dumps(game_perf(self.st), sort_keys=True) != self.perf_key:
                    self.apply_profile(flash=False)


if __name__ == "__main__":
    if os.geteuid() != 0:
        sys.exit("konkrd must run as root")
    try:
        Daemon().run()
    except Exception as exc:  # never leave the fan at a low fixed speed
        f = find_fan()
        if f:
            wr(f"{f}/pwm1", 255)
        log(f"fatal: {exc!r}")
        raise
