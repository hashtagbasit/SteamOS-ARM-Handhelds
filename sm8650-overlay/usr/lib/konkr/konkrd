def led(pattern: str) -> str | None:
    for d in glob.glob(f"/sys/class/leds/*{pattern}*"):
        if os.path.exists(f"{d}/multi_intensity"):
            return d
    return None


def led_rgb(d: str | None, rgb, brightness: int = 255) -> None:
    if not d:
        return
    # multi_intensity follows the LED's own channel order (multi_index). The
    # KONKR LEDs list red green blue, the AYN stick zones blue green red, so
    # writing r g b as is turned red blue and yellow cyan on the Thor and RP6.
    order = rd(f"{d}/multi_index").split()
    names = {"red": 0, "green": 1, "blue": 2}
    if sorted(order) == ["blue", "green", "red"]:
        rgb = [rgb[names[c]] for c in order]
    wr(f"{d}/multi_intensity", " ".join(str(c) for c in rgb))
    wr(f"{d}/brightness", brightness)


def stick_leds() -> list[str]:
    """The stick lights as multicolor LEDs: one for both sticks (KONKR
    konkr:rgb:joysticks), one per side (AYN Odin 2: left-/right-joystick) or
    one per zone (Thor, Odin 2 Portal, RP6: rgb:l1-l4 and rgb:r1-r4)."""
    one = led("joysticks")
    if one:
        return [one]
    out = []
    for d in sorted(glob.glob("/sys/class/leds/*")):
        n = os.path.basename(d)
        zone = n.startswith("rgb:") and n[4:5] in ("l", "r") and n[5:].isdigit()
        if (zone or n in ("left-joystick", "right-joystick")) and os.path.exists(f"{d}/multi_intensity"):
            out.append(d)
    return out


def battery() -> tuple[int, str]:
    for b in glob.glob("/sys/class/power_supply/*"):
        if rd(f"{b}/type") == "Battery":
            try:
                return int(rd(f"{b}/capacity", "0")), rd(f"{b}/status")
            except ValueError:
                pass
    return -1, ""


class Leds:
    def __init__(self):
        self.power = led("power-led")
        self.sticks = stick_leds()
        self.flash_until = 0.0
        self.pulse = False

    def flash(self, rgb) -> None:
        led_rgb(self.power, rgb, 255)
        self.flash_until = time.monotonic() + 2.0

    def tick(self, enabled: bool = True) -> None:
        if not self.power or time.monotonic() < self.flash_until:
            return
        if not enabled or os.path.exists(STANDBY_FLAG):
            wr(f"{self.power}/brightness", 0)
            return
        cap, status = battery()
        if status == "Charging":
            led_rgb(self.power, (255, 120, 0), 40)
        elif status == "Full" or (status == "Not charging" and cap >= 99):
            led_rgb(self.power, (0, 255, 0), 30)
        elif 0 <= cap < 15:
            self.pulse = not self.pulse
            led_rgb(self.power, (255, 0, 0), 60 if self.pulse else 0)
        else:
            wr(f"{self.power}/brightness", 0)

    @staticmethod
    def _blend(stops: list[tuple[float, tuple[int, int, int]]], x: float) -> tuple[int, int, int]:
        """Colour at x along stops [(position, rgb), ...]."""
        if x <= stops[0][0]:
            return stops[0][1]
        for (p0, c0), (p1, c1) in zip(stops, stops[1:]):
            if x <= p1:
                t = (x - p0) / (p1 - p0)
                return tuple(round(a + (b - a) * t) for a, b in zip(c0, c1))
        return stops[-1][1]

    def live_color(self, mode: str) -> tuple[int, int, int] | None:
        """Colours that follow the device: battery charge (red when low,
        green when full) or chip temperature (blue cool, red hot)."""
        if mode == "battery":
            pct, _ = battery()
            if pct < 0:
                return None
            return self._blend([(10, (255, 20, 0)), (40, (255, 150, 0)), (80, (40, 255, 60))], pct)
        if mode == "heat":
            try:
                t = soc_temp_c()
            except RuntimeError:
                return None
            return self._blend([(40, (0, 120, 255)), (60, (255, 170, 0)), (80, (255, 20, 0))], t)
        return None

    def apply_sticks(self, st: dict) -> None:
        cfg = st["rgb"]
        mode = cfg.get("mode", "static")
        color = cfg.get("color", "ff3c00")
        if not isinstance(color, str) or len(color) != 6 or any(c not in "0123456789abcdefABCDEF" for c in color):
            color = "ff3c00"
        rgb = tuple(int(color[i:i + 2], 16) for i in (0, 2, 4))
        live = self.live_color(mode)
        if live is not None:
            rgb = live
        self.shown_rgb = (mode, rgb)
        for d in self.sticks:
            if mode == "off":
                wr(f"{d}/brightness", 0)
                continue
            eff = f"{d}/effect"
            if mode == "breath" and os.path.exists(eff):
                wr(eff, "breath {} {} {}".format(*rgb))
                continue
            if os.path.exists(eff):
                wr(eff, "static")
            led_rgb(d, rgb, int(cfg.get("brightness", 160)))


