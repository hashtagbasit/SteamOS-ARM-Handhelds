FAN_HWMON_NAMES = ("pwmfan", "nx669j_fan")


def find_fan() -> str | None:
    for d in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        if rd(f"{d}/name") in FAN_HWMON_NAMES:
            return d
    return None


def soc_temp_c() -> float:
    """Hottest CPU/GPU tsens zone, °C."""
    hottest = None
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        t = rd(f"{z}/type")
        if not (t.startswith("cpu") or t.startswith("gpu") or "gpuss" in t):
            continue
        try:
            value = int(rd(f"{z}/temp")) / 1000.0
            if -20 <= value <= 150:
                hottest = value if hottest is None else max(hottest, value)
        except ValueError:
            pass
    if hottest is None:
        raise RuntimeError("no valid CPU/GPU temperature sensor")
    return hottest


def curve_temp_c() -> tuple[float, float]:
    """(what the fan curve follows, the hottest zone), °C. The curve follows
    the mean of the three hottest CPU/GPU zones: one core alone runs several
    degrees over the rest and jumps with every burst, which kept the fan
    hunting and loud. The single hottest still drives the safety rules."""
    temps = []
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        t = rd(f"{z}/type")
        if not (t.startswith("cpu") or t.startswith("gpu") or "gpuss" in t):
            continue
        try:
            value = int(rd(f"{z}/temp")) / 1000.0
        except ValueError:
            continue
        if -20 <= value <= 150:
            temps.append(value)
    if not temps:
        raise RuntimeError("no valid CPU/GPU temperature sensor")
    top = sorted(temps, reverse=True)[:3]
    return sum(top) / len(top), top[0]


def hottest_zone() -> str:
    best, name = -1.0, "?"
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        t = rd(f"{z}/type")
        if not (t.startswith("cpu") or t.startswith("gpu") or "gpuss" in t):
            continue
        try:
            v = int(rd(f"{z}/temp", "0")) / 1000.0
        except ValueError:
            continue
        if v > best:
            best, name = v, t
    return name


# The network Wi-Fi is on and its channel, for konkr-sleep: NetworkManager
# drops the connection as soon as a sleep is asked for, so after waking it
# needs a full scan (12 s with a DFS channel in it) before it can reconnect.
# Scanning just this channel first gets it back in about a second.
WIFI_LAST = "/run/konkr/wifi-last"


def record_wifi() -> None:
    try:
        out = subprocess.run(["iw", "dev", "wlan0", "link"], capture_output=True,
                             text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return
    ssid = freq = ""
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("SSID: "):
            ssid = line[6:]
        elif line.startswith("freq: "):
            freq = line[6:].split(".")[0]
    if not ssid or not freq.isdigit():
        return
    try:
        os.makedirs(os.path.dirname(WIFI_LAST), exist_ok=True)
        with open(WIFI_LAST + ".tmp", "w") as f:
            f.write(f"{freq}\n{ssid}\n")
        os.replace(WIFI_LAST + ".tmp", WIFI_LAST)
    except OSError:
        pass


def curve_pwm(curve, temp: float) -> int:
    if temp <= curve[0][0]:
        return curve[0][1]
    for (t0, p0), (t1, p1) in zip(curve, curve[1:]):
        if temp <= t1:
            return int(p0 + (p1 - p0) * (temp - t0) / (t1 - t0))
    return curve[-1][1]


# The fan moves every FAN_STEP_S: towards the curve by at most FAN_UP up and
# FAN_DOWN down, in steps of FAN_QUANTUM, following a smoothed temperature.
# Slow down, quicker up, and no small corrections is what keeps it from
# hunting. Only DANGER_C skips the ramp.
FAN_STEP_S = 3.0
FAN_QUANTUM = 8
# Reaction (Zaviya Control): (smoothing, most up, most down) per step.
FAN_REACTION = {
    "gentle":  (0.6, 20, 4),
    "calm":    (0.5, 36, 6),
    "quick":   (0.35, 64, 12),
    "instant": (0.2, 255, 32),
}
# A fan that may stop starts again this far above its stop temperature.
FAN_STOP_HYST_C = 3
FAN_STATUS = "/run/konkr/fan.json"
DANGER_C = 100
# Waking from s2idle runs every core flat out for a moment: the fan holds its
# speed this long after a resume.
RESUME_SETTLE_S = 8.0

FIXED_OVERRIDE_ON_C = 90
FIXED_OVERRIDE_OFF_C = 82
# Standby (konkr-standby, screen off): off while cool, so it doesn't drain
# the battery overnight (Pocket S2), a quiet spin while warm, and half speed
# once hot so the device doesn't cook in a bag.
STANDBY_FAN_OFF_C = 45
STANDBY_FAN_HOT_C = 55
STANDBY_PWM = 51
STANDBY_HOT_PWM = 128


def game_fan(st: dict) -> dict | None:
    """The fan settings in force: the running game's own (state "fan_games",
    set in Zaviya Control) over the global ones. A game entry is either
    {"curve": "silent"|"balanced"|"turbo"} or {"mode": "fixed", "fixed": n};
    fan boost still wins."""
    glob_fan = {**(st.get("fan") or {}), "curves": st.get("fan_curves") or {}}
    entry = (st.get("fan_games") or {}).get(str(CURRENT_APPID)) if CURRENT_APPID else None
    if not entry:
        return glob_fan
    out = {k: glob_fan.get(k) for k in ("boost", "reaction", "stop_below", "charging_min", "curves")}
    if entry.get("mode") == "fixed":
        out.update(mode="fixed", fixed=int(entry.get("fixed", 50)))
    else:
        out.update(mode="auto", curve=entry.get("curve", ""))
    return out


def on_charger() -> bool:
    for d in glob.glob("/sys/class/power_supply/*"):
        if rd(f"{d}/type") not in ("Battery", "") and rd(f"{d}/online") == "1":
            return True
    return False


def custom_curve(points) -> list | None:
    """A curve from Zaviya Control ([temp °C, speed %] pairs) as pwm
    points, sorted, with the speed never dropping as the temperature rises."""
    try:
        pts = sorted((max(20, min(105, int(t))), max(0, min(100, int(p)))) for t, p in points)
    except (TypeError, ValueError):
        return None
    out = []
    for t, pct in pts:
        if out and t <= out[-1][0]:
            continue
        out.append((t, max(round(pct * 2.55), out[-1][1] if out else 0)))
    return out if len(out) >= 2 else None


def fan_curve(name: str, curves: dict) -> list | None:
    if name in FAN_CURVES:
        return FAN_CURVES[name]
    return custom_curve(curves.get(name) or []) if name else None


class Fan:
    def __init__(self, conf):
        self.dir = find_fan()
        self.enabled = conf.getboolean("fan", "enabled") and self.dir is not None
        self.min_pwm = conf.getint("fan", "min_pwm")
        self.failsafe = conf.getint("fan", "failsafe_pwm")
        self.cur = -1
        self.smooth = None
        self.next_step = 0.0
        self.stopped = False
        self.hot_override = False
        self.slept = None
        self.settle_until = 0.0
        if self.enabled:
            wr(f"{self.dir}/pwm1_enable", 1)
            log(f"fan: {self.dir}")
        elif self.dir is None:
            log("fan: no fan hwmon found")

    def tick(self, profile: str, fan: dict | None = None, standby: bool = False) -> None:
        if not self.enabled:
            return
        fan = fan or {}
        # Time spent asleep shows as CLOCK_BOOTTIME pulling ahead of
        # CLOCK_MONOTONIC: just woke up, so let the resume burst pass.
        slept = time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()
        if self.slept is not None and slept - self.slept > 1.0:
            self.settle_until = time.monotonic() + RESUME_SETTLE_S
        self.slept = slept
        try:
            follow, raw = curve_temp_c()
        except RuntimeError:
            wr(f"{self.dir}/pwm1", 255)
            self.cur = 255
            self.smooth = None
            return
        if standby and raw < DANGER_C:
            step = (0 if raw < STANDBY_FAN_OFF_C else
                    STANDBY_PWM if raw < STANDBY_FAN_HOT_C else STANDBY_HOT_PWM)
            if step != self.cur and wr(f"{self.dir}/pwm1", step):
                log(f"fan: standby, {raw:.0f} C -> pwm {step}")
                self.cur = step
            # the curve picks up from here on wake
            self.smooth = raw
            return
        # Safety: never hold a low fixed speed when hot. Latched with
        # hysteresis: under load the SoC sits right at 90 °C, and flipping
        # every tick between the fixed speed and the curve (100 % there) made
        # the fan pulse (user report, v1.1).
        if fan.get("mode") == "fixed":
            if not self.hot_override and raw >= FIXED_OVERRIDE_ON_C:
                self.hot_override = True
                log(f"fan: {raw:.0f} C, overriding the fixed speed until {FIXED_OVERRIDE_OFF_C} C")
            elif self.hot_override and raw <= FIXED_OVERRIDE_OFF_C:
                self.hot_override = False
                log(f"fan: {raw:.0f} C, back to the fixed speed")
            if self.hot_override:
                fan = {**fan, "mode": "auto"}
        else:
            self.hot_override = False
        if fan.get("mode") == "fixed":
            step = max(0, min(255, int(int(fan.get("fixed", 50)) * 2.55)))
            if step != self.cur and wr(f"{self.dir}/pwm1", step):
                log(f"fan: fixed {fan.get('fixed')}% -> pwm {step}")
                self.cur = step
            return
        # a game's own curve or one picked in Zaviya Control, else the
        # profile's; boost wins over both
        name = "turbo" if fan.get("boost") else fan.get("curve") or profile
        curve = fan_curve(name, fan.get("curves") or {}) or FAN_CURVES[profile]
        smoothing, up, down = FAN_REACTION.get(fan.get("reaction"), FAN_REACTION["calm"])
        stop_below = int(fan.get("stop_below") or 0)
        # plugged in, the fan may keep a speed of its own (the charger heats
        # the battery as much as a game does)
        floor = round(int(fan.get("charging_min") or 0) * 2.55)
        if floor and on_charger():
            stop_below = 0
        else:
            floor = 0
        now = time.monotonic()
        if now < self.settle_until and raw < DANGER_C:
            return
        if raw >= DANGER_C:
            want = 255
        elif now < self.next_step:
            return
        else:
            self.smooth = follow if self.smooth is None else (
                smoothing * self.smooth + (1 - smoothing) * follow)
            self.stopped = bool(stop_below) and self.smooth < stop_below + (
                FAN_STOP_HYST_C if self.stopped else 0)
            target = 0 if self.stopped else max(self.min_pwm, floor, curve_pwm(curve, self.smooth))
            want = target
            if self.cur >= 0 and not self.stopped:
                want = max(self.cur - down, min(self.cur + up, want))
            if want:
                want = min(255, max(FAN_QUANTUM, round(want / FAN_QUANTUM) * FAN_QUANTUM))
            self.status(name, target)
        self.next_step = now + FAN_STEP_S
        if want != self.cur and wr(f"{self.dir}/pwm1", want):
            if abs(want - self.cur) >= 40 or self.cur < 0:
                log(f"fan: {self.smooth or follow:.1f} C (hottest {raw:.0f} C, {hottest_zone()}) -> pwm {want}")
            self.cur = want

    def status(self, name: str, target: int) -> None:
        """What the fan is doing, for Zaviya Control's graph."""
        try:
            os.makedirs(os.path.dirname(FAN_STATUS), exist_ok=True)
            with open(FAN_STATUS + ".tmp", "w", encoding="utf-8") as fh:
                json.dump({"curve": name, "temp": round(self.smooth, 1),
                           "pwm": max(self.cur, 0), "target": target}, fh)
            os.replace(FAN_STATUS + ".tmp", FAN_STATUS)
        except OSError:
            pass

    def failsafe_now(self) -> None:
        if self.dir:
            wr(f"{self.dir}/pwm1", self.failsafe)


def shutting_down() -> bool:
    try:
        r = subprocess.run(["systemctl", "is-system-running"], capture_output=True,
                           text=True, timeout=2)
        return r.stdout.strip() == "stopping"
    except (OSError, subprocess.SubprocessError):
        return False


# ------------------------------------------------------------------ gpu ----
def gpu_devfreq() -> str | None:
    for d in glob.glob("/sys/class/devfreq/*"):
        if "gpu" in os.path.basename(d) or "3d00000" in d:
            return d
    return None


def is_sm8550() -> bool:
    try:
        return b"qcom,sm8550" in open("/proc/device-tree/compatible", "rb").read()
    except OSError:
        return False


def apply_gpu(profile: str) -> None:
    d = gpu_devfreq()
    if not d:
        return
    freqs = sorted(int(f) for f in rd(f"{d}/available_frequencies").split() if f.isdigit())
    if not freqs:
        return
    lo, hi = GPU_RANGE[profile]
    fmin = freqs[int(lo * (len(freqs) - 1))]
    fmax = freqs[int(round(hi * (len(freqs) - 1)))]
    # order matters: never set min above the current max
    wr(f"{d}/max_freq", freqs[-1])
    wr(f"{d}/min_freq", fmin)
    wr(f"{d}/max_freq", fmax)
    # 16 ms polling is tuned for the 8 Gen 3. On the 8 Gen 2 it cost about
    # 20% of the 1% lows (measured on an RP6), so it keeps the default there.
    if not is_sm8550():
        wr(f"{d}/polling_interval", 16)


def fanless() -> bool:
    """Tablets (Lenovo Legion Y700 Gen 3 / Gen 4) have no fan: pinning the big
    cores there only heats the chip into GPU throttling, and Turbo ran games
    slower than Balanced."""
    compat = rd("/sys/firmware/devicetree/base/compatible").split("\0")
    return "lenovo,tb321fu" in compat or "lenovo,elden" in compat


def apply_cpu(profile: str) -> None:
    """schedutil everywhere (the stock default is `performance`, which
    holds all eight cores — little A520s included — at max clock: heat for
    nothing). Turbo pins only the big clusters to `performance`, except on a
    fanless tablet, where Turbo keeps only its higher GPU floor."""
    big = set() if fanless() else big_cpus()
    for pol in glob.glob("/sys/devices/system/cpu/cpufreq/policy*"):
        govs = rd(f"{pol}/scaling_available_governors")
        cpus = {int(c) for c in rd(f"{pol}/related_cpus").split() if c.isdigit()}
        gov = "schedutil"
        if profile == "turbo" and cpus and cpus <= big and "performance" in govs:
            gov = "performance"
        if gov in govs:
            wr(f"{pol}/scaling_governor", gov)
        if gov == "schedutil":
            wr(f"{pol}/schedutil/rate_limit_us", 500)
        wr(f"{pol}/scaling_max_freq", rd(f"{pol}/cpuinfo_max_freq"))


def big_cpus() -> set[int]:
    """CPUs not in the lowest-capacity cluster (drops the Cortex-A520s)."""
    caps = {}
    for c in glob.glob("/sys/devices/system/cpu/cpu[0-9]*"):
        n = int(os.path.basename(c)[3:])
        try:
            caps[n] = int(rd(f"{c}/cpu_capacity", "0")) or int(rd(f"{c}/cpufreq/cpuinfo_max_freq", "0"))
        except ValueError:
            caps[n] = 0
    if not caps:
        return set()
    low = min(caps.values())
    big = {n for n, v in caps.items() if v > low}
    return big or set(caps)


# ------------------------------------------------------ per-game perf ----
# Set per game in Zaviya Control (state "perf_games", keyed by App ID):
# a profile of its own, CPU and GPU caps, the cores its threads may use and
# their priority. Applied when the game starts, and at once when changed
# while it runs; the profile's own values come back when it exits.
GAME_PRIORITY = {"normal": 0, "high": -5, "highest": -10}


def game_perf(st: dict) -> dict:
    entry = (st.get("perf_games") or {}).get(str(CURRENT_APPID)) if CURRENT_APPID else None
    return entry if isinstance(entry, dict) else {}


def game_cores(value) -> set[int] | None:
    """The cores a game may run on: None leaves it to the default."""
    every = set(range(os.cpu_count() or 8))
    if value == "all":
        return every
    if value == "big":
        return big_cpus()
    if isinstance(value, str) and value not in ("", "default"):
        cpus = cpu_list(value) & every
        return cpus or None
    return None


def cap_cpu(frac: float) -> None:
    """Every cluster to at most frac of its top clock (never raises a cap
    that is already lower, such as Steam's TDP limit)."""
    for pol in glob.glob("/sys/devices/system/cpu/cpufreq/policy*"):
        freqs = sorted(int(f) for f in rd(f"{pol}/scaling_available_frequencies").split() if f.isdigit())
        if not freqs:
            continue
        want = max([f for f in freqs if f <= freqs[-1] * frac] or freqs[:1])
        cur = int(rd(f"{pol}/scaling_max_freq", str(freqs[-1])) or freqs[-1])
        wr(f"{pol}/scaling_max_freq", min(cur, want))


def cap_gpu(lo: float, hi: float) -> None:
    d = gpu_devfreq()
    freqs = sorted(int(f) for f in rd(f"{d}/available_frequencies").split() if f.isdigit()) if d else []
    if not freqs:
        return
    fmin = freqs[int(lo * (len(freqs) - 1))]
    fmax = max(fmin, freqs[int(round(hi * (len(freqs) - 1)))])
    wr(f"{d}/max_freq", freqs[-1])
    wr(f"{d}/min_freq", fmin)
    wr(f"{d}/max_freq", fmax)


