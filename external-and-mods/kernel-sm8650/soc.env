# SM8650 (Snapdragon 8 Gen 3 / G3 Gen 3): KONKR Pocket FIT, AYANEO Pocket S2.
# Sourced by kernel-common/build.sh and kernel-common/cmdline.sh.

SOC=sm8650
ROCKNIX_DEVICE=SM8650

# ROCKNIX's 7.2 recipe (tag 20260901) on Linux 7.2.8, the same base as the
# 8 Gen 2 kernel, built with GCC 15 (kernel-common/build-gcc15.sh). Their
# 7.2 development branch black-screened the Pocket FIT on 2026-09-23; that
# was a GCC 13 build, which dies the same way on the RP6.
# On top: the PCIe iommu-map fix 7.2's sm8650.dtsi needs for the Wi-Fi, and
# the s2idle series (PCIe memory floor, RPMh sleep-set regulators, audio
# graphs released across suspend, tsens/geni/ICE/UFS fixes).
# SM8650_RECIPE=7.1 builds the previous kernel (ROCKNIX 20260801, 7.1.2).
# SM8650_RECIPE=7.2 builds the recipe above; kernel-tb321fu pins it.
# SM8650_RECIPE=7.4 (the default) is that recipe ported to Linux 7.4-rc1, with
# the patches in kernel-sm8650-74 (kernel-sm8650/patches stay on 7.2.8).
KVER=7.2.8
ROCKNIX_REF=20260901
EXTRA_FW_REF=2b7207cfcb80c53c09dc6e04165789ecaf2d3348
PATCH_DIRS="projects/ROCKNIX/packages/linux/patches/7.2 projects/ROCKNIX/packages/linux/patches/mainline projects/ROCKNIX/devices/SM8650/patches/linux packages/linux/patches/default"
# 9999 renames perf's Rust targets for ROCKNIX's toolchain; we don't build perf.
# 0016 (Armada's PCIe suspend OPP) voted CX at low_svs through s2idle, which
# keeps CX from collapsing; 0047 is our floor at CX retention instead. With no
# floor at all the Pocket FIT never woke from s2idle.
PATCH_SKIP="9999-fix-rust-build-error.patch 0016-arm64-dts-qcom-sm8650-add-a-pcie-suspend-opp.patch"

if [[ "${SM8650_RECIPE:-7.4}" == 7.1 ]]; then
  KVER=7.1.2
  ROCKNIX_REF=20260801
  EXTRA_FW_REF=88b363e67d4f730feb2c3124724d26dfaa88ce76
  PATCH_DIRS="projects/ROCKNIX/packages/linux/patches/mainline projects/ROCKNIX/devices/SM8650/patches/linux packages/linux/patches/default"
  # Everything from 0007 on was written against 7.2.
  PATCH_SKIP="$(cd "$(dirname "${BASH_SOURCE[0]}")/patches" && ls | awk -F- '$1 >= "0007"' | tr '\n' ' ')"
fi

if [[ "${SM8650_RECIPE:-7.4}" == 7.4 ]]; then
  # Linux 7.4-rc1 from git.kernel.org's snapshot (rc releases are not on
  # cdn.kernel.org); build.sh unpacks it like any KSRC_URL tree.
  KVER=7.4-rc1
  KSRC_URL=https://git.kernel.org/torvalds/t/linux-7.4-rc1.tar.gz
  KSRC_SHA256=b19dd413fa7cc4059de8dab234320858e86abdc15c7c4d839eff15b0e2ac39ee
  PORT_DIRS="kernel-sm8650-74"
  # ROCKNIX patches 7.4-rc1 already has, or that kernel-sm8650-74 replaces:
  #  already upstream: 0001-pcie-update-sm8650-dtsi, v2_20260420 Neil's sm8650
  #    misc enhancements, 0060 Silergy SY7758 backlight driver (drivers/video/
  #    backlight/sy7758.c), v6_20260210 QCE runtime PM and interconnect scaling;
  #  not for these devices: 0005 Bluetooth btrtl RTL8733BU (mainline dir);
  #  ported to 7.4 (kernel-sm8650-74/patches/0000-*): 0007 audioreach WSA2,
  #    0063 Pocket FIT panel, 0121 rpmhpd presync floor;
  #  also upstream: 20260424 Neil's GCC CX power domain (bindings and the
  #    sm8450, sm8550 and sm8650 dtsi are all in 7.4).
  PATCH_SKIP="$PATCH_SKIP 0005-Bluetooth-btrtl-Add-the-support-for-RTL8733BU.patch 0001-pcie-update-sm8650-dtsi.patch v2_20260420_neil_armstrong_arm64_qcom_sm8650_misc_enhancements.patch 0060-Add-Silergy-SY7758-backlight-driver.patch v6_20260210_quic_utiwari_crypto_qce_add_runtime_pm_and_interconnect_bandwidth_scaling_support.patch 0007-audioreach-Add-dedicated-WSA2-support.patch 0063-gpu-drm-panel-add-pocket-fit-panel.patch 0121-pmdomain-qcom-rpmhpd-presync-floor-gmu-rails.patch 20260424_neil_armstrong_arm64_dts_qcom_sm8_456_50_add_missing_cx_power_domain_to_gcc.patch"
fi

# DTBs appended to KERNEL (ABL shows one menu entry per DTB model).
DTBS="sm8650-ayaneo-ps2 sm8650-konkr-pf"

# Built into the kernel image (needed before the rootfs is mounted):
# <source>:<path under /lib/firmware>. xfw/ = ROCKNIX extra-firmware tree.
BUILTIN_FW="
xfw/SM8650/qcom/gen70900_aqe.fw:qcom/gen70900_aqe.fw
xfw/SM8650/qcom/gen70900_sqe.fw:qcom/gen70900_sqe.fw
xfw/SM8650/qcom/gmu_gen70900.bin:qcom/gmu_gen70900.bin
xfw/SM8650/qcom/sm8650/ayaneo/ps2/gen70900_zap.mbn:qcom/sm8650/ayaneo/ps2/gen70900_zap.mbn
"

# Kernel cmdline, SoC part (see kernel-common/cmdline.sh).
# irqaffinity: IRQs on the two A520s, like ROCKNIX.
# Pocket FIT XInput pad polled at 2 ms (0506-usbcore-add-interrupt-interval-override).
# Deep suspend never resumes on the Pocket FIT (7.1.2); s2idle wakes reliably.
# fw_devlink.sync_state=timeout: the GMU and the UFS ICE crypto node never get
# a driver of their own, so in the default strict mode gcc-sm8650 and the
# GPU clock controller waited for them forever and kept every clock, power
# domain and RPMh vote they started with (no CX collapse in s2idle).
CMDLINE_SOC="irqaffinity=0-1 usbcore.interrupt_interval_override=045e:028e:2 mem_sleep_default=s2idle fw_devlink.sync_state=timeout"
