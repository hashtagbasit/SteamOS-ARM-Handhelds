# kShimC boot menu build: the source and its four dependencies, by commit.
# build-kshimc.sh fetches all of them; nothing is vendored in this repo.
#
# The source tree and the packer tools live in one repository; the menu runtime
# is GPL-3.0-only (see README.md).
KSHIMC_REPO_URL=https://github.com/mydanyi/armadaos-freedom
KSHIMC_REPO_COMMIT=e8cec8ebc1db30bd72c47d57eefc314552dc8171
KSHIMC_SRC_PATH=devices/lenovo-tb323fu/boot/kshim-success-source
KSHIMC_TOOLS_PATH=packages/kshim-tools

CRDK_URL=https://github.com/Project-Aloha/CrDK
CRDK_COMMIT=b6c3335136b7f6b28271917de11e8f11982975fc
PICOLIBC_URL=https://github.com/picolibc/picolibc
PICOLIBC_COMMIT=f7edb0869e64b9d687f46961adeef7154921fe92
LVGL_URL=https://github.com/lvgl/lvgl
LVGL_COMMIT=7f07a129e8d77f4984fff8e623fd5be18ff42e74
# libfdt comes from this repository's lib/libfdt, plus one added include line.
LIBFDT_URL=https://github.com/sunflower2333/kShimC
LIBFDT_COMMIT=82ce6eaa10c36e64cfd3f16799172d854f9a955b
LIBFDT_ENV_SHA256=132cb14b8f0b323e5701d4bfcb0ebba4b1f35726bfdfa6739f18ad638d20e582

# Python packages for the config and the font check.
PIP_PACKAGES="kconfiglib==14.1.0 fonttools==4.54.1 lz4==4.3.3"
