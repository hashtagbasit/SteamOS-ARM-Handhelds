From ea99e398e367b3f0afb9033d3bf5ddf28dd78368 Mon Sep 17 00:00:00 2001
From: Ludovico de Nittis <ludovico.denittis@collabora.com>
Date: Tue, 4 Aug 2026 12:02:29 +0200
Subject: [PATCH] iwd: take over scanning and autoconnect when IWD autoconnect
 is off

With wifi.iwd.autoconnect enabled, NM delegates scanning and autoconnect
to IWD.
However, when calling IWD Station.Disconnect(), the station's
autoconnect gets disabled until something re-arms it.
When that happens, neither NM nor IWD are scanning or reconnecting.

When using two WiFi adapters this can end up in a deadlock. The IWD list
of known networks is global, so a secondary adapter could try to connect
to a network that is pinned to another interface. NM rejects it and
sends Station.Disconnect().
And if the initially wanted network had an hidden SSID and was not part
of the scan results, the explicit activation fails and nothing will
trigger a new scan.

When IWD autoconnect gets disabled, we use a new
iwd_autoconnect_temp_disabled flag to temporarily fall back to the same
behavior as if wifi.iwd.autoconnect was set to false. Letting NM handle
the scans and autoconnect.

Signed-off-by: Ludovico de Nittis <ludovico.denittis@collabora.com>
---
 src/core/devices/wifi/nm-device-iwd.c | 72 +++++++++++++++++++++++----
 1 file changed, 61 insertions(+), 11 deletions(-)

diff --git a/src/core/devices/wifi/nm-device-iwd.c b/src/core/devices/wifi/nm-device-iwd.c
index fa6e2f9d3a..2409a23fe6 100644
--- a/src/core/devices/wifi/nm-device-iwd.c
+++ b/src/core/devices/wifi/nm-device-iwd.c
@@ -66,6 +66,7 @@ typedef struct {
     bool                          can_scan : 1;
     bool                          nm_autoconnect : 1;
     bool                          iwd_autoconnect : 1;
+    bool                          iwd_autoconnect_temp_disabled : 1;
     bool                          scanning : 1;
     bool                          scan_requested : 1;
     bool                          act_mode_switch : 1;
@@ -114,8 +115,41 @@ static void schedule_periodic_scan(NMDeviceIwd *self, gboolean initial_scan);
 
 static gboolean check_scanning_prohibited(NMDeviceIwd *self, gboolean periodic);
 
+static const char *get_variant_state(GVariant *v);
+
 /*****************************************************************************/
 
+static gboolean
+iwd_autoconnect_active(NMDeviceIwdPrivate *priv)
+{
+    return priv->iwd_autoconnect && !priv->iwd_autoconnect_temp_disabled;
+}
+
+/*
+ * Call this when we send a Station.Disconnect(), because IWD autoconnect gets
+ * disabled. We take over scanning and autoconnect until it is re-armed.
+ */
+static void
+take_over_autoconnect(NMDeviceIwd *self)
+{
+    NMDeviceIwdPrivate        *priv  = NM_DEVICE_IWD_GET_PRIVATE(self);
+    gs_unref_variant GVariant *value = NULL;
+
+    nm_log_info(LOGD_DEVICE | LOGD_WIFI, "Taking over autoconnect duty");
+
+    priv->iwd_autoconnect_temp_disabled = TRUE;
+    schedule_periodic_scan(self, FALSE);
+
+    /* If IWD was already in the "disconnected" state, the Disconnect() call
+     * won't trigger the State property change that enables NM autoconnect.
+     */
+    value = g_dbus_proxy_get_cached_property(priv->dbus_station_proxy, "State");
+    if (!priv->nm_autoconnect && nm_streq(get_variant_state(value), "disconnected")) {
+        priv->nm_autoconnect = TRUE;
+        nm_device_recheck_auto_activate_schedule(NM_DEVICE(self));
+    }
+}
+
 static void
 _ap_dump(NMDeviceIwd *self, NMLogLevel log_level, const NMWifiAP *ap, const char *prefix)
 {
@@ -158,7 +192,7 @@ ap_add_remove(NMDeviceIwd *self,
         nm_dbus_object_clear_and_unexport(&ap);
     }
 
-    if (priv->enabled && !priv->iwd_autoconnect)
+    if (priv->enabled && !iwd_autoconnect_active(priv))
         nm_device_recheck_auto_activate_schedule(NM_DEVICE(self));
 
     if (recheck_available_connections)
@@ -207,7 +241,7 @@ remove_all_aps(NMDeviceIwd *self)
     c_list_for_each_entry_safe (ap, ap_safe, &priv->aps_lst_head, aps_lst)
         ap_add_remove(self, FALSE, ap, FALSE);
 
-    if (!priv->iwd_autoconnect)
+    if (!iwd_autoconnect_active(priv))
         nm_device_recheck_auto_activate_schedule(NM_DEVICE(self));
 
     nm_device_recheck_available_connections(NM_DEVICE(self));
@@ -400,7 +434,7 @@ get_ordered_networks_cb(GObject *source, GAsyncResult *res, gpointer user_data)
     }
 
     if (changed) {
-        if (!priv->iwd_autoconnect)
+        if (!iwd_autoconnect_active(priv))
             nm_device_recheck_auto_activate_schedule(NM_DEVICE(self));
 
         nm_device_recheck_available_connections(NM_DEVICE(self));
@@ -493,6 +527,8 @@ send_disconnect(NMDeviceIwd *self)
                       NULL,
                       NULL,
                       NULL);
+
+    take_over_autoconnect(self);
 }
 
 static void
@@ -689,6 +725,8 @@ deactivate_async(NMDevice                  *device,
                           cancellable,
                           disconnect_cb,
                           user_data);
+
+        take_over_autoconnect(self);
     } else
         reset_mode(self, cancellable, disconnect_cb, user_data);
 }
@@ -1679,7 +1717,7 @@ failed:
     nm_device_state_changed(device, NM_DEVICE_STATE_FAILED, reason);
 
     value = g_dbus_proxy_get_cached_property(priv->dbus_station_proxy, "State");
-    if (!priv->iwd_autoconnect && nm_streq(get_variant_state(value), "disconnected")) {
+    if (!iwd_autoconnect_active(priv) && nm_streq(get_variant_state(value), "disconnected")) {
         schedule_periodic_scan(self, TRUE);
 
         if (!priv->nm_autoconnect) {
@@ -2545,7 +2583,7 @@ schedule_periodic_scan(NMDeviceIwd *self, gboolean initial_scan)
      * autoconnect and interrupt the ongoing scan, meaning that we still want
      * a new scan ASAP.
      */
-    if (!priv->can_scan || priv->scan_requested || priv->current_ap || priv->iwd_autoconnect)
+    if (!priv->can_scan || priv->scan_requested || priv->current_ap || iwd_autoconnect_active(priv))
         interval = -1;
     else if (initial_scan && priv->scanning)
         interval = 0;
@@ -2572,7 +2610,7 @@ set_can_scan(NMDeviceIwd *self, gboolean can_scan)
 
     priv->can_scan = can_scan;
 
-    if (!priv->iwd_autoconnect)
+    if (!iwd_autoconnect_active(priv))
         schedule_periodic_scan(self, TRUE);
 }
 
@@ -2773,6 +2811,13 @@ state_changed(NMDeviceIwd *self, const char *new_state)
         network_path     = nm_ref_string_new(network_path_str);
         ap               = find_ap_by_supplicant_path(self, network_path);
 
+        /* If we reach this point, it means autoconnect was re-armed by
+         * Network.Connect(), no need to use NM autoconnect anymore
+         */
+        priv->iwd_autoconnect_temp_disabled = FALSE;
+        schedule_periodic_scan(self, FALSE);
+        nm_log_info(LOGD_DEVICE | LOGD_WIFI, "Handing over autoconnect back to IWD, if set");
+
         if (!ap) {
             _LOGW(LOGD_DEVICE | LOGD_WIFI,
                   "ConnectedNetwork points to an unknown Network %s",
@@ -2908,7 +2953,7 @@ state_changed(NMDeviceIwd *self, const char *new_state)
     /* Don't allow new connection until iwd exits disconnecting and no
      * Connect callback is pending.
      */
-    if (!priv->iwd_autoconnect && NM_IN_STRSET(new_state, "disconnected")) {
+    if (!iwd_autoconnect_active(priv) && NM_IN_STRSET(new_state, "disconnected")) {
         priv->nm_autoconnect = TRUE;
         if (!can_connect)
             nm_device_recheck_auto_activate_schedule(device);
@@ -2930,7 +2975,7 @@ scanning_changed(NMDeviceIwd *self, gboolean new_scanning)
     if (!priv->scanning) {
         update_aps(self);
 
-        if (!priv->scan_requested && !priv->iwd_autoconnect)
+        if (!priv->scan_requested && !iwd_autoconnect_active(priv))
             schedule_periodic_scan(self, FALSE);
     }
 }
@@ -3050,6 +3095,10 @@ powered_changed(NMDeviceIwd *self, gboolean new_powered)
         GVariant *value;
 
         priv->dbus_station_proxy = G_DBUS_PROXY(interface);
+
+        /* This is a new station, don't disable IWD autoconnect by default */
+        priv->iwd_autoconnect_temp_disabled = FALSE;
+
         g_signal_connect(priv->dbus_station_proxy,
                          "g-properties-changed",
                          G_CALLBACK(station_properties_changed),
@@ -3076,9 +3125,10 @@ powered_changed(NMDeviceIwd *self, gboolean new_powered)
         }
     } else {
         set_can_scan(self, FALSE);
-        priv->scanning       = FALSE;
-        priv->scan_requested = FALSE;
-        priv->nm_autoconnect = FALSE;
+        priv->scanning                      = FALSE;
+        priv->scan_requested                = FALSE;
+        priv->nm_autoconnect                = FALSE;
+        priv->iwd_autoconnect_temp_disabled = FALSE;
         cleanup_association_attempt(self, FALSE);
         remove_all_aps(self);
     }
-- 
2.55.0

