# SM8250 (Snapdragon 865): Retroid Pocket 5 / Flip 2 / Mini / Mini V2,
# AYN Thor Lite, MANGMI Air Y Pro / Pocket Max, AYANEO Pocket MICRO 2.
# Sourced by kernel-common/build.sh and kernel-common/cmdline.sh.

SOC=sm8250
ROCKNIX_DEVICE=SM8250

# Base release 20261001 is the first release that boots SM8250 through the
# ROCKNIX ABL (BOOTLOADER=qcom-abl; 20260901 still used GRUB on the ESP), so
# the KERNEL here is packed the same way as on the other chips. Same 7.2.8
# base as SM8550/SM8650.
KVER=7.2.8
ROCKNIX_REF=20261001
EXTRA_FW_REF=88b363e67d4f730feb2c3124724d26dfaa88ce76
LINUX_FW_REF=20260916

# The base's order for 7.2: version dir, mainline, device, default.
PATCH_DIRS="projects/ROCKNIX/packages/linux/patches/7.2 projects/ROCKNIX/packages/linux/patches/mainline projects/ROCKNIX/devices/SM8250/patches/linux packages/linux/patches/default"
# 9999 renames perf's Rust targets for the base's toolchain; we don't build perf.
# 0011 (adc-tm5 IIO value check) is already in 7.2.8.
PATCH_SKIP="9999-fix-rust-build-error.patch 0011-thermal-adc-tm5-drop-iio-val-int-check.patch"

if [[ "${SM8250_RECIPE:-7.4}" == 7.4 ]]; then
  # Linux 7.4-rc1 from git.kernel.org's snapshot (rc releases are not on
  # cdn.kernel.org); build.sh unpacks it like any KSRC_URL tree.
  KVER=7.4-rc1
  KSRC_URL=https://git.kernel.org/torvalds/t/linux-7.4-rc1.tar.gz
  KSRC_SHA256=b19dd413fa7cc4059de8dab234320858e86abdc15c7c4d839eff15b0e2ac39ee
  PORT_DIRS="kernel-sm8250-74"
  # The base patches 7.4-rc1 already has, or that kernel-sm8250-74 replaces:
  #  already upstream: 7.2/0016 DP audio_prepare returns 0 with the cable out,
  #    0062 wsa881x shared powerdown GPIO (7.4's shared GPIO proxy handles it:
  #    the driver requests the pin GPIOD_OUT_HIGH and the proxy arbitrates);
  #  not for these devices: 0005 Bluetooth btrtl RTL8733BU (mainline dir);
  #  ported to 7.4 (kernel-sm8250-74/patches/0000-*): 0057 ICNA35XX (7.4 has
  #    its own, different icna35xx driver for the AYN/AYANEO panels; the
  #    The base one replaces it for the chipone,icna3520 and Pocket Max panels),
  #    0063 Pocket Max HL7139 charge pump (Makefile context).
  # The base's 7.2/0010-msm-resource-cleanup.patch writes cstate->num_mixers
  # through an uninitialized pointer. The fixed copy is 0000-0010-msm-resource-
  # cleanup.patch in the port directory; it sorts first, so it still applies
  # before the DPU patches that build on it.
  PATCH_SKIP="$PATCH_SKIP 0005-Bluetooth-btrtl-Add-the-support-for-RTL8733BU.patch 0016-drm-msm-dp-return-0-from-audio_prepare-when-cable-is-disconnected.patch 0057_Chipone-ICNA35XX-panel.patch 0062_wsa881x-shared-powerdown-gpio.patch 0063_Mangmi-Pocket-Max-HL7139-charge-pump.patch 0010-msm-resource-cleanup.patch"
fi

DTBS="sm8250-ayaneo-pocketmicro2 sm8250-retroidpocket-rp5 sm8250-retroidpocket-rp5-visionox sm8250-retroidpocket-flip2 sm8250-retroidpocket-flip2-visionox sm8250-retroidpocket-rpmini sm8250-retroidpocket-rpminiv2 sm8250-ayn-thorlite sm8250-mangmi-air-y-pro sm8250-mangmi-pocket-max"

# The files the base's SM8250 kernel-firmware.dat takes from linux-firmware
# (none of them are in the SteamOS rootfs). Like the base, nothing is built
# in: the GPU microcode loads once the root is mounted. The Thor Lite's own
# ADSP and the Pocket Max MCU come from extra-firmware's SM8250 folder.
FW_BUILTIN=0
BUILTIN_FW="
lfw/qcom/a650_gmu.bin:qcom/a650_gmu.bin
lfw/qcom/a650_sqe.fw:qcom/a650_sqe.fw
lfw/qcom/sm8250/a650_zap.mbn:qcom/sm8250/a650_zap.mbn
lfw/qcom/sm8250/adsp.mbn:qcom/sm8250/adsp.mbn
lfw/qcom/sm8250/cdsp.mbn:qcom/sm8250/cdsp.mbn
lfw/qcom/vpu/vpu20_p4.mbn:qcom/vpu-1.0/venus.mbn
lfw/ath11k/QCA6390/hw2.0/amss.bin:ath11k/QCA6390/hw2.0/amss.bin
lfw/ath11k/QCA6390/hw2.0/m3.bin:ath11k/QCA6390/hw2.0/m3.bin
lfw/ath11k/QCA6390/hw2.0/board-2.bin:ath11k/QCA6390/hw2.0/board-2.bin
lfw/qca/htbtfw20.tlv:qca/htbtfw20.tlv
lfw/qca/htnv20.bin:qca/htnv20.bin
"

# The base's SM8250 cmdline is only quiet/console/rootwait; s2idle like the
# other chips (there is no deep state to fall into), and the sync_state
# timeout so clock controllers with driverless consumers drop their boot votes.
CMDLINE_SOC="usbcore.interrupt_interval_override=045e:028e:2 mem_sleep_default=s2idle fw_devlink.sync_state=timeout"

# Packed like the base's KERNEL: initramfs built into the Image, dummy ramdisk.
EMBED_INITRAMFS=1
