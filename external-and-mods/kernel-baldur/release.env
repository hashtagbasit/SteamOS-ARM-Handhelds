# Lenovo Legion Y700 Gen 5 (TB323FU, SM8850 "kaanapali", board "baldur"):
# what the kernel is built from, pinned.
#  - Linux v7.3-rc4 from kernel.org
#  - the board's patch series, device tree, config fragments and the
#    out-of-tree aw882xx amplifier driver from joonhoekim/tb323fu-linux
#    (GPL-2.0 patches, BSD-3-Clause device trees; authors and sources of every
#    patch in its kernel/PROVENANCE.md)
BALDUR_KSRC_URL=https://git.kernel.org/torvalds/t/linux-7.3-rc4.tar.gz
BALDUR_KVER=7.3-rc4
BALDUR_PORT_COMMIT=37ada75998cedee2f95007248e71879aca996739
BALDUR_PORT_URL=https://codeload.github.com/joonhoekim/tb323fu-linux/tar.gz/${BALDUR_PORT_COMMIT}
# Only this Android firmware is known to boot mainline (ZUI 18.0.12.187 hangs).
BALDUR_ANDROID_FIRMWARE=18.0.12.104
