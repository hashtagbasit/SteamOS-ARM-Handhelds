# Lenovo Legion Y700 Gen 5: on top of the board's fragments and
# kernel-common/steamos.config.
CONFIG_LOCALVERSION="-baldur-steamos"
# CONFIG_LOCALVERSION_AUTO is not set
# Our startup code (kernel-common/initramfs), built in: the boot image in
# boot_a is self-contained, and the bootloader's command line isn't used.
CONFIG_INITRAMFS_SOURCE="/build/initrd.cpio"
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_CMDLINE="icc-rpmh.qos_disable=1 icc_rpmh.qos_disable=1 fw_devlink.sync_state=timeout fbcon=font:TER16x32 panic=10 console=tty1 qcom_scm.download_mode=full consoleblank=0 mem_sleep_default=s2idle cpuidle_psci_domain.allow_cluster_off=0 root=PARTLABEL=steamos-gen5 rootwait rw rootfstype=ext4 errors=remount-ro firmware_class.path=/var/lib/steamos-arm/firmware/baldur steamos.bootlabel=steamos-gen5-logs bootconfig"
CONFIG_CMDLINE_FORCE=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_VFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_MMC_BLOCK=y
# Lepton (Android apps)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# zram-generator (steamos-arm-zram.conf) asks for zstd. The pinned board
# series' baldur-extra.fragment (merged last, build-baldur-kernel.sh) turns
# on the zstd/lz4 zram backends; before it the algorithm write failed, zram0
# was never set up and dev-zram0.device timed out at every boot (ledger S26).
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
