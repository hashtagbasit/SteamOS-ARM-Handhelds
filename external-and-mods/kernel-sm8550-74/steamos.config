# SM8550 on Linux 7.4, on top of kernel-common/steamos.config.
# NETFILTER_XT_TARGET_NAT became NETFILTER_XT_NAT, which the common fragment
# already sets. The old names show up as WARN lines in the build log.

# Binder for Lepton. 7.4 has only the Rust driver, the C one is gone. The device
# names come from the common fragment.
CONFIG_RUST=y
CONFIG_ANDROID_BINDER_IPC_RUST=y
