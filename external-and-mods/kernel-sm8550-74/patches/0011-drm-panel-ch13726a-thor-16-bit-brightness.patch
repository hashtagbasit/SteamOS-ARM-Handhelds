From: hashtagbasit
Subject: drm/panel: ch13726a: 16-bit brightness on the AYN Thor's bottom panel

The Thor's bottom AMOLED reads its brightness as a 16-bit value, high byte
first. The driver sent one byte over 0-255, so level n arrived as n * 256 and
the screen barely dimmed. On ch13726a,thor use the 16-bit DCS command over
the panel's full 0-65535 range. Other ch13726a panels are unchanged.

---
--- a/drivers/gpu/drm/panel/panel-ddic-ch13726a.c
+++ b/drivers/gpu/drm/panel/panel-ddic-ch13726a.c
@@ -203,7 +203,15 @@
 
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
-	ret = mipi_dsi_dcs_set_display_brightness(dsi, brightness);
+	/*
+	 * The AYN Thor's bottom panel reads a 16-bit brightness, high byte
+	 * first. Sent as one byte (low first), level n arrived as n * 256 and
+	 * only the lowest ~16 steps dimmed at all.
+	 */
+	if (bl->props.max_brightness > 255)
+		ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	else
+		ret = mipi_dsi_dcs_set_display_brightness(dsi, brightness);
 	if (ret < 0)
 		return ret;
 
@@ -220,10 +228,16 @@
 ch13726a_create_backlight(struct mipi_dsi_device *dsi)
 {
 	struct device *dev = &dsi->dev;
+	/*
+	 * Thor: the full 16-bit range. Capping it at 4095 left the bottom
+	 * screen far dimmer than the top at maximum; the low end stays usable
+	 * through thor-backlightd's curve.
+	 */
+	int max = of_device_is_compatible(dev->of_node, "ch13726a,thor") ? 65535 : 255;
 	const struct backlight_properties props = {
 		.type = BACKLIGHT_RAW,
-		.brightness = 255,
-		.max_brightness = 255,
+		.brightness = max,
+		.max_brightness = max,
 	};
 
 	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
