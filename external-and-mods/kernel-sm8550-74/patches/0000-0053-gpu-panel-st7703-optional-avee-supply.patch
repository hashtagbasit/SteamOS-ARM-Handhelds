From: Alexandre Hamamdjian <azkali.limited@gmail.com>
Subject: [PATCH] drm/panel: st7703: optional avee-supply for the AYANEO Pocket DS lower panel

The AYANEO Pocket DS lower panel (ayaneo,pocket-ds-lower-panel, in 7.4)
takes its negative rail from the other output of the SGM3804 that feeds vcc.
ROCKNIX's Pocket DS patch (SM8550 0053) adds an optional avee-supply that is
sequenced with the panel; the panel itself is upstream in 7.4, the supply is
not. Only the supply is carried here.
---
diff --git a/drivers/gpu/drm/panel/panel-sitronix-st7703.c b/drivers/gpu/drm/panel/panel-sitronix-st7703.c
--- a/drivers/gpu/drm/panel/panel-sitronix-st7703.c
+++ b/drivers/gpu/drm/panel/panel-sitronix-st7703.c
@@ -59,6 +59,7 @@
 	struct gpio_desc *reset_gpio;
 	struct regulator *vcc;
 	struct regulator *iovcc;
+	struct regulator *avee;
 
 	struct dentry *debugfs;
 	const struct st7703_panel_desc *desc;
@@ -810,6 +811,8 @@
 	struct st7703 *ctx = panel_to_st7703(panel);
 
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	if (ctx->avee)
+		regulator_disable(ctx->avee);
 	regulator_disable(ctx->iovcc);
 	regulator_disable(ctx->vcc);
 
@@ -835,6 +838,16 @@
 		dev_err(ctx->dev, "Failed to enable vcc supply: %d\n", ret);
 		regulator_disable(ctx->iovcc);
 		return ret;
+	}
+
+	if (ctx->avee) {
+		ret = regulator_enable(ctx->avee);
+		if (ret < 0) {
+			dev_err(ctx->dev, "Failed to enable avee supply: %d\n", ret);
+			regulator_disable(ctx->vcc);
+			regulator_disable(ctx->iovcc);
+			return ret;
+		}
 	}
 
 	/* Give power supplies time to stabilize before deasserting reset. */
@@ -969,6 +982,19 @@
 		return dev_err_probe(dev, PTR_ERR(ctx->iovcc),
 				     "Failed to request iovcc regulator\n");
 
+	/*
+	 * Panels whose positive rail comes from a dual-output regulator - the
+	 * AYANEO Pocket DS lower panel is fed by an SGM3804 - need the matching
+	 * negative rail brought up with it. Optional: no other panel here has one.
+	 */
+	ctx->avee = devm_regulator_get_optional(dev, "avee");
+	if (IS_ERR(ctx->avee)) {
+		if (PTR_ERR(ctx->avee) != -ENODEV)
+			return dev_err_probe(dev, PTR_ERR(ctx->avee),
+					     "Failed to request avee regulator\n");
+		ctx->avee = NULL;
+	}
+
 	ret = drm_of_get_panel_orientation(dsi->dev.of_node, &ctx->orientation);
 	if (ret < 0)
 		return dev_err_probe(&dsi->dev, ret, "Failed to get orientation\n");
diff --git a/Documentation/devicetree/bindings/display/panel/rocktech,jh057n00900.yaml b/Documentation/devicetree/bindings/display/panel/rocktech,jh057n00900.yaml
--- a/Documentation/devicetree/bindings/display/panel/rocktech,jh057n00900.yaml
+++ b/Documentation/devicetree/bindings/display/panel/rocktech,jh057n00900.yaml
@@ -45,6 +45,11 @@
   iovcc-supply:
     description: I/O voltage supply
 
+  avee-supply:
+    description:
+      Negative panel supply, for panels whose AVDD/AVEE pair is generated by a
+      dual-output regulator. Optional; most panels have no separate negative rail.
+
   backlight: true
   port: true
   reset-gpios: true
