
/*
 * SteamOS ARM: let the SD card run at UHS-I speed (SDR50/SDR104). The base DTS
 * masks both modes here, so cards fell back to plain high speed (~25 MB/s)
 * and loading games from the card took about 3x as long as on the prebuilt
 * 7.0.14 kernel, which ran the same cards at SDR104.
 */
&sdhc_2 {
	/delete-property/ sdhci-caps-mask;
};

/*
 * s2idle: the Wi-Fi WAKE# line is active low, read as active
 * high it can wake the SoC straight back up; the gamepad MCU gets its own
 * switchable 3.3 V rail so rsinput can power it down for the sleep; the
 * codec keeps these rails enabled through s2idle, idle them in LPM.
 */
&pcieport0 {
	wake-gpios = <&tlmm 96 GPIO_ACTIVE_LOW>;
};

&vdd_mcu_3v3 {
	/delete-property/ regulator-always-on;
};

&gamepad {
	vdd-supply = <&vdd_mcu_3v3>;
};

&vreg_l15b_1p8 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

&vreg_bob1 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

/*
 * Only the power key wakes the device: volume up pressed in a bag or while
 * holding it woke it out of s2idle and drained the battery overnight.
 */
&{/gpio-keys/key-volume-up} {
	/delete-property/ wakeup-source;
};
