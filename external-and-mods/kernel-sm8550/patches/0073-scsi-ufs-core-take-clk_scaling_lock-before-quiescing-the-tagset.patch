From: Daniil Teterin <theweaklessone@gmail.com>
Subject: [PATCH] scsi: ufs: core: take clk_scaling_lock before quiescing the tagset

Backport of Joonhoe Kim's upstream fix
(https://lkml.iu.edu/2610.2/01240.html). Device management commands take
clk_scaling_lock for reading and are then issued on pseudo_sdev, which
shares the host tagset. ufshcd_clock_scaling_prepare() and
ufshcd_pause_command_processing() quiesced the tagset before taking the
lock for writing, so a query issued by the exception event handler could
sit forever in a quiesced queue while devfreq waited for the lock.
Observed on the Odin 2 Portal (PHISON UFS) during a build: all UFS I/O
stopped, only sysrq-b recovered.

Fixes: 08b12cda6c44 ("scsi: ufs: core: Switch to scsi_get_internal_cmd()")
Fixes: dc5dcac53278 ("scsi: ufs: core: Add helpers to pause and resume command processing")
---
--- a/drivers/ufs/core/ufshcd.c	2026-11-04 03:19:50.881241158 +0100
+++ b/drivers/ufs/core/ufshcd.c	2026-11-04 03:19:50.898083575 +0100
@@ -1358,13 +1358,13 @@
 	int ret = 0;
 
 	mutex_lock(&hba->host->scan_mutex);
-	blk_mq_quiesce_tagset(&hba->host->tag_set);
 	down_write(&hba->clk_scaling_lock);
+	blk_mq_quiesce_tagset(&hba->host->tag_set);
 
 	if (ufshcd_wait_for_pending_cmds(hba, timeout_us)) {
 		ret = -EBUSY;
-		up_write(&hba->clk_scaling_lock);
 		blk_mq_unquiesce_tagset(&hba->host->tag_set);
+		up_write(&hba->clk_scaling_lock);
 		mutex_unlock(&hba->host->scan_mutex);
 	}
 
@@ -1379,8 +1379,8 @@
  */
 void ufshcd_resume_command_processing(struct ufs_hba *hba)
 {
-	up_write(&hba->clk_scaling_lock);
 	blk_mq_unquiesce_tagset(&hba->host->tag_set);
+	up_write(&hba->clk_scaling_lock);
 	mutex_unlock(&hba->host->scan_mutex);
 }
 
@@ -1454,16 +1454,16 @@
 	 * clock scaling is in progress
 	 */
 	mutex_lock(&hba->host->scan_mutex);
-	blk_mq_quiesce_tagset(&hba->host->tag_set);
 	mutex_lock(&hba->wb_mutex);
 	down_write(&hba->clk_scaling_lock);
+	blk_mq_quiesce_tagset(&hba->host->tag_set);
 
 	if (!hba->clk_scaling.is_allowed ||
 	    ufshcd_wait_for_pending_cmds(hba, timeout_us)) {
 		ret = -EBUSY;
+		blk_mq_unquiesce_tagset(&hba->host->tag_set);
 		up_write(&hba->clk_scaling_lock);
 		mutex_unlock(&hba->wb_mutex);
-		blk_mq_unquiesce_tagset(&hba->host->tag_set);
 		mutex_unlock(&hba->host->scan_mutex);
 		goto out;
 	}
@@ -1477,9 +1477,9 @@
 
 static void ufshcd_clock_scaling_unprepare(struct ufs_hba *hba, int err)
 {
+	blk_mq_unquiesce_tagset(&hba->host->tag_set);
 	up_write(&hba->clk_scaling_lock);
 	mutex_unlock(&hba->wb_mutex);
-	blk_mq_unquiesce_tagset(&hba->host->tag_set);
 	mutex_unlock(&hba->host->scan_mutex);
 
 	/* Enable Write Booster if current gear requires it else disable it */
