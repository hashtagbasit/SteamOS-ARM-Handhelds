
/*
 * Zaviya additions for the Retroid Pocket Flip 2 (appended to the base
 * sm8250-retroidpocket-flip2.dts by kernel-common/build.sh).
 *
 * Lid (hall sensor): only opening the lid wakes the device. Closing it is
 * what sends it to sleep, so waking on that edge too woke it right back up.
 * Same as our AYN Thor.
 */
&{/gpio-keys-lid/hall-sensor} {
	wakeup-event-action = <2>; /* EV_ACT_DEASSERTED: lid opened */
};

/*
 * Internal microphone: a WCD938x digital mic (DMIC4, data slot 3, powered
 * from MIC BIAS3) that the base route list never powers. The route list
 * repeats the base entries and adds the two DMIC4 lines; the UCM profile
 * (Retroid/Pocket865/HiFi.conf) selects the capture path on this model only.
 */
&sound {
	widgets =
		"Microphone", "Internal Mic";
	audio-routing =
		"SpkrLeft IN", "WSA_SPK1 OUT",
		"SpkrRight IN", "WSA_SPK2 OUT",
		"IN1_HPHL", "HPHL_OUT",
		"IN2_HPHR", "HPHR_OUT",
		"AMIC1", "MIC BIAS1",
		"AMIC2", "MIC BIAS2",
		"AMIC3", "MIC BIAS3",
		"AMIC4", "MIC BIAS3",
		"AMIC5", "MIC BIAS4",
		"DMIC4", "Internal Mic",
		"DMIC4", "MIC BIAS3",
		"TX SWR_ADC0", "ADC1_OUTPUT",
		"TX SWR_ADC1", "ADC2_OUTPUT",
		"TX SWR_ADC2", "ADC3_OUTPUT",
		"TX SWR_ADC3", "ADC4_OUTPUT",
		"TX SWR_DMIC0", "DMIC1_OUTPUT",
		"TX SWR_DMIC1", "DMIC2_OUTPUT",
		"TX SWR_DMIC2", "DMIC3_OUTPUT",
		"TX SWR_DMIC3", "DMIC4_OUTPUT",
		"TX SWR_DMIC4", "DMIC5_OUTPUT",
		"TX SWR_DMIC5", "DMIC6_OUTPUT",
		"TX SWR_DMIC6", "DMIC7_OUTPUT",
		"TX SWR_DMIC7", "DMIC8_OUTPUT";
};
