From: hashtagbasit <53941105+hashtagbasit@users.noreply.github.com>
Subject: [PATCH] drm/panel: add the AYANEO AR18 panel (Pocket MICRO 2)

The AYANEO Pocket MICRO 2 has a 640x960 Sitronix ST7123 video-mode DSI
panel (AR18) on four lanes. Register setup and timings from the panel node
of the stock Android device tree; the setup is kept in a table and sent in
low-power mode before sleep-out.

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index a242de5..18c1479 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -45,6 +45,15 @@ config DRM_PANEL_AUO_A030JTN01
 	  Say Y here to enable support for the AUO A030JTN01 320x480 3.0" panel
 	  as found in the YLM RS-97 handheld gaming console.
 
+config DRM_PANEL_AYANEO_AR18
+	tristate "AYANEO AR18 640x960 DSI panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  The 640x960 Sitronix ST7123 video-mode panel of the AYANEO Pocket
+	  MICRO 2. To build it as a module, choose M: panel-ayaneo-ar18.
+
 config DRM_PANEL_BOE_BF060Y8M_AJ0
 	tristate "Boe BF060Y8M-AJ0 panel"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 5b905de..970eda8 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -3,6 +3,7 @@ obj-$(CONFIG_DRM_PANEL_ABT_Y030XX067A) += panel-abt-y030xx067a.o
 obj-$(CONFIG_DRM_PANEL_ARM_VERSATILE) += panel-arm-versatile.o
 obj-$(CONFIG_DRM_PANEL_ASUS_Z00T_TM5P5_NT35596) += panel-asus-z00t-tm5p5-n35596.o
 obj-$(CONFIG_DRM_PANEL_AUO_A030JTN01) += panel-auo-a030jtn01.o
+obj-$(CONFIG_DRM_PANEL_AYANEO_AR18) += panel-ayaneo-ar18.o
 obj-$(CONFIG_DRM_PANEL_BOE_BF060Y8M_AJ0) += panel-boe-bf060y8m-aj0.o
 obj-$(CONFIG_DRM_PANEL_BOE_HIMAX8279D) += panel-boe-himax8279d.o
 obj-$(CONFIG_DRM_PANEL_BOE_TD4320) += panel-boe-td4320.o
diff --git a/drivers/gpu/drm/panel/panel-ayaneo-ar18.c b/drivers/gpu/drm/panel/panel-ayaneo-ar18.c
new file mode 100644
index 0000000..bdb80c0
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-ayaneo-ar18.c
@@ -0,0 +1,308 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * AYANEO AR18: the 640x960 Sitronix ST7123 video-mode DSI panel of the
+ * AYANEO Pocket MICRO 2. The register setup comes from the panel node of the
+ * stock Android device tree.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_of.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct ar18_seq {
+	const u8 *data;
+	size_t len;
+};
+
+#define AR18_SEQ(...) {						\
+	.data = (const u8[]){ __VA_ARGS__ },				\
+	.len = sizeof((const u8[]){ __VA_ARGS__ }),			\
+}
+
+/*
+ * Vendor register setup, sent in low-power mode before sleep-out. The 0x60
+ * writes switch between the ST7123's command pages; the last one goes back
+ * to the standard page.
+ */
+static const struct ar18_seq ar18_init[] = {
+	AR18_SEQ(0x60, 0x71, 0x23, 0xA2),
+	AR18_SEQ(0x60, 0x71, 0x23, 0xA3),
+	AR18_SEQ(0x60, 0x71, 0x23, 0xA4),
+	AR18_SEQ(0xB7, 0x00, 0x00, 0x64, 0x64),
+	AR18_SEQ(0xB0, 0x22, 0x61, 0x11, 0x7F, 0x25, 0x39, 0x39),
+	AR18_SEQ(0xBF, 0x99, 0x99),
+	AR18_SEQ(0xA4, 0x33),
+	AR18_SEQ(0xD7, 0x00, 0x2C, 0xD2, 0x19, 0xE0, 0xE0, 0xE0, 0x80, 0x00, 0x50),
+	AR18_SEQ(0x90, 0x71, 0x23, 0x5A, 0x20, 0x24, 0x10, 0x24),
+	AR18_SEQ(0xA3, 0x80, 0x01, 0x80, 0x7F, 0x05, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46,
+		   0x00, 0x00, 0x1E, 0x5C, 0x1E, 0x80, 0x10, 0x00, 0x05, 0x00, 0x00, 0x00,
+		   0x00, 0x00, 0x46, 0x00, 0x00, 0x1E, 0x5C, 0x1E, 0x80, 0x10, 0x20, 0x58,
+		   0x00, 0x00, 0x00, 0xFF),
+	AR18_SEQ(0xA6, 0x0C, 0x00, 0x24, 0x55, 0x36, 0x00, 0x39, 0x00, 0x9F, 0x9F, 0x91,
+		   0xFF, 0x00, 0x24, 0x55, 0x37, 0x00, 0x38, 0x00, 0x9F, 0x9F, 0x91, 0xFF,
+		   0x00, 0xE4, 0x55, 0x00, 0x03, 0x00, 0x04, 0x9F, 0x9F, 0x91, 0xFF, 0x00,
+		   0x2C, 0x11, 0x00, 0x00, 0x00, 0x00, 0x9F, 0x9F, 0xFF, 0xFF, 0x00, 0x08,
+		   0x80, 0x08, 0x80, 0x06, 0x00, 0x00, 0x00, 0x00),
+	AR18_SEQ(0xA7, 0x18, 0x18, 0x80, 0x64, 0x40, 0x07, 0x16, 0x40, 0x00, 0x44, 0x03,
+		   0x9F, 0x9F, 0x91, 0xFF, 0x08, 0x80, 0x64, 0x40, 0x25, 0x34, 0x40, 0x00,
+		   0x02, 0x01, 0x9F, 0x9F, 0x91, 0xFF, 0x08, 0x80, 0x64, 0x40, 0x00, 0x00,
+		   0x40, 0x00, 0x00, 0x00, 0x9F, 0x9F, 0x91, 0xFF, 0x08, 0x80, 0x64, 0x40,
+		   0x00, 0x00, 0x00, 0x00, 0x20, 0x00, 0x9F, 0x9F, 0x84, 0xFF, 0x08, 0x80,
+		   0x53),
+	AR18_SEQ(0xAC, 0x1D, 0x1D, 0x1C, 0x10, 0x12, 0x0B, 0x09, 0x07, 0x07, 0x02, 0x18,
+		   0x19, 0x01, 0x1C, 0x1D, 0x05, 0x1D, 0x1D, 0x1D, 0x1D, 0x1D, 0x1D, 0x1D,
+		   0x1D, 0x1C, 0x11, 0x13, 0x0A, 0x08, 0x07, 0x07, 0x00, 0x18, 0x19, 0x03,
+		   0x1C, 0x1D, 0x04, 0x1D, 0x1D, 0x1D, 0x1D, 0x1D, 0x1D),
+	AR18_SEQ(0xAD, 0xF0, 0x00, 0x06, 0x00, 0x09, 0x50, 0x50, 0xFF, 0xFF, 0xF0, 0x40,
+		   0x06, 0x01, 0x07, 0x42, 0x42, 0xFF, 0xFF, 0x01, 0x00, 0x00, 0xFF, 0xFF,
+		   0xFF, 0xFF),
+	AR18_SEQ(0xAE, 0x78, 0xFE, 0x00, 0xF8, 0xFF, 0x00, 0x00),
+	AR18_SEQ(0xB2, 0x15, 0x19, 0x05, 0x23, 0x49, 0xB9, 0x03, 0x2E, 0x5C, 0xD2, 0xFF,
+		   0x10, 0x20, 0xFD, 0x20, 0xC0, 0x00),
+	AR18_SEQ(0xE8, 0x20, 0x6F, 0x04, 0xC8, 0xC8, 0x3E, 0x04, 0xDC, 0xDC, 0x3E, 0x06,
+		   0xFA, 0x26, 0x3E),
+	AR18_SEQ(0x75, 0x03, 0x04),
+	AR18_SEQ(0xE7, 0x3B, 0x00, 0x00, 0x7C, 0x4B, 0x8C, 0x20, 0x1A, 0xF0, 0x84, 0x00,
+		   0x84, 0x00, 0x84, 0x00, 0x84, 0x00, 0xFF, 0x00, 0x0A, 0x00, 0xFF, 0xFF,
+		   0x00, 0xCB, 0x6A, 0xFF, 0x5A, 0x0A, 0x18, 0x88, 0x15, 0xB1, 0x01, 0x01,
+		   0x77, 0x01, 0x01, 0x7C, 0xFF, 0x0A, 0x01, 0x2F, 0x59, 0x22, 0x33, 0x2F,
+		   0xCF),
+	AR18_SEQ(0xE0, 0x38, 0x64, 0x80, 0x80),
+	AR18_SEQ(0xEA, 0x13, 0x00, 0x04, 0x00, 0x00, 0x00, 0x00, 0x2C),
+	AR18_SEQ(0xE1, 0x0D, 0x0D),
+	AR18_SEQ(0xC8, 0x00, 0x00, 0x0E, 0x1A, 0x30, 0x00, 0x59, 0x02, 0x96, 0x05, 0x10,
+		   0xED, 0x07, 0x65, 0x03, 0x21, 0xBA, 0x03, 0x03, 0x00, 0x22, 0x43, 0x0F,
+		   0x85, 0x0A, 0x32, 0xE3, 0x0A, 0x3A, 0x0C, 0xF3, 0x86, 0x0D, 0xC2, 0xEC,
+		   0x03, 0xFF),
+	AR18_SEQ(0xC9, 0x00, 0x00, 0x0E, 0x1A, 0x30, 0x00, 0x59, 0x02, 0x96, 0x05, 0x10,
+		   0xED, 0x07, 0x65, 0x03, 0x21, 0xBA, 0x03, 0x03, 0x00, 0x22, 0x43, 0x0F,
+		   0x85, 0x0A, 0x32, 0xE3, 0x0A, 0x3A, 0x0C, 0xF3, 0x86, 0x0D, 0xC2, 0xEC,
+		   0x03, 0xFF),
+	AR18_SEQ(0x60, 0x71, 0x23, 0x00),
+};
+
+struct ar18_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset;
+	struct regulator *vddio;	/* 1.8 V logic */
+	struct regulator *lab;		/* LCDB bias, after the logic rail */
+	enum drm_panel_orientation orientation;
+};
+
+static struct ar18_panel *panel_to_ar18(struct drm_panel *panel)
+{
+	return container_of(panel, struct ar18_panel, panel);
+}
+
+static int ar18_power_on(struct ar18_panel *p)
+{
+	int ret;
+
+	ret = regulator_enable(p->vddio);
+	if (ret)
+		return ret;
+	usleep_range(5000, 6000);
+
+	ret = regulator_enable(p->lab);
+	if (ret) {
+		regulator_disable(p->vddio);
+		return ret;
+	}
+	msleep(20);
+
+	/* reset pulse: high (asserted) 50 ms, then 150 ms to come out of it */
+	gpiod_set_value_cansleep(p->reset, 0);
+	msleep(10);
+	gpiod_set_value_cansleep(p->reset, 1);
+	msleep(50);
+	gpiod_set_value_cansleep(p->reset, 0);
+	msleep(150);
+	return 0;
+}
+
+static void ar18_power_off(struct ar18_panel *p)
+{
+	gpiod_set_value_cansleep(p->reset, 1);
+	regulator_disable(p->lab);
+	usleep_range(5000, 6000);
+	regulator_disable(p->vddio);
+}
+
+static int ar18_send_init(struct ar18_panel *p)
+{
+	struct mipi_dsi_multi_context ctx = { .dsi = p->dsi };
+	size_t i;
+
+	p->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	for (i = 0; i < ARRAY_SIZE(ar18_init); i++)
+		mipi_dsi_dcs_write_buffer_multi(&ctx, ar18_init[i].data,
+						ar18_init[i].len);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&ctx);
+	mipi_dsi_msleep(&ctx, 120);
+	mipi_dsi_dcs_set_display_on_multi(&ctx);
+	mipi_dsi_dcs_set_tear_on_multi(&ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	mipi_dsi_msleep(&ctx, 20);
+
+	return ctx.accum_err;
+}
+
+static int ar18_prepare(struct drm_panel *panel)
+{
+	struct ar18_panel *p = panel_to_ar18(panel);
+	int ret;
+
+	ret = ar18_power_on(p);
+	if (ret)
+		return ret;
+
+	ret = ar18_send_init(p);
+	if (ret) {
+		dev_err(panel->dev, "panel init failed: %d\n", ret);
+		ar18_power_off(p);
+	}
+	return ret;
+}
+
+static int ar18_unprepare(struct drm_panel *panel)
+{
+	struct ar18_panel *p = panel_to_ar18(panel);
+	struct mipi_dsi_multi_context ctx = { .dsi = p->dsi };
+
+	p->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	mipi_dsi_dcs_set_display_off_multi(&ctx);
+	mipi_dsi_msleep(&ctx, 60);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&ctx);
+	mipi_dsi_msleep(&ctx, 120);
+	if (ctx.accum_err)
+		dev_err(panel->dev, "panel off failed: %d\n", ctx.accum_err);
+
+	ar18_power_off(p);
+	return 0;
+}
+
+/* 60 Hz; long vertical front porch as in the vendor timings. */
+#define AR18_HFP	40
+#define AR18_HSYNC	4
+#define AR18_HBP	40
+#define AR18_VFP	280
+#define AR18_VSYNC	4
+#define AR18_VBP	40
+
+static const struct drm_display_mode ar18_mode = {
+	.hdisplay = 640,
+	.hsync_start = 640 + AR18_HFP,
+	.hsync_end = 640 + AR18_HFP + AR18_HSYNC,
+	.htotal = 640 + AR18_HFP + AR18_HSYNC + AR18_HBP,
+	.vdisplay = 960,
+	.vsync_start = 960 + AR18_VFP,
+	.vsync_end = 960 + AR18_VFP + AR18_VSYNC,
+	.vtotal = 960 + AR18_VFP + AR18_VSYNC + AR18_VBP,
+	.clock = (640 + AR18_HFP + AR18_HSYNC + AR18_HBP) *
+		 (960 + AR18_VFP + AR18_VSYNC + AR18_VBP) * 60 / 1000,
+	.width_mm = 50,
+	.height_mm = 75,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int ar18_get_modes(struct drm_panel *panel,
+			  struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &ar18_mode);
+}
+
+static enum drm_panel_orientation ar18_get_orientation(struct drm_panel *panel)
+{
+	return panel_to_ar18(panel)->orientation;
+}
+
+static const struct drm_panel_funcs ar18_funcs = {
+	.prepare = ar18_prepare,
+	.unprepare = ar18_unprepare,
+	.get_modes = ar18_get_modes,
+	.get_orientation = ar18_get_orientation,
+};
+
+static int ar18_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct ar18_panel *p;
+	int ret;
+
+	p = devm_drm_panel_alloc(dev, struct ar18_panel, panel, &ar18_funcs,
+				 DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(p))
+		return PTR_ERR(p);
+
+	p->vddio = devm_regulator_get(dev, "vddio");
+	if (IS_ERR(p->vddio))
+		return dev_err_probe(dev, PTR_ERR(p->vddio), "no vddio supply\n");
+	p->lab = devm_regulator_get(dev, "lab");
+	if (IS_ERR(p->lab))
+		return dev_err_probe(dev, PTR_ERR(p->lab), "no lab supply\n");
+
+	p->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(p->reset))
+		return dev_err_probe(dev, PTR_ERR(p->reset), "no reset GPIO\n");
+
+	ret = drm_of_get_panel_orientation(dev->of_node, &p->orientation);
+	if (ret && ret != -ENODEV)
+		return dev_err_probe(dev, ret, "bad rotation property\n");
+
+	p->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, p);
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+	/* the DSI host has to be up before the init sequence goes out */
+	p->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&p->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "no backlight\n");
+
+	drm_panel_add(&p->panel);
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&p->panel);
+		return dev_err_probe(dev, ret, "DSI attach failed\n");
+	}
+	return 0;
+}
+
+static void ar18_remove(struct mipi_dsi_device *dsi)
+{
+	struct ar18_panel *p = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&p->panel);
+}
+
+static const struct of_device_id ar18_of_match[] = {
+	{ .compatible = "ayaneo,ar18-panel" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ar18_of_match);
+
+static struct mipi_dsi_driver ar18_driver = {
+	.probe = ar18_probe,
+	.remove = ar18_remove,
+	.driver = {
+		.name = "panel-ayaneo-ar18",
+		.of_match_table = ar18_of_match,
+	},
+};
+module_mipi_dsi_driver(ar18_driver);
+
+MODULE_DESCRIPTION("AYANEO AR18 (Pocket MICRO 2) DSI panel");
+MODULE_LICENSE("GPL");
