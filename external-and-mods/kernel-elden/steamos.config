# Lenovo Legion Y700 Gen 4 (elden) drivers on top of the SM8750 config.
CONFIG_BUILTIN_DTB=y
CONFIG_BUILTIN_DTB_NAME="qcom/sm8750-lenovo-elden"
# The panel is needed before the rootfs (boot splash, Steam's first frame).
CONFIG_DRM_PANEL_NOVATEK_NT36536=y
CONFIG_TOUCHSCREEN_NOVATEK_NVT36XXX_SPI=m
CONFIG_SND_SOC_AW88461=m
CONFIG_INPUT_AW86927=m
CONFIG_PHY_NXP_PTN3222=y
CONFIG_PM8916_WATCHDOG=m
# tablet-firmware reads the stock vendor/odm out of Android's super partition
# (EROFS, possibly in several extents) to copy the tablet's own firmware.
CONFIG_BLK_DEV_DM=m
CONFIG_EROFS_FS_ZIP_LZMA=y
# The USB path is built in: the initramfs has no modules, and the image on a
# USB drive (the installer) has to be found before the root is mounted.
CONFIG_USB_UAS=y
# Boot text (CMDLINE_QUIET=0) in a font that's readable on the 3K panel.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# PMIC power-on trigger (/sys/kernel/qcom_pon/) has to be there before
# userspace starts, and zram-generator asks for the zstd backend.
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
