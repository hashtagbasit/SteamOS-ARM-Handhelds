+static int sc8280xp_tdm_snd_hw_params(struct snd_pcm_substream *substream,
+				      struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	int channels, ret, slot_width;
+
+	switch (params_format(params)) {
+	case SNDRV_PCM_FORMAT_S16_LE:
+		slot_width = 16;
+		break;
+	case SNDRV_PCM_FORMAT_S24_LE:
+	case SNDRV_PCM_FORMAT_S32_LE:
+		slot_width = 32;
+		break;
+	default:
+		dev_err(rtd->dev, "%s: invalid param format 0x%x\n",
+			__func__, params_format(params));
+		return -EINVAL;
+	}
+
+	channels = params_channels(params);
+	if (cpu_dai->id == SECONDARY_MI2S_RX) {
+		ret = snd_soc_dai_set_tdm_slot(cpu_dai, 0, 0x3,
+					       NUM_TDM_SLOTS, 32);
+		if (ret < 0)
+			return ret;
+
+		return snd_soc_dai_set_channel_map(cpu_dai, 0, NULL,
+						   NUM_TDM_SLOTS,
+						   tdm_slot_offset);
+	}
+
+	if (cpu_dai->id == SECONDARY_TDM_RX_0)
+		slot_width = 32;
+
+	ret = snd_soc_dai_set_tdm_slot(cpu_dai, 0, 0x3,
+				       NUM_TDM_SLOTS, slot_width);
+	if (ret < 0)
+		return ret;
+
+	return snd_soc_dai_set_channel_map(cpu_dai, 0, NULL,
+					   channels, tdm_slot_offset);
+}
+
+static int sc8280xp_snd_hw_params(struct snd_pcm_substream *substream,
+				  struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
+	switch (cpu_dai->id) {
+	case SECONDARY_MI2S_RX:
+	case SECONDARY_TDM_RX_0:
+		return sc8280xp_tdm_snd_hw_params(substream, params);
+	default:
+		return 0;
+	}
+}
+
+static int sc8280xp_tdm_snd_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai;
+	int ret, i;
+
+	switch (cpu_dai->id) {
+	case SECONDARY_MI2S_RX:
+	case SECONDARY_TDM_RX_0:
+		ret = snd_soc_dai_set_fmt(cpu_dai, SND_SOC_DAIFMT_BP_FP);
+		if (ret < 0)
+			return ret;
+
+		ret = snd_soc_dai_set_sysclk(cpu_dai,
+					     Q6AFE_LPASS_CLK_ID_SEC_TDM_IBIT,
+					     TDM_BCLK_RATE,
+					     SNDRV_PCM_STREAM_PLAYBACK);
+		if (ret < 0 && ret != -ENOTSUPP)
+			return ret;
+
+		for_each_rtd_codec_dais(rtd, i, codec_dai) {
+			ret = snd_soc_dai_set_fmt(codec_dai,
+						  SND_SOC_DAIFMT_BC_FC |
+						  SND_SOC_DAIFMT_IB_NF |
+						  SND_SOC_DAIFMT_DSP_B);
+			if (ret < 0 && ret != -ENOTSUPP)
+				return ret;
+
+			ret = snd_soc_dai_set_sysclk(codec_dai, 0,
+						     TDM_BCLK_RATE,
+						     SNDRV_PCM_STREAM_PLAYBACK);
+			if (ret < 0 && ret != -ENOTSUPP)
+				return ret;
+
+			ret = snd_soc_dai_set_tdm_slot(codec_dai, 0,
+						       BIT(i),
+						       NUM_TDM_SLOTS, 32);
+			if (ret < 0 && ret != -ENOTSUPP)
+				return ret;
+		}
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
