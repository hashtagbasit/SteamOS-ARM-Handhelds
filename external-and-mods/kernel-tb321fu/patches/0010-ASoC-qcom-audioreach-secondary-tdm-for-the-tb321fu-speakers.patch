+	clk_cfg->cfg.clock_id = clock_id;
+	clk_cfg->cfg.clock_freq = clock_freq;
+	clk_cfg->cfg.clock_attri = CLOCK_ATTRIBUTE_COUPLE_NO;
+	clk_cfg->cfg.clock_root = CLOCK_ROOT_DEFAULT;
 
 	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
