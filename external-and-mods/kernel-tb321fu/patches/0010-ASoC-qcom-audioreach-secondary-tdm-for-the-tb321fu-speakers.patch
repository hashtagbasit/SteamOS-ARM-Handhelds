+static int sc8280xp_be_startup(struct snd_pcm_substream *substream)
+{
+	int ret;
+
+	ret = sc8280xp_tdm_snd_startup(substream);
+	if (ret)
+		return ret;
+
+	return qcom_snd_sdw_startup(substream);
+}
