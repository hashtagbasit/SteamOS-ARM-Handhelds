+				  module->hw_interface_idx == I2S_INTF_TYPE_SECONDARY &&
+				  cfg->frame_size_factor == 8;
+	u32 nslots = y700_secondary_tdm ? 8 :
+		     (cfg->num_channels ?: module->frame_size_factor ?: 8);
+	u32 bit_width = y700_secondary_tdm ? 32 : (cfg->bit_width ?: 32);
+	u32 clock_freq = cfg->sample_rate * nslots * bit_width;
+	u32 clock_id = CLOCK_ID_PRI_TDM_IBIT + 2 * module->hw_interface_idx;
+	int clk_sz = APM_HW_INTF_CLK_CFG_PSIZE;
+	void *p;
+
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_apm_cmd_pkt(clk_sz, APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
