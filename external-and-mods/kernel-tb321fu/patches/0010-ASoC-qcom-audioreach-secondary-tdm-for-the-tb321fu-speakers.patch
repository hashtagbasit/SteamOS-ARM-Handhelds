+static int audioreach_tdm_set_media_format(struct q6apm_graph *graph,
+					   const struct audioreach_module *module,
+					   const struct audioreach_module_config *cfg)
+{
+	bool y700_secondary_tdm = module->hw_interface_type == TDM_LPAIF_TYPE_LPAIF &&
+				  module->hw_interface_idx == TDM_INTF_TYPE_SECONDARY &&
+				  cfg->frame_size_factor == 8;
+	int ret;
+
+	ret = audioreach_tdm_send_hw_ep_mf(graph, module, cfg);
+	if (ret)
+		return ret;
+
+	ret = audioreach_tdm_send_intf(graph, module, cfg);
+	if (ret)
+		return ret;
+
+	if (y700_secondary_tdm)
+		return 0;
+
+	ret = audioreach_tdm_send_lane(graph, module, cfg);
+	if (ret)
+		return ret;
+
+	return audioreach_tdm_send_clk(graph, module, cfg);
+}
