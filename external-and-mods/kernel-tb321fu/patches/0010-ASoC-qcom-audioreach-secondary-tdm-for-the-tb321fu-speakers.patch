+static int audioreach_tdm_send_clk(struct q6apm_graph *graph,
+				   const struct audioreach_module *module,
+				   const struct audioreach_module_config *cfg)
+{
+	struct apm_module_hw_intf_clk_cfg *clk_cfg;
