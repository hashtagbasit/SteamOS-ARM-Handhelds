From: guf296 <guf296@126.com>
Subject: [PATCH] power: supply: qcom_battmgr: fix CURRENT_NOW sign on Lenovo TB321FU/SM8650

The TB321FU's pmic-glink firmware reports BATT_CURR_NOW negative while
charging and positive while discharging.

Taken from https://github.com/GUF296/linux branch TB321FU-7.1.1
(5df8e852e), the Lenovo Legion Tab Gen 3 / Y700 2025 (TB321FU) bring-up.

Rebased onto 7.2.8 for Zaviya: the battery descriptor choice moved
in the probe.

---
  drivers/power/supply/qcom_battmgr.c | 10 ++++++++--
  1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index a9ae3a8..63602b3 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -24,6 +24,7 @@ enum qcom_battmgr_variant {
 	QCOM_BATTMGR_SC8280XP,
 	QCOM_BATTMGR_SM8350,
 	QCOM_BATTMGR_SM8550,
+	QCOM_BATTMGR_SM8650,
 	QCOM_BATTMGR_X1E80100,
 };
 
@@ -1529,7 +1530,10 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 			battmgr->info.voltage_max = le32_to_cpu(resp->intval.value);
 			break;
 		case BATT_CURR_NOW:
-			battmgr->status.current_now = le32_to_cpu(resp->intval.value);
+			if (battmgr->variant == QCOM_BATTMGR_SM8650)
+				battmgr->status.current_now = -le32_to_cpu(resp->intval.value);
+			else
+				battmgr->status.current_now = le32_to_cpu(resp->intval.value);
 			break;
 		case BATT_TEMP:
 			val = le32_to_cpu(resp->intval.value);
@@ -1736,6 +1740,7 @@ static const struct of_device_id qcom_battmgr_of_variants[] = {
 	{ .compatible = "qcom,kaanapali-pmic-glink", .data = (void *)QCOM_BATTMGR_SM8550 },
 	{ .compatible = "qcom,sc8180x-pmic-glink", .data = (void *)QCOM_BATTMGR_SC8280XP },
 	{ .compatible = "qcom,sc8280xp-pmic-glink", .data = (void *)QCOM_BATTMGR_SC8280XP },
+	{ .compatible = "qcom,sm8650-pmic-glink", .data = (void *)QCOM_BATTMGR_SM8650 },
 	{ .compatible = "qcom,sm8550-pmic-glink", .data = (void *)QCOM_BATTMGR_SM8550 },
 	{ .compatible = "qcom,x1e80100-pmic-glink", .data = (void *)QCOM_BATTMGR_X1E80100 },
 	/* Unmatched devices falls back to QCOM_BATTMGR_SM8350 */
@@ -1813,7 +1818,8 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 		/* no BATTMGR_BAT_INFO from this firmware: it reports mAh */
 		battmgr->unit = QCOM_BATTMGR_UNIT_mAh;
 
-		if (battmgr->variant == QCOM_BATTMGR_SM8550)
+		if (battmgr->variant == QCOM_BATTMGR_SM8550 ||
+		    battmgr->variant == QCOM_BATTMGR_SM8650)
 			psy_desc = &sm8550_bat_psy_desc;
 		else
 			psy_desc = &sm8350_bat_psy_desc;
