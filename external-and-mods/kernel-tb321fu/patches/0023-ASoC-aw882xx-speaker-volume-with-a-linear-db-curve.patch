From: enij90 <226572015+enij90@users.noreply.github.com>
Subject: [PATCH] ASoC: aw882xx: speaker volume with a linear dB curve

Add one "Speaker Playback Volume" control (0..100) that drives all the
amplifiers, enabled by the awinic,linear-volume-range-cdb property. Its TLV
reports each step at the cubic dB curve PipeWire uses, so PipeWire picks the
step that matches its slider, while the amplifiers attenuate linearly in dB
over the given range. The low half of the slider stays audible on small
speakers.

Taken from https://github.com/enij90/armada-tb321fu (Lenovo Legion Tab Gen 3 / Y700 2025,
TB321FU, SM8650).
---
--- a/sound/soc/codecs/aw882xx/aw882xx.c
+++ b/sound/soc/codecs/aw882xx/aw882xx.c
@@ -29,6 +29,7 @@
 #include <linux/workqueue.h>
 #include <linux/syscalls.h>
 #include <sound/control.h>
+#include <sound/tlv.h>
 #include <linux/uaccess.h>
 #include <linux/vmalloc.h>
 
@@ -1583,6 +1584,104 @@
 		aw882xx_get_spin, aw882xx_set_spin),
 };
 
+/*
+ * "Speaker Playback Volume": one 0..100 control for all the amplifiers, for a
+ * userspace mixer (PipeWire through UCM PlaybackMixerElem).
+ *
+ * PipeWire turns its volume into dB along a cubic curve (60 * log10(v)), so a
+ * slider spends most of its low half below -30 dB, which small speakers barely
+ * render. The TLV below reports step i at that cubic dB, so PipeWire picks the
+ * step matching its slider position, while the amplifiers attenuate linearly
+ * in dB: step i = -range * (100 - i) / 100. "awinic,linear-volume-range-cdb"
+ * (centi-dB) on the first amplifier enables it.
+ *
+ * alsa-lib takes at most 256 bytes of dB range, so the cubic curve is nine
+ * linear pieces (within 0.53 dB) plus mute at step 0.
+ */
+#define AW_SPK_VOL_STEPS	100
+/* 0.0940625 dB per register step, in 1e-5 dB */
+#define AW_SPK_VOL_REG_STEP	9406
+
+static const DECLARE_TLV_DB_RANGE(aw882xx_spk_tlv,
+	0, 0, TLV_DB_SCALE_ITEM(-12000, 0, 1),
+	1, 2, TLV_DB_SCALE_ITEM(-12000, 1806, 0),
+	3, 4, TLV_DB_SCALE_ITEM(-9137, 749, 0),
+	5, 7, TLV_DB_SCALE_ITEM(-7806, 438, 0),
+	8, 12, TLV_DB_SCALE_ITEM(-6581, 264, 0),
+	13, 19, TLV_DB_SCALE_ITEM(-5316, 165, 0),
+	20, 29, TLV_DB_SCALE_ITEM(-4194, 108, 0),
+	30, 44, TLV_DB_SCALE_ITEM(-3137, 71, 0),
+	45, 66, TLV_DB_SCALE_ITEM(-2081, 48, 0),
+	67, 100, TLV_DB_SCALE_ITEM(-1044, 32, 0),
+);
+static unsigned int aw882xx_spk_range_cdb;
+static unsigned int aw882xx_spk_step = AW_SPK_VOL_STEPS;
+
+static unsigned int aw882xx_spk_step_to_reg(struct aw_volume_desc *vol_desc,
+					    unsigned int step)
+{
+	unsigned int cdb;
+
+	if (step == 0)
+		return vol_desc->mute_volume;
+	cdb = aw882xx_spk_range_cdb * (AW_SPK_VOL_STEPS - step) / AW_SPK_VOL_STEPS;
+	return min_t(unsigned int, DIV_ROUND_CLOSEST(cdb * 1000, AW_SPK_VOL_REG_STEP),
+		     vol_desc->mute_volume);
+}
+
+static int aw882xx_spk_volume_info(struct snd_kcontrol *kcontrol,
+				   struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = AW_SPK_VOL_STEPS;
+	return 0;
+}
+
+static int aw882xx_spk_volume_get(struct snd_kcontrol *kcontrol,
+				  struct snd_ctl_elem_value *ucontrol)
+{
+	ucontrol->value.integer.value[0] = aw882xx_spk_step;
+	return 0;
+}
+
+static int aw882xx_spk_volume_put(struct snd_kcontrol *kcontrol,
+				  struct snd_ctl_elem_value *ucontrol)
+{
+	long step = ucontrol->value.integer.value[0];
+	struct list_head *dev_list = NULL;
+	struct list_head *pos;
+
+	if (step < 0 || step > AW_SPK_VOL_STEPS)
+		return -EINVAL;
+	if (step == aw882xx_spk_step)
+		return 0;
+	if (aw882xx_dev_get_list_head(&dev_list))
+		return -ENODEV;
+
+	aw882xx_spk_step = step;
+	list_for_each(pos, dev_list) {
+		struct aw_device *aw_dev = container_of(pos, struct aw_device, list_node);
+		struct aw_volume_desc *vol_desc = &aw_dev->volume_desc;
+
+		vol_desc->ctl_volume = aw882xx_spk_step_to_reg(vol_desc, step);
+		aw882xx_dev_set_volume(aw_dev, AW_GET_MAX_VALUE(vol_desc->ctl_volume,
+								vol_desc->monitor_volume));
+	}
+	return 1;
+}
+
+static const struct snd_kcontrol_new aw882xx_spk_volume_control = {
+	.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+	.name = "Speaker Playback Volume",
+	.access = SNDRV_CTL_ELEM_ACCESS_READWRITE | SNDRV_CTL_ELEM_ACCESS_TLV_READ,
+	.info = aw882xx_spk_volume_info,
+	.get = aw882xx_spk_volume_get,
+	.put = aw882xx_spk_volume_put,
+	.tlv.p = aw882xx_spk_tlv,
+};
+
 static void aw882xx_add_codec_controls(struct aw882xx *aw882xx)
 {
 	struct snd_kcontrol_new *aw882xx_dev_control = NULL;
@@ -1616,6 +1715,14 @@
 	if (aw882xx->aw_pa->spin_desc.aw_spin_kcontrol_st == AW_SPIN_KCONTROL_ENABLE)
 		aw_componet_codec_ops.add_codec_controls(aw882xx->codec,
 				aw882xx_spin_control, ARRAY_SIZE(aw882xx_spin_control));
+
+	if (!of_property_read_u32(aw882xx->dev->of_node, "awinic,linear-volume-range-cdb",
+				  &aw882xx_spk_range_cdb) && aw882xx_spk_range_cdb) {
+		aw_componet_codec_ops.add_codec_controls(aw882xx->codec,
+				&aw882xx_spk_volume_control, 1);
+		aw_dev_info(aw882xx->dev, "Speaker Playback Volume: linear over %u.%02u dB",
+			    aw882xx_spk_range_cdb / 100, aw882xx_spk_range_cdb % 100);
+	}
 }
 
 static int aw882xx_append_i2c_suffix(char *format,
