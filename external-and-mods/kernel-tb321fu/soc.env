# Lenovo Legion Y700 Gen 3, TB321FU (SM8650).
# Sourced by kernel-common/build.sh and kernel-common/cmdline.sh.
#
# The 8 Gen 3 kernel (the base 7.2 recipe on Linux 7.2.8 plus all of
# kernel-sm8650's patches), built separately with the tablet's drivers on
# top so nothing here reaches the Pocket FIT or Pocket S2: GUF296's TB321FU
# bring-up (github.com/GUF296/linux, TB321FU-7.1.1) and the 7.2 ports of its
# panel and speaker parts.
# The tablet boots from Lenovo's own ABL, not the ROCKNIX ABL, so the image
# build takes Image and the DTB from the output rather than KERNEL.

# The tablet stays on the 7.2.8 recipe (kernel-sm8650/patches); the chip's
# default moved to 7.4-rc1 (kernel-sm8650-74).
SM8650_RECIPE=7.2
source "$(dirname "${BASH_SOURCE[0]}")/../kernel-sm8650/soc.env"

KNAME=tb321fu
PORT_DIRS="kernel-sm8650 kernel-tb321fu"
# The 8 Gen 3 handhelds' dwc3 sleep role fix overlaps this tablet's own
# dwc3-qcom changes (0012 here).
# UFS MCQ (0068) is only tested on the Pocket FIT so far.
# The PCIe sleep floor (0047) is not used here: 0018 lets the PCIe GDSCs power
# off in s2idle, which needs no PCIe memory vote in the sleep set.
PATCH_SKIP="${PATCH_SKIP:-} 0057-usb-dwc3-qcom-apply-a-role-change-from-sleep-after-resume.patch 0068-arm64-dts-qcom-sm8650-enable-UFS-MCQ.patch 0047-arm64-dts-qcom-sm8650-pcie-sleep-floor-at-cx-retention.patch"
KEEP_IMAGE=1
# GRUB starts the kernel with linuxdirect and no initrd, so our startup code
# (root lookup, /etc overlay, update recovery, bootlog.txt, the debug file)
# has to be built into the Image.
EMBED_INITRAMFS=1

# One DTB per panel supplier (stock Android: getprop ro.vendor.display.paneltype,
# 1 = BOE). The installer picks the matching one.
DTBS="sm8650-lenovo-tb321fu-boe sm8650-lenovo-tb321fu-csot"

# GPU microcode only: the tablet's zap shader is signed for it and loads from
# the rootfs (qcom/sm8650/lenovo/tb321fu/).
BUILTIN_FW="
xfw/SM8650/qcom/gen70900_aqe.fw:qcom/gen70900_aqe.fw
xfw/SM8650/qcom/gen70900_sqe.fw:qcom/gen70900_sqe.fw
xfw/SM8650/qcom/gmu_gen70900.bin:qcom/gmu_gen70900.bin
"

# drm_client_lib.active=none: no fbdev console client on the DSC panel; the
# TB321FU bring-up runs with it.
CMDLINE_SOC="steamos.usbimage=1 firmware_class.path=/usr/lib/firmware/steamos-arm/tb321fu irqaffinity=0-1 mem_sleep_default=s2idle fw_devlink.sync_state=timeout drm_client_lib.active=none"
