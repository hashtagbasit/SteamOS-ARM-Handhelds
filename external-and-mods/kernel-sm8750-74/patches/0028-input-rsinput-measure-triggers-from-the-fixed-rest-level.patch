Subject: [PATCH] input: rsinput: measure triggers from the fixed rest level

The MCU reports a trigger as a falling reading from a fixed rest level of
0x610. The driver measured the travel from trigger_*_max, which is also
the evdev range, so lowering the range (a calibration writing the module
parameter) shifted every sample down by the same amount and the trigger
never reached full scale. Measure from the rest level and leave
trigger_*_max to describe the range only.

---
--- a/drivers/input/joystick/rsinput.c
+++ b/drivers/input/joystick/rsinput.c
@@ -22,6 +22,9 @@
 
 static int update_params=0;
 
+/* MCU trigger reading at rest; the calibrated range is trigger_*_max */
+#define RSINPUT_TRIGGER_REST 0x610
+
 static int trigger_left_max=0x610;
 static int trigger_left_deadzone=0x0;
 static int trigger_left_antideadzone=0x0;
@@ -291,11 +294,11 @@
     }
 
     int16_t raw_trig_l = (data[FRAME_POS_DATA_3] | (data[FRAME_POS_DATA_4] << 8));
-    int16_t z = trigger_left_max - raw_trig_l;
+    int16_t z = RSINPUT_TRIGGER_REST - raw_trig_l;
     z = ( z < trigger_left_deadzone ) ? 0 : z - trigger_left_antideadzone;
 
     int16_t raw_trig_r = (data[FRAME_POS_DATA_5] | (data[FRAME_POS_DATA_6] << 8));
-    int16_t rz = trigger_right_max - raw_trig_r;
+    int16_t rz = RSINPUT_TRIGGER_REST - raw_trig_r;
     rz = ( rz < trigger_right_deadzone ) ? 0 : rz - trigger_right_antideadzone;
 
     int16_t raw_x = -(int16_t)(data[FRAME_POS_DATA_7] | (data[FRAME_POS_DATA_8] << 8));
