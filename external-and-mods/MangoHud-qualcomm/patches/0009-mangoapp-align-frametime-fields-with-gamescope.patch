From: hashtagbasit
Subject: [PATCH] mangoapp: align frametime fields with gamescope ABI order

gamescope's v1 sender writes application-ready timing at offset 16 and
the visible timing at offset 26. Align the receiver field names in
struct mangoapp_msg_v1 with that software protocol order: the field
after pid becomes app_frametime_ns and the field after the two uint8_t
FSR fields becomes visible_frametime_ns, with the placeholder comment
replaced by one documenting the ABI field order.

Only the field names and that comment move; the 95-byte message layout,
the 87-byte SysV payload and all trailing fields are unchanged.
---
 src/app/mangoapp_proto.h | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/app/mangoapp_proto.h b/src/app/mangoapp_proto.h
--- a/src/app/mangoapp_proto.h
+++ b/src/app/mangoapp_proto.h
@@ -18,11 +18,11 @@ struct mangoapp_msg_v1 {
     struct mangoapp_msg_header hdr;
 
     uint32_t pid;
-    uint64_t visible_frametime_ns;
+    uint64_t app_frametime_ns;
     uint8_t fsrUpscale;
     uint8_t fsrSharpness;
-    // For debugging
-    uint64_t app_frametime_ns;
+    // ABI field order: application timing first, then visible timing
+    uint64_t visible_frametime_ns;
     uint64_t latency_ns;
     uint32_t outputWidth;
     uint32_t outputHeight;
