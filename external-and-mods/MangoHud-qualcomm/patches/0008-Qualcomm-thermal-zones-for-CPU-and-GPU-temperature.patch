     return static_cast<float>(total) / 1024 / 1024 / 1024;
+}
+
+// Adreno on mainline: gpuss thermal zones ("gpuss-0-thermal", "gpuss0-thermal").
+// A game's DRM handles say "msm", the device says "msm_dpu".
+static bool is_qualcomm_msm(const std::string& module) {
+    return module == "msm" || module == "msm_drm" || module == "msm_dpu";
+}
+
+static float qualcomm_gpu_zone_temp() {
+    long best = 0;
+    std::error_code ec;
+    for (const auto& d : fs::directory_iterator("/sys/class/thermal", ec)) {
+        if (d.path().filename().string().compare(0, 12, "thermal_zone") != 0)
+            continue;
+        std::string type;
+        {
+            std::ifstream t(d.path() / "type");
+            std::getline(t, type);
+        }
+        if (type.compare(0, 5, "gpuss") != 0 && type.compare(0, 4, "gpu-") != 0)
+            continue;
+        std::ifstream f(d.path() / "temp");
+        long v = 0;
+        if (f >> v && v > best)
+            best = v;
+    }
+    return best / 1000.f;
 }
 
