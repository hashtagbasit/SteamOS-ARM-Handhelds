         std::string type = read_line(d / "type");
-        bool cpuss = type.substr(0, 6) == "cpuss-";
-        if (!cpuss && type.substr(0, 4) != "cpu-")
+        // "cpuss-0" on the 8 Elite, "cpuss0-thermal" and "cpu2-top-thermal"
+        // on mainline 8 Gen 3 (Lenovo tablets).
+        bool cpuss = type.compare(0, 5, "cpuss") == 0;
+        if (!cpuss && type.compare(0, 3, "cpu") != 0)
             continue;
 
