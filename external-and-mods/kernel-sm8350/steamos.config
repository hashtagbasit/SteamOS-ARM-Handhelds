# SM8350 / REDMAGIC 6 options on top of arm64 defconfig + ../kernel-common/steamos.config.
# There is no base recipe for this SoC, so the base is the stock arm64
# defconfig and everything the phone needs is listed here.

# Qualcomm only. The full defconfig Image is ~48 MiB, over what Nubia's ABL
# loads (its own kernel is 42 MiB; a 47 MiB Image got "Load Error"), and
# every other platform's built-in drivers go with these.
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_AIROHA=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_AXIADO=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BCM2835=n
CONFIG_ARCH_BCM_IPROC=n
CONFIG_ARCH_BCMBCA=n
CONFIG_ARCH_BRCMSTB=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_BITMAIN=n
CONFIG_ARCH_BLAIZE=n
CONFIG_ARCH_CIX=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_S32=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_SOPHGO=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_TESLA_FSD=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n

# Built in: the busybox initramfs loads no modules, and the root is on UFS.
CONFIG_PINCTRL_SM8350=y
CONFIG_SM_GCC_8350=y
CONFIG_INTERCONNECT_QCOM_SM8350=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
# PHY_QCOM_QMP caps its children (UFS, COMBO) at its own value
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_EXT4_FS=y
# ABL's continuous-splash framebuffer until msm DRM takes over
# (DRM core built in so simpledrm can be)
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
# The splash framebuffer holds MDSS_GDSC: dispcc (sm8250 driver covers sm8350)
CONFIG_SM_DISPCC_8250=y
# The DSI controller needs the refgen supply at probe
CONFIG_REGULATOR_QCOM_REFGEN=y
# The GPU SMMU needs gpucc's GDSC at probe (else it times out after 10+ s)
CONFIG_SM_GPUCC_8350=y
CONFIG_SM_VIDEOCC_8350=m
CONFIG_FRAMEBUFFER_CONSOLE=y
# USB gadget debug shell in the initramfs (ACM serial + NCM network)
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
# COMBO (the USB3 PHY dwc3 waits for) is capped by TYPEC
CONFIG_TYPEC=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_U_SERIAL_CONSOLE=y
# Crash logs survive a reboot in RAM (reserved-memory ramoops)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Display: DPU + DSI (C-PHY, DSC) and the NX669J panels. Built in: the
# console on the real panel is the only log channel before the rootfs.
# msm DRM "depends on X || X=n": these must be built in (or off) for =y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_OCMEM=n
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_NUBIA_NX669J=y
# Board devices
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_I2C=m
CONFIG_SENSORS_NUBIA_NX669J_FAN=m
CONFIG_INPUT_NUBIA_NX669J_TRIGGERS=m
CONFIG_LEDS_NUBIA_NX669J=m
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_RTC_DRV_PM8XXX=y
# Battery / USB role / charging, all through the ADSP
CONFIG_QCOM_PMIC_GLINK=m
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_UCSI_PMIC_GLINK=m
CONFIG_TYPEC_UCSI=m
CONFIG_QCOM_Q6V5_PAS=m
# Wi-Fi / Bluetooth: WCN6855-class (QCA6490) on PCIe0 + UART18
CONFIG_PCIE_QCOM=y
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_SERIAL_QCOM_GENI=y
# Speaker amplifiers (sound card still to do)
CONFIG_SND_SOC_MAX98927=m
CONFIG_SND_SOC_MAX98937=m
# Bluetooth controllers: bluez runs BLE HID (HOG: Xbox, 8BitDo, Steam
# Controller) through uhid; the pad drivers add rumble, LEDs and battery
CONFIG_BT_LE=y
CONFIG_UHID=m
# steamos-manager's screenreader service opens /dev/uinput and the whole
# daemon fails (and hangs 180 s) without it, holding Game Mode back ~3 min;
# InputPlumber / Steam Input virtual pads use it too
CONFIG_INPUT_UINPUT=m
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y
CONFIG_HID_MICROSOFT=m
# USB / 2.4 GHz dongle pads in XInput mode (8BitDo 2dc8:310a, Xbox 360/One):
# a vendor-class interface only xpad binds; without it only the dongle's
# keyboard/mouse HID shows up
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_INPUT_JOYDEV=m
