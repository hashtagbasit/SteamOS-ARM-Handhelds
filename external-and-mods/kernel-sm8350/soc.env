# SM8350 (Snapdragon 888): REDMAGIC 6 (Nubia NX669J), North American/global
# NX669J-UN. Sourced by kernel-sm8350/build.sh and kernel-common/cmdline.sh.
#
# Unlike the SM8550/SM8650 handhelds there is no base recipe or ROCKNIX
# ABL here: the kernel is mainline + kernel-sm8350/patches on the arm64
# defconfig, and it boots from Nubia's stock (unlocked) ABL in Nubia's own
# layout: a v3 boot image with the kernel and a v3 vendor_boot with the DTB,
# initramfs and cmdline (mkbootimg-v3.py).

SOC=sm8350
KVER=7.1.2
DTB=sm8350-nubia-nx669j

# Debian's static busybox for the initramfs (the build host may be x86).
BUSYBOX_DEB=busybox-static_1.38.0-3+b1_arm64.deb
BUSYBOX_DEB_SHA256=968d1aa8f579fa1ac59c26afa365454369e13cf29848e6400b50028fed0ffda0

# No SD card slot: SteamOS lives on the UFS userdata partition. The stock
# ABL appends its own arguments, so the initramfs is told via steamos.root=.
ROOT_SPEC="PARTLABEL=userdata"
KERNEL_CMDLINE_EXTRA="steamos.root=PARTLABEL=userdata"

# Kernel cmdline, SoC part (see kernel-common/cmdline.sh). The A55s are
# CPUs 0-3; keep IRQs there like the other SoCs keep them on the little cores.
# firmware_class.path: generated files (Wi-Fi board-2.bin, sm8350-overlay).
CMDLINE_SOC="irqaffinity=0-3 mem_sleep_default=s2idle cgroup.memory=nokmem,nosocket pcie_ports=compat firmware_class.path=/var/lib/steamos-arm/firmware"

# boot-debug.img: verbose console, USB debug shell, and nothing gated off
# before the display and GPU drivers have been proven on this phone.
CMDLINE_DEBUG="steamos.usbshell=1 steamos.debug=1 clk_ignore_unused pd_ignore_unused"

# vendor_boot carries one DTB copy per board-id: with dtbo erased, Nubia's
# ABL matches the DTB against the board's real board-id, which is not
# published. These are the ids of the stock dtbo entries, plus 0:0 (verified
# on an NX669J-UN, 2026-09-29).
BOARD_IDS="0:0,10001:0,10008:0,1000b:0,1000b:8,1000f:0,1001f:0,1001f:1,1001f:2,10021:0,1010008:0,101000b:0,20008:0,2010008:0,201000b:0,20108:0,20201:0,22:0,22:1,22:2,22:3,3010001:0"
