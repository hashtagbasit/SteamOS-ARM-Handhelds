From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zaviya-RM6 <exclaim_plethora227@simplelogin.com>
Date: Tue, 29 Sep 2026 00:30:42 -0500
Subject: [PATCH] drm/panel: add REDMAGIC 6 (Nubia NX669J) AMOLED panels

NT37701 and NT37800A command mode panels on DSI C-PHY with DSC 10 bpc.
Init sequences are generated from the stock devicetree by
tools/gen-panel-seq.py.
---
 drivers/gpu/drm/panel/Kconfig                 |   12 +
 drivers/gpu/drm/panel/Makefile                |    1 +
 .../gpu/drm/panel/panel-nubia-nx669j-seq.h    | 1285 +++++++++++++++++
 drivers/gpu/drm/panel/panel-nubia-nx669j.c    |  628 ++++++++
 4 files changed, 1926 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-nubia-nx669j-seq.h
 create mode 100644 drivers/gpu/drm/panel/panel-nubia-nx669j.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index d592f4f..99d236d 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -624,6 +624,18 @@ config DRM_PANEL_NOVATEK_NT37801
 	  NT37810) AMOLED DSI Video Mode LCD panel module with 1440x3200
 	  resolution.
 
+config DRM_PANEL_NUBIA_NX669J
+	tristate "REDMAGIC 6 (Nubia NX669J) AMOLED panels"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_DSC_HELPER
+	select DRM_DISPLAY_HELPER
+	help
+	  Say Y here to support the 1080x2400 command mode AMOLED panels of
+	  the REDMAGIC 6 (Nubia NX669J): Novatek NT37701 and NT37800A driven
+	  over DSI C-PHY with DSC.
+
 config DRM_PANEL_NOVATEK_NT39016
 	tristate "Novatek NT39016 RGB/SPI panel"
 	depends on OF && SPI
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index a4291dc..e79fdc3 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -61,6 +61,7 @@ obj-$(CONFIG_DRM_PANEL_NOVATEK_NT36672A) += panel-novatek-nt36672a.o
 obj-$(CONFIG_DRM_PANEL_NOVATEK_NT36672E) += panel-novatek-nt36672e.o
 obj-$(CONFIG_DRM_PANEL_NOVATEK_NT37700F) += panel-novatek-nt37700f.o
 obj-$(CONFIG_DRM_PANEL_NOVATEK_NT37801) += panel-novatek-nt37801.o
+obj-$(CONFIG_DRM_PANEL_NUBIA_NX669J) += panel-nubia-nx669j.o
 obj-$(CONFIG_DRM_PANEL_NOVATEK_NT39016) += panel-novatek-nt39016.o
 obj-$(CONFIG_DRM_PANEL_MANTIX_MLAF057WE51) += panel-mantix-mlaf057we51.o
 obj-$(CONFIG_DRM_PANEL_OLIMEX_LCD_OLINUXINO) += panel-olimex-lcd-olinuxino.o
