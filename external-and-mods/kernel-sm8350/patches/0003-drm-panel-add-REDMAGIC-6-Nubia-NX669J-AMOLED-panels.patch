+	{ 0x39, 0, 16, (const u8[]){ 0xc4, 0x80, 0x00, 0xf0, 0x90, 0x7f, 0x5f, 0x33, 0xf0, 0x00, 0x00, 0x0c, 0x91, 0x7f, 0x00, 0x00 } },
+	{ 0x39, 0, 2, (const u8[]){ 0x6f, 0x24 } },
+	{ 0x39, 0, 8, (const u8[]){ 0xc4, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 } },
+	{ 0x05, 120, 2, (const u8[]){ 0x11, 0x00 } },
+	{ 0x05, 0, 2, (const u8[]){ 0x29, 0x00 } },
+};
+static const struct nx669j_cmd nt37800a_b6_switch_60[] = {
+	{ 0x39, 20, 2, (const u8[]){ 0x2f, 0x07 } },
+};
+static const struct nx669j_cmd nt37800a_b6_off[] = {
+	{ 0x05, 50, 2, (const u8[]){ 0x28, 0x00 } },
+	{ 0x05, 100, 2, (const u8[]){ 0x10, 0x00 } },
+};
+static const struct nx669j_mode nt37800a_b6_modes[] = {
+	{ .rate = 165, .hdisplay = 1080, .hfp = 100, .hpw = 8, .hbp = 100, .vdisplay = 2400, .vfp = 24, .vpw = 2, .vbp = 16,
+	  .on_cmds = nt37800a_b6_on_165, .num_on_cmds = ARRAY_SIZE(nt37800a_b6_on_165),
+	  .switch_cmds = nt37800a_b6_switch_165, .num_switch_cmds = ARRAY_SIZE(nt37800a_b6_switch_165) },
+	{ .rate = 144, .hdisplay = 1080, .hfp = 100, .hpw = 8, .hbp = 100, .vdisplay = 2400, .vfp = 24, .vpw = 2, .vbp = 16,
+	  .on_cmds = nt37800a_b6_on_144, .num_on_cmds = ARRAY_SIZE(nt37800a_b6_on_144),
+	  .switch_cmds = nt37800a_b6_switch_144, .num_switch_cmds = ARRAY_SIZE(nt37800a_b6_switch_144) },
+	{ .rate = 120, .hdisplay = 1080, .hfp = 100, .hpw = 8, .hbp = 100, .vdisplay = 2400, .vfp = 24, .vpw = 2, .vbp = 16,
+	  .on_cmds = nt37800a_b6_on_120, .num_on_cmds = ARRAY_SIZE(nt37800a_b6_on_120),
+	  .switch_cmds = nt37800a_b6_switch_120, .num_switch_cmds = ARRAY_SIZE(nt37800a_b6_switch_120) },
+	{ .rate = 90, .hdisplay = 1080, .hfp = 100, .hpw = 8, .hbp = 100, .vdisplay = 2400, .vfp = 24, .vpw = 2, .vbp = 16,
+	  .on_cmds = nt37800a_b6_on_90, .num_on_cmds = ARRAY_SIZE(nt37800a_b6_on_90),
+	  .switch_cmds = nt37800a_b6_switch_90, .num_switch_cmds = ARRAY_SIZE(nt37800a_b6_switch_90) },
+	{ .rate = 60, .hdisplay = 1080, .hfp = 100, .hpw = 8, .hbp = 100, .vdisplay = 2400, .vfp = 24, .vpw = 2, .vbp = 16,
+	  .on_cmds = nt37800a_b6_on_60, .num_on_cmds = ARRAY_SIZE(nt37800a_b6_on_60),
+	  .switch_cmds = nt37800a_b6_switch_60, .num_switch_cmds = ARRAY_SIZE(nt37800a_b6_switch_60) },
+};
+static const struct nx669j_panel_desc nt37800a_b6_desc = {
+	.name = "nt37800a_b6",
+	.reset_seq = { 1, 10, 0, 10, 1, 10 },
+	.num_reset_steps = 3,
+	.off_cmds = nt37800a_b6_off, .num_off_cmds = ARRAY_SIZE(nt37800a_b6_off),
+	.modes = nt37800a_b6_modes, .num_modes = ARRAY_SIZE(nt37800a_b6_modes),
+	.dsc_slice_width = 540, .dsc_slice_height = 40,
