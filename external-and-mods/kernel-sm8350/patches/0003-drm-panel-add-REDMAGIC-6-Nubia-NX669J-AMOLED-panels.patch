diff --git a/drivers/gpu/drm/panel/panel-nubia-nx669j.c b/drivers/gpu/drm/panel/panel-nubia-nx669j.c
new file mode 100644
index 0000000..0878351
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-nubia-nx669j.c
@@ -0,0 +1,628 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * REDMAGIC 6 (Nubia NX669J) 1080x2400 AMOLED command-mode panels.
+ *
+ * The phone ships with one of several Novatek DDICs (NT37701, NT37800A, each
+ * in two revisions), all driven over DSI C-PHY with DSC (10 bpc / 10 bpp).
+ * Their init sequences come from Nubia's downstream devicetree; see
+ * panel-nubia-nx669j-seq.h (generated by tools/gen-panel-seq.py).
+ *
+ * The bootloader probes the panel and passes the matching downstream node
+ * name on the command line (msm_drm.dsi_display0=qcom,mdss_dsi_<name>:...),
+ * so with the generic "nubia,nx669j-panel" compatible the variant is picked
+ * from /chosen/bootargs. A specific compatible overrides that.
+ *
+ * Every refresh rate has its own init sequence, so the mode being set is
+ * looked up from the connector state at prepare time (as panel-novatek-nt35950
+ * does) and a rate change is a full modeset.
+ *
+ * The panel is portrait; the DT "rotation" becomes the connector's panel
+ * orientation so gamescope runs Game Mode in landscape, as on the Deck.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+#include <linux/unaligned.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+#include <video/mipi_display.h>
+
+struct nx669j_cmd {
+	u8 type;	/* MIPI DSI data type as in the downstream blob */
+	u16 wait_ms;
+	u16 len;
+	const u8 *data;
+};
+
+struct nx669j_mode {
+	unsigned int rate;
+	u16 hdisplay, hfp, hpw, hbp;
+	u16 vdisplay, vfp, vpw, vbp;
+	const struct nx669j_cmd *on_cmds;
+	unsigned int num_on_cmds;
+	const struct nx669j_cmd *switch_cmds;
+	unsigned int num_switch_cmds;
+};
+
+struct nx669j_panel_desc {
+	const char *name;
+	u8 reset_seq[6];	/* level, ms pairs */
+	unsigned int num_reset_steps;
+	const struct nx669j_cmd *off_cmds;
+	unsigned int num_off_cmds;
+	const struct nx669j_mode *modes;
+	unsigned int num_modes;
+	u16 dsc_slice_width, dsc_slice_height;
+	u8 dsc_bpc, dsc_bpp;
+	u8 dsc_slice_per_pkt;
+};
+
+#include "panel-nubia-nx669j-seq.h"
+
+static const struct {
+	const char *downstream;	/* ABL panel node name, longest match first */
+	const struct nx669j_panel_desc *desc;
+} nx669j_abl_names[] = {
+	{ "mdss_dsi_nt37800a_1080_2400_amoled_cmd_b6", &nt37800a_b6_desc },
+	{ "mdss_dsi_nt37800a_1080_2400_amoled_cmd", &nt37800a_desc },
+	{ "mdss_dsi_nt37701_1080_2400_amoled_cmd_b0", &nt37701_b0_desc },
+	{ "mdss_dsi_nt37701_1080_2400_amoled_cmd", &nt37701_desc },
+};
+
+#define NX669J_MAX_RATE	144
+#define NX669J_BL_MIN	8
+#define NX669J_BL_MAX	2047
+
+struct nx669j_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	const struct nx669j_panel_desc *desc;
+	struct drm_dsc_config dsc;
+	struct regulator_bulk_data supplies[3];
+	struct gpio_desc *reset_gpio;
+	struct drm_connector *connector;
+	const struct nx669j_mode *cur_mode;
+	enum drm_panel_orientation orientation;
+	bool abl_initialised;
+};
+
+static inline struct nx669j_panel *to_nx669j(struct drm_panel *panel)
+{
+	return container_of(panel, struct nx669j_panel, panel);
+}
+
+static bool nx669j_has_init(const struct nx669j_panel *ctx)
+{
+	return ctx->desc->modes[0].num_on_cmds;
+}
+
+/*
+ * Novatek 0x91 programs the panel's DSC decoder with rate-control values.
+ * Rewrite them from the config the host actually encodes with (filled in
+ * by the host before prepare), so the two can never disagree; with the
+ * host's initial_xmit_delay set to Nubia's 512 they equal the stock ones.
+ */
+static const u8 *nx669j_fix_dsc(const struct nx669j_panel *ctx,
+				const struct nx669j_cmd *c, u8 *buf)
+{
+	const struct drm_dsc_config *d = &ctx->dsc;
+
+	if (c->len != 19 || c->data[0] != 0x91 || !d->initial_dec_delay)
+		return c->data;
+	memcpy(buf, c->data, c->len);
+	put_unaligned_be16(d->slice_height, &buf[3]);
+	put_unaligned_be16(d->initial_dec_delay, &buf[7]);
+	put_unaligned_be16(d->scale_increment_interval, &buf[9]);
+	put_unaligned_be16(d->scale_decrement_interval, &buf[11]);
+	put_unaligned_be16(d->nfl_bpg_offset, &buf[13]);
+	put_unaligned_be16(d->slice_bpg_offset, &buf[15]);
+	put_unaligned_be16(d->final_offset, &buf[17]);
+	return buf;
+}
+
+static void nx669j_send(const struct nx669j_panel *ctx,
+			struct mipi_dsi_multi_context *dsi_ctx,
+			const struct nx669j_cmd *cmds, unsigned int num)
+{
+	unsigned int i;
+	u8 buf[19];
+
+	for (i = 0; i < num && !dsi_ctx->accum_err; i++) {
+		const struct nx669j_cmd *c = &cmds[i];
+		const u8 *data = nx669j_fix_dsc(ctx, c, buf);
+
+		switch (c->type) {
+		case MIPI_DSI_GENERIC_SHORT_WRITE_0_PARAM:
+		case MIPI_DSI_GENERIC_SHORT_WRITE_1_PARAM:
+		case MIPI_DSI_GENERIC_SHORT_WRITE_2_PARAM:
+		case MIPI_DSI_GENERIC_LONG_WRITE:
+			mipi_dsi_generic_write_multi(dsi_ctx, data, c->len);
+			break;
+		default:
+			/* DCS short/long writes; the downstream blob pads short
+			 * no-parameter writes with a 0x00, which DCS ignores. */
+			mipi_dsi_dcs_write_buffer_multi(dsi_ctx, data,
+				c->type == MIPI_DSI_DCS_SHORT_WRITE ? 1 : c->len);
+			break;
+		}
+		if (c->wait_ms)
+			mipi_dsi_msleep(dsi_ctx, c->wait_ms);
+	}
+}
+
+static void nx669j_reset(struct nx669j_panel *ctx)
+{
+	const struct nx669j_panel_desc *d = ctx->desc;
+	unsigned int i;
+
+	/* reset_seq is in panel levels: 1 = released, 0 = asserted */
+	for (i = 0; i < d->num_reset_steps; i++) {
+		gpiod_set_value_cansleep(ctx->reset_gpio, !d->reset_seq[2 * i]);
+		usleep_range(d->reset_seq[2 * i + 1] * 1000,
+			     d->reset_seq[2 * i + 1] * 1000 + 1000);
+	}
+}
+
+static const struct nx669j_mode *nx669j_default_mode(const struct nx669j_panel_desc *d)
+{
+	unsigned int i;
+
+	for (i = 0; i < d->num_modes; i++)
+		if (d->modes[i].rate <= NX669J_MAX_RATE)
+			return &d->modes[i];
+	return &d->modes[0];
+}
+
+static const struct nx669j_mode *nx669j_find_mode(struct nx669j_panel *ctx)
+{
+	const struct nx669j_panel_desc *d = ctx->desc;
+	struct drm_crtc_state *crtc_state;
+	unsigned int i;
+
+	if (!ctx->connector || !ctx->connector->state ||
+	    !ctx->connector->state->crtc)
+		return nx669j_default_mode(d);
+
+	crtc_state = ctx->connector->state->crtc->state;
+	for (i = 0; i < d->num_modes; i++)
+		if (d->modes[i].rate <= NX669J_MAX_RATE &&
+		    drm_mode_vrefresh(&crtc_state->mode) == d->modes[i].rate)
+			return &d->modes[i];
+
+	return nx669j_default_mode(d);
+}
+
+static int nx669j_prepare(struct drm_panel *panel)
+{
+	struct nx669j_panel *ctx = to_nx669j(panel);
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+	struct drm_dsc_picture_parameter_set pps;
+	const struct nx669j_mode *mode = nx669j_find_mode(ctx);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	/*
+	 * Same order as Nubia's stack (dsi_panel_update_pps() before
+	 * dsi_panel_enable()): PPS first, then the init, which enables
+	 * compression itself (Novatek DCS 03h 01) and ends with sleep out and
+	 * display on. Downstream never sends the MIPI compression mode packet.
+	 */
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+
+	if (nx669j_has_init(ctx)) {
+		int tries;
+		u8 pm = 0;
+
+		nx669j_reset(ctx);
+		ret = mipi_dsi_picture_parameter_set(dsi, &pps);
+		if (ret < 0)
+			dsi_ctx.accum_err = ret;
+		/*
+		 * Straight after reset the NT37800A drops part of the init (on
+		 * the NX669J: compression stays off, DSC registers keep their
+		 * defaults, sleep out is ignored) while later commands land. A
+		 * full resend works, so send it until the panel reports sleep
+		 * out (DCS 0Ah bit 4).
+		 */
+		for (tries = 0; tries < 3 && !dsi_ctx.accum_err; tries++) {
+			nx669j_send(ctx, &dsi_ctx, mode->on_cmds, mode->num_on_cmds);
+			if (mipi_dsi_dcs_get_power_mode(dsi, &pm) >= 0 && (pm & BIT(4)))
+				break;
+		}
+		if (tries)
+			dev_info(panel->dev, "init needed %d resend(s)\n", tries);
+	} else {
+		/*
+		 * No init sequence was ever published for this revision: only
+		 * the bootloader knows how to bring it up. Keep its state (no
+		 * reset) and just select the rate and wake it.
+		 */
+		if (!ctx->abl_initialised)
+			dev_warn(panel->dev,
+				 "%s has no init sequence, relying on bootloader state\n",
+				 ctx->desc->name);
+		ret = mipi_dsi_picture_parameter_set(dsi, &pps);
+		if (ret < 0)
+			dsi_ctx.accum_err = ret;
+		nx669j_send(ctx, &dsi_ctx, mode->switch_cmds, mode->num_switch_cmds);
+		mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+		mipi_dsi_msleep(&dsi_ctx, 120);
+		mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	}
+
+	if (!dsi_ctx.accum_err) {
+		u8 pm = 0, id[3] = {};
+
+		/* Power mode: bit 7 booster, 4 sleep out, 2 display on */
+		mipi_dsi_dcs_get_power_mode(dsi, &pm);
+		mipi_dsi_dcs_read(dsi, 0xda, &id[0], 1);
+		mipi_dsi_dcs_read(dsi, 0xdb, &id[1], 1);
+		mipi_dsi_dcs_read(dsi, 0xdc, &id[2], 1);
+		dev_info(panel->dev, "%s @ %u Hz up: power mode 0x%02x, id %02x %02x %02x\n",
+			 ctx->desc->name, mode->rate, pm, id[0], id[1], id[2]);
+	}
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	if (dsi_ctx.accum_err) {
+		dev_err(panel->dev, "failed to initialise %s @ %u Hz: %d\n",
+			ctx->desc->name, mode->rate, dsi_ctx.accum_err);
+		if (nx669j_has_init(ctx))
+			gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+		return dsi_ctx.accum_err;
+	}
+
+	ctx->cur_mode = mode;
+	return 0;
+}
+
+static int nx669j_unprepare(struct drm_panel *panel)
+{
+	struct nx669j_panel *ctx = to_nx669j(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	nx669j_send(ctx, &dsi_ctx, ctx->desc->off_cmds, ctx->desc->num_off_cmds);
+	if (dsi_ctx.accum_err)
+		dev_err(panel->dev, "failed to power off: %d\n", dsi_ctx.accum_err);
+
+	/*
+	 * The bootloader-only revision cannot be brought back from reset, so
+	 * it stays powered (sleep-in only) across unprepare.
+	 */
+	if (nx669j_has_init(ctx)) {
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	} else {
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+		ctx->abl_initialised = true;
+	}
+
+	return 0;
+}
+
+static void nx669j_fill_mode(struct drm_display_mode *m,
+			     const struct nx669j_mode *pm)
+{
+	m->hdisplay = pm->hdisplay;
+	m->hsync_start = m->hdisplay + pm->hfp;
+	m->hsync_end = m->hsync_start + pm->hpw;
+	m->htotal = m->hsync_end + pm->hbp;
+	m->vdisplay = pm->vdisplay;
+	m->vsync_start = m->vdisplay + pm->vfp;
+	m->vsync_end = m->vsync_start + pm->vpw;
+	m->vtotal = m->vsync_end + pm->vbp;
+	m->clock = DIV_ROUND_UP(m->htotal * m->vtotal * pm->rate, 1000);
+	m->width_mm = 71;	/* qcom,mdss-pan-physical-*-dimension */
+	m->height_mm = 157;
+	m->type = DRM_MODE_TYPE_DRIVER;
+	drm_mode_set_name(m);
+}
+
+static int nx669j_get_modes(struct drm_panel *panel,
+			    struct drm_connector *connector)
+{
+	struct nx669j_panel *ctx = to_nx669j(panel);
+	const struct nx669j_panel_desc *d = ctx->desc;
+	unsigned int i, n = 0;
+
+	ctx->connector = connector;
+
+	for (i = 0; i < d->num_modes; i++) {
+		struct drm_display_mode *m;
+
+		/*
+		 * The REDMAGIC 6 is a 144 Hz phone; the NT37800A tables also
+		 * carry 165 Hz (6S Pro), which its DSI clocks are not set up for.
+		 */
+		if (d->modes[i].rate > NX669J_MAX_RATE)
+			continue;
+		m = drm_mode_create(connector->dev);
+		if (!m)
+			return -ENOMEM;
+		nx669j_fill_mode(m, &d->modes[i]);
+		if (!n++)
+			m->type |= DRM_MODE_TYPE_PREFERRED;
+		drm_mode_probed_add(connector, m);
+	}
+
+	connector->display_info.width_mm = 71;
+	connector->display_info.height_mm = 157;
+	connector->display_info.bpc = 10;
+	/* Set here too: the property must exist before the connector registers. */
+	drm_connector_set_panel_orientation(connector, ctx->orientation);
+
+	return n;
+}
+
+static enum drm_panel_orientation nx669j_get_orientation(struct drm_panel *panel)
+{
+	return to_nx669j(panel)->orientation;
+}
+
+static const struct drm_panel_funcs nx669j_panel_funcs = {
+	.prepare = nx669j_prepare,
+	.unprepare = nx669j_unprepare,
+	.get_modes = nx669j_get_modes,
+	.get_orientation = nx669j_get_orientation,
+};
+
+static int nx669j_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	if (brightness && brightness < NX669J_BL_MIN)
+		brightness = NX669J_BL_MIN;
+
+	/* qcom,mdss-dsi-bl-inverted-dbv: the DDIC wants the value big-endian */
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return ret;
+}
+
+static const struct backlight_ops nx669j_bl_ops = {
+	.update_status = nx669j_bl_update_status,
+};
+
+/*
+ * Bring-up aid: echo "0a 1" > dcs_read; cat dcs_read  (register, length)
+ *               echo "11" > dcs_write                  (DCS bytes, LP mode)
+ */
+static u8 nx669j_dbg_reg, nx669j_dbg_len = 1;
+
+static ssize_t dcs_read_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	unsigned int reg, len = 1;
+
+	if (sscanf(buf, "%x %u", &reg, &len) < 1 || reg > 0xff || !len || len > 32)
+		return -EINVAL;
+	nx669j_dbg_reg = reg;
+	nx669j_dbg_len = len;
+	return count;
+}
+
+static ssize_t dcs_read_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(dev);
+	u8 val[32];
+	ssize_t ret, n = 0;
+	int i;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_read(dsi, nx669j_dbg_reg, val, nx669j_dbg_len);
+	if (ret < 0)
+		return ret;
+	for (i = 0; i < ret; i++)
+		n += sysfs_emit_at(buf, n, "%02x ", val[i]);
+	n += sysfs_emit_at(buf, n, "\n");
+	return n;
+}
+static DEVICE_ATTR_RW(dcs_read);
+
+static ssize_t dcs_write_store(struct device *dev, struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(dev);
+	u8 data[64];
+	int len = 0, off = 0, n;
+	unsigned int v;
+	ssize_t ret;
+
+	while (len < ARRAY_SIZE(data) && sscanf(buf + off, "%x%n", &v, &n) == 1) {
+		data[len++] = v;
+		off += n;
+	}
+	if (!len)
+		return -EINVAL;
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_write_buffer(dsi, data, len);
+	return ret < 0 ? ret : count;
+}
+static DEVICE_ATTR_WO(dcs_write);
+
+static struct attribute *nx669j_dbg_attrs[] = {
+	&dev_attr_dcs_read.attr,
+	&dev_attr_dcs_write.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(nx669j_dbg);
+
+static const struct nx669j_panel_desc *nx669j_desc_from_bootargs(struct device *dev)
+{
+	const char *bootargs;
+	unsigned int i;
+
+	if (!of_chosen || of_property_read_string(of_chosen, "bootargs", &bootargs))
+		return NULL;
+
+	for (i = 0; i < ARRAY_SIZE(nx669j_abl_names); i++)
+		if (strstr(bootargs, nx669j_abl_names[i].downstream)) {
+			dev_info(dev, "bootloader selected %s\n",
+				 nx669j_abl_names[i].desc->name);
+			return nx669j_abl_names[i].desc;
+		}
+
+	return NULL;
+}
+
+static int nx669j_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct nx669j_panel_desc *desc = of_device_get_match_data(dev);
+	struct nx669j_panel *ctx;
+	int ret;
+
+	if (!desc) {
+		desc = nx669j_desc_from_bootargs(dev);
+		if (!desc) {
+			dev_warn(dev, "panel not named by the bootloader, assuming nt37701\n");
+			desc = &nt37701_desc;
+		}
+	}
+
+	ctx = devm_drm_panel_alloc(dev, struct nx669j_panel, panel,
+				   &nx669j_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->desc = desc;
+	ctx->dsi = dsi;
+
+	ctx->supplies[0].supply = "vddio";
+	ctx->supplies[1].supply = "vci";
+	ctx->supplies[2].supply = "dvdd";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	/*
+	 * The bootloader leaves the panel running (continuous splash): keep
+	 * reset deasserted until the first prepare re-initialises it.
+	 */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "failed to get reset-gpios\n");
+
+	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "invalid rotation\n");
+
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 3;		/* C-PHY trios */
+	/*
+	 * RGB888 even though DSC runs at 10 bpc: over C-PHY the msm DSI host
+	 * derives the pixel clock from the byte clock, and with 30 bpp the
+	 * ratio (pclk = 2.5 x the PLL's pixel divider output) cannot be made
+	 * ("Failed to set rate pixel clk, -22" on the NX669J). With 24 bpp it
+	 * divides by 2. The DSC stream itself is set by dsc.bits_per_component.
+	 */
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_LPM;
+
+	ctx->panel.prepare_prev_first = true;
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev),
+				dev, dsi, &nx669j_bl_ops,
+				&(const struct backlight_properties){
+					.type = BACKLIGHT_RAW,
+					.brightness = 1023,
+					.max_brightness = NX669J_BL_MAX,
+				});
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "failed to register backlight\n");
+
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_width = desc->dsc_slice_width;
+	ctx->dsc.slice_height = desc->dsc_slice_height;
+	ctx->dsc.slice_count = desc->modes[0].hdisplay / desc->dsc_slice_width;
+	ctx->dsc.bits_per_component = desc->dsc_bpc;
+	ctx->dsc.bits_per_pixel = desc->dsc_bpp << 4;	/* 4 fractional bits */
+	ctx->dsc.block_pred_enable = true;
+	/*
+	 * The panel's DSC decoder runs with Nubia's initial_xmit_delay of 512
+	 * rather than the DSC 1.1 table's 410 (for 10 bpp); with 410 each
+	 * slice starts right and then drifts into noise. The host keeps it.
+	 */
+	ctx->dsc.initial_xmit_delay = 512;
+	dsi->dsc = &ctx->dsc;
+	/* the NT37800A takes both slices of a line in one packet */
+	dsi->dsc_slice_per_pkt = desc->dsc_slice_per_pkt;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "failed to attach to DSI host\n");
+	}
+
+	dev_info(dev, "%s, %u modes, DSC %ux%u %u bpc\n", desc->name,
+		 desc->num_modes, desc->dsc_slice_width, desc->dsc_slice_height,
+		 desc->dsc_bpc);
+	return 0;
+}
+
+static void nx669j_remove(struct mipi_dsi_device *dsi)
+{
+	struct nx669j_panel *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id nx669j_of_match[] = {
+	{ .compatible = "nubia,nx669j-panel" },	/* variant from bootargs */
+	{ .compatible = "nubia,nx669j-nt37701", .data = &nt37701_desc },
+	{ .compatible = "nubia,nx669j-nt37701-b0", .data = &nt37701_b0_desc },
+	{ .compatible = "nubia,nx669j-nt37800a", .data = &nt37800a_desc },
+	{ .compatible = "nubia,nx669j-nt37800a-b6", .data = &nt37800a_b6_desc },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, nx669j_of_match);
+
+static struct mipi_dsi_driver nx669j_driver = {
+	.probe = nx669j_probe,
+	.remove = nx669j_remove,
+	.driver = {
+		.name = "panel-nubia-nx669j",
+		.of_match_table = nx669j_of_match,
+		.dev_groups = nx669j_dbg_groups,
+	},
+};
+module_mipi_dsi_driver(nx669j_driver);
+
+MODULE_DESCRIPTION("REDMAGIC 6 (NX669J) AMOLED panels");
+MODULE_LICENSE("GPL");
