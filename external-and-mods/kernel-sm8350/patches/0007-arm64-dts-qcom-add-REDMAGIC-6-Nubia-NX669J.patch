+	trigger@10 {
+		compatible = "nubia,nx669j-trigger-left";
+		reg = <0x10>;
+		interrupts-extended = <&tlmm 67 IRQ_TYPE_EDGE_FALLING>;
+		avdd-supply = <&pm8350c_l9>;
+		power-gpios = <&tlmm 66 GPIO_ACTIVE_LOW>;
+		/* bit 0: inner zone, bit 1: outer zone */
+		linux,keycodes = <BTN_TL BTN_TL2>;
