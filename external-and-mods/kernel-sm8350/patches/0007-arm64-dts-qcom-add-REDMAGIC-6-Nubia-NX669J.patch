+		};
+
+		tx-pins {
+			pins = "gpio70";
+			function = "qup18";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		rx-pins {
+			pins = "gpio71";
+			function = "qup18";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
+	bt_en: bt-en-state {
+		pins = "gpio65";
+		function = "gpio";
+		drive-strength = <16>;
+		output-low;
+		bias-pull-up;
+	};
+
+	wlan_en: wlan-en-state {
