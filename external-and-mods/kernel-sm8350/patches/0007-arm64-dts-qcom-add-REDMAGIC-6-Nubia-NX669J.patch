+/* Right shoulder trigger */
+&i2c6 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	trigger@10 {
+		compatible = "nubia,nx669j-trigger-right";
+		reg = <0x10>;
+		interrupts-extended = <&tlmm 13 IRQ_TYPE_EDGE_FALLING>;
+		avdd-supply = <&pm8350c_l9>;
+		power-gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;
+		/* bit 0: outer zone, bit 1: inner zone */
+		linux,keycodes = <BTN_TR2 BTN_TR>;
+		pinctrl-0 = <&trigger_r_int>;
+		pinctrl-names = "default";
+	};
+};
