From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zaviya-RM6 <exclaim_plethora227@simplelogin.com>
Date: Tue, 29 Sep 2026 00:30:42 -0500
Subject: [PATCH] Input: goodix-berlin - add GT9897 over I2C

The GT9897 (REDMAGIC 6) is already supported on SPI; its register map
(Berlin-A info and firmware addresses) is the same over I2C.
---
 drivers/input/touchscreen/goodix_berlin_i2c.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/input/touchscreen/goodix_berlin_i2c.c b/drivers/input/touchscreen/goodix_berlin_i2c.c
index 929090a..d2d868c 100644
--- a/drivers/input/touchscreen/goodix_berlin_i2c.c
+++ b/drivers/input/touchscreen/goodix_berlin_i2c.c
@@ -49,12 +49,18 @@ static int goodix_berlin_i2c_probe(struct i2c_client *client)
 	return 0;
 }
 
+static const struct goodix_berlin_ic_data gt9897_data = {
+	.fw_version_info_addr = GOODIX_BERLIN_FW_VERSION_INFO_ADDR_A,
+	.ic_info_addr = GOODIX_BERLIN_IC_INFO_ADDR_A,
+};
+
 static const struct goodix_berlin_ic_data gt9916_data = {
 	.fw_version_info_addr = GOODIX_BERLIN_FW_VERSION_INFO_ADDR_D,
 	.ic_info_addr = GOODIX_BERLIN_IC_INFO_ADDR_D,
 };
 
 static const struct i2c_device_id goodix_berlin_i2c_id[] = {
+	{ .name = "gt9897", .driver_data = (long)&gt9897_data },
 	{ .name = "gt9916", .driver_data = (long)&gt9916_data },
 	{ }
 };
@@ -62,6 +68,7 @@ static const struct i2c_device_id goodix_berlin_i2c_id[] = {
 MODULE_DEVICE_TABLE(i2c, goodix_berlin_i2c_id);
 
 static const struct of_device_id goodix_berlin_i2c_of_match[] = {
+	{ .compatible = "goodix,gt9897", .data = &gt9897_data },
 	{ .compatible = "goodix,gt9916", .data = &gt9916_data },
 	{ }
 };
-- 
