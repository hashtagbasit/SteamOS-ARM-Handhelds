# SM8750 (Snapdragon 8 Elite, Qualcomm ID CQ8725S): AYN Odin 3.
# Sourced by kernel-common/build.sh and kernel-common/cmdline.sh.
#
# Builds from source instead of extract-base-release.sh's prebuilt kernel, which
# has no tracefs -- see kernel-common/steamos.config for why that matters.

SOC=sm8750
ROCKNIX_DEVICE=SM8750

# kernel.org has no linux-7.2.0.tar.xz, only linux-7.2.tar.xz (SUBLEVEL=0,
# self-reports as "7.2.0" via uname -r, matching the prebuilt kernel).
KVER=7.2
ROCKNIX_REF=20260901

# No "default" patch dir at this ref (unlike SM8550/SM8650); build.sh
# already skips a missing patch dir.
PATCH_DIRS="projects/ROCKNIX/packages/linux/patches/7.2 projects/ROCKNIX/packages/linux/patches/mainline projects/ROCKNIX/devices/SM8750/patches/linux"

# SM8750_RECIPE=7.2 builds the kernel above (kernel-sm8750/patches); kernel-elden
# pins it. SM8750_RECIPE=7.4 (the default) is that recipe ported to Linux
# 7.4-rc1, with the patches in kernel-sm8750-74 (kernel-sm8750/patches stay on 7.2).
if [[ "${SM8750_RECIPE:-7.4}" == 7.4 ]]; then
  # Linux 7.4-rc1 from git.kernel.org's snapshot (rc releases are not on
  # cdn.kernel.org); build.sh unpacks it like any KSRC_URL tree.
  KVER=7.4-rc1
  KSRC_URL=https://git.kernel.org/torvalds/t/linux-7.4-rc1.tar.gz
  KSRC_SHA256=b19dd413fa7cc4059de8dab234320858e86abdc15c7c4d839eff15b0e2ac39ee
  PORT_DIRS="kernel-sm8750-74"
  PATCH_SKIP=""
  PATCH_SKIP+=" 9999-fix-rust-build-error.patch"
  PATCH_SKIP+=" 0005-Bluetooth-btrtl-Add-the-support-for-RTL8733BU.patch"
  PATCH_SKIP+=" 0028-drm-panel-Add-panel-driver-for-Chipone-ICNA35XX-base.patch"
  PATCH_SKIP+=" 0033-arm64-dts-qcom-sm8750-gpu-clock-controllers.patch"
  PATCH_SKIP+=" 0034-arm64-dts-qcom-sm8750-Add-UART15.patch"
  PATCH_SKIP+=" 0038-arm64-dts-qcom-sm8750-add-GPU-nodes.patch"
  PATCH_SKIP+=" 0049-drm-msm-a8xx-add-adreno-830-catalog.patch"
  PATCH_SKIP+=" 0050-clk-qcom-gxclkctl-kaanapali-fix-gx-gdsc-collapse.patch"
  PATCH_SKIP+=" 0052-pmdomain-qcom-rpmhpd-presync-floor-gmu-rails.patch"
  PATCH_SKIP+=" 0055-gpu-drm-panel-add-pocket-fit-panel.patch"
  PATCH_SKIP+=" 0060-ASoC-qcom-sc8280xp-enable-MI2S-bit-clock-on-BE-startup.patch"
  PATCH_SKIP+=" 0062-backlight-aw99706-honor-blank-power-state.patch"
  PATCH_SKIP+=" 0073-ASoC-wcd939x-add-HPH-PCM-HiFi-mode.patch"
  PATCH_SKIP+=" 0504-wakeup-qcom-ipcc-remove-IRQF-NO-SUSPEND.patch"
  PATCH_SKIP+=" 0517-usb-typec-mux-dont-swallow-EPROBE_DEFER.patch"
fi

# Odin 3: added by 0047-arm64-dts-qcom-Add-AYN-Odin3.patch. Pocket FIT
# Elite: the base's devices/SM8750/linux/dts. The prebuilt kernel carried
# both; without the Elite's the Elite wouldn't boot.
DTBS="cq8725s-ayn-odin3 sm8750-konkr-pf-elite"

# gmu/sqe/aqe: upstream linux-firmware, pinned to a release tag like the
# 8 Gen 2 (identical to main as of 2026-10-02). zap: Adreno-830-specific,
# only in the base's extra-firmware.
EXTRA_FW_REF=e1eb71af80427aa1fec1659d2967f7ba8bef83b5
LINUX_FW_REF=20260916
FW_BUILTIN=0
BUILTIN_FW="
lfw/qcom/gen80000_gmu.bin:qcom/gen80000_gmu.bin:1ad8175e6cd01ea76c64d20b83600038c52dd29844b48d57b11b769b038863a5
lfw/qcom/gen80000_sqe.fw:qcom/gen80000_sqe.fw:30ee3301534f95799d4afaf73864f3c369baa5a5dea8481e7f0cb8cc941f396c
lfw/qcom/gen80000_aqe.fw:qcom/gen80000_aqe.fw:67562ad5baae3a133c92a6e48a9d1b1a9a867fe2f85b49324e244e963f3b89c5
xfw/SM8750/qcom/sm8750/gen80000_zap.mbn:qcom/sm8750/gen80000_zap.mbn:e3cba8ddd549083568a4d733752bbe852ac8be25c643c0a48e5fa8a98f1335c3
"

# From a real Odin 3's /proc/cmdline; rootwait/quiet/video=efifb:off already
# added by kernel-common/cmdline.sh.
# fw_devlink.sync_state=timeout: see kernel-sm8650/soc.env.
CMDLINE_SOC="console=tty0 fw_devlink.sync_state=timeout irqaffinity=0-1 cgroup.memory=nokmem,nosocket nosoftlockup mem_sleep_default=s2idle"

EMBED_INITRAMFS=1
