From: hashtagbasit
Subject: input: rsinput: power the MCU down across system sleep

The MCU streams reports over the UART for as long as it is powered, and
each one is an interrupt that wakes the SoC out of s2idle (or, once the
UART has suspended, gets its IRQ disabled as spurious). Stop it, hold it in
reset and drop its supply on suspend; resume powers it back up before the
init commands. Written for this driver, which
has no suspend callback of its own.

--- a/drivers/input/joystick/rsinput.c	2026-10-02 05:53:52.522054838 +0200
+++ b/drivers/input/joystick/rsinput.c	2026-10-02 05:53:52.760054958 +0200
@@ -129,6 +129,7 @@
     struct input_dev *input;
     struct platform_device *platform_dev;
     struct regulator *vdd;
+    bool vdd_off;
     struct gpio_desc *boot_gpio;
     struct gpio_desc *enable_gpio;
     struct gpio_desc *reset_gpio;
@@ -659,17 +660,59 @@
     if (drv->reset_gpio)
         gpiod_set_value_cansleep(drv->reset_gpio, 0);
 
-    regulator_disable(drv->vdd);
+    if (!drv->vdd_off)
+        regulator_disable(drv->vdd);
+}
+
+/*
+ * System sleep: the MCU streams reports over the UART the whole time it is
+ * powered, and every one of them is an interrupt that wakes the SoC out of
+ * s2idle (or, once the UART is suspended, gets its IRQ disabled as spurious).
+ * Stop it, hold it in reset and drop its supply; resume powers it up again
+ * and re-sends the init commands.
+ */
+static int rsinput_suspend(struct device *dev)
+{
+    struct rsinput_driver *drv = dev_get_drvdata(dev);
+    int error;
+
+    if (drv->enable_gpio)
+        gpiod_set_value_cansleep(drv->enable_gpio, 0);
+
+    if (drv->reset_gpio)
+        gpiod_set_value_cansleep(drv->reset_gpio, 0);
+
+    if (!drv->vdd_off) {
+        error = regulator_disable(drv->vdd);
+        if (error) {
+            dev_err(dev, "Failed to disable MCU supply: %d\n", error);
+            rsinput_init_commands(drv);
+            return error;
+        }
+        drv->vdd_off = true;
+    }
+
+    return 0;
 }
 
 static int rsinput_resume(struct device *dev)
 {
     struct rsinput_driver *drv = dev_get_drvdata(dev);
+    int error;
+
+    if (drv->vdd_off) {
+        error = regulator_enable(drv->vdd);
+        if (error) {
+            dev_err(dev, "Failed to enable MCU supply: %d\n", error);
+            return error;
+        }
+        drv->vdd_off = false;
+    }
 
     return rsinput_init_commands(drv);
 }
 
-static DEFINE_SIMPLE_DEV_PM_OPS(rsinput_pm_ops, NULL, rsinput_resume);
+static DEFINE_SIMPLE_DEV_PM_OPS(rsinput_pm_ops, rsinput_suspend, rsinput_resume);
 
 static const struct of_device_id rsinput_of_match[] = {
     { .compatible = "gamepad,rsinput" },
