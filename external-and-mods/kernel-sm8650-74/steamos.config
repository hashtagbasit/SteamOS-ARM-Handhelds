# SM8650-only additions (merged after kernel-common/steamos.config).

# KONKR MCU UART client (system buttons, stick RGB, gamepad mode), patches
# 0001/0002/0004. On by default on the Pocket FIT (`konkrctl mcu disable`).
CONFIG_INPUT_KONKR_SYSBTN=m

# NETFILTER_XT_TARGET_NAT became NETFILTER_XT_NAT on 7.4, which the common
# fragment already sets. The old names show up as WARN lines in the build log.

# Binder for Lepton. 7.4 has only the Rust driver, the C one is gone. The device
# names come from the common fragment.
CONFIG_RUST=y
CONFIG_ANDROID_BINDER_IPC_RUST=y
