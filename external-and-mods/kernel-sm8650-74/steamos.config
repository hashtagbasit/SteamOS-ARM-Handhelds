# SM8650-only additions (merged after kernel-common/steamos.config).

# KONKR MCU UART client (system buttons, stick RGB, gamepad mode), patches
# 0001/0002/0004. On by default on the Pocket FIT (`konkrctl mcu disable`).
CONFIG_INPUT_KONKR_SYSBTN=m

# Linux 7.4 dropped the C binder driver (ANDROID_BINDER_IPC, ANDROID_BINDERFS,
# ANDROID_BINDER_DEVICES): the common fragment's binder lines cannot apply
# here, only Rust binder (ANDROID_BINDER_IPC_RUST, needs RUST) is left. And
# NETFILTER_XT_TARGET_NAT became NETFILTER_XT_NAT, which the common fragment
# already sets. Both show up as WARN lines in the build log.
