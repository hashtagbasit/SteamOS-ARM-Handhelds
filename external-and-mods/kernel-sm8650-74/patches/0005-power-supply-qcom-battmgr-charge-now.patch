From: hashtagbasit
Subject: power: supply: qcom_battmgr: charge unit and CHARGE_NOW on SM8550-class firmware

This firmware never sends BATTMGR_BAT_INFO, so the charge unit stays unset
and CHARGE_FULL* read as -ENODATA; it also reports the remaining charge
only as BATT_CHG_COUNTER. Set the unit to mAh and expose the counter as
CHARGE_NOW too, so UPower (and Steam) can work out the time left.
Same fix as the upstream series (lkml 2608.3/10890, 10893).

---
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -439,6 +439,7 @@
 	[POWER_SUPPLY_PROP_TEMP] = BATT_TEMP,
 	[POWER_SUPPLY_PROP_TECHNOLOGY] = BATT_TECHNOLOGY,
 	[POWER_SUPPLY_PROP_CHARGE_COUNTER] =  BATT_CHG_COUNTER,
+	[POWER_SUPPLY_PROP_CHARGE_NOW] = BATT_CHG_COUNTER,
 	[POWER_SUPPLY_PROP_CYCLE_COUNT] = BATT_CYCLE_COUNT,
 	[POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN] =  BATT_CHG_FULL_DESIGN,
 	[POWER_SUPPLY_PROP_CHARGE_FULL] = BATT_CHG_FULL,
@@ -908,6 +909,7 @@
 	POWER_SUPPLY_PROP_TEMP,
 	POWER_SUPPLY_PROP_TECHNOLOGY,
 	POWER_SUPPLY_PROP_CHARGE_COUNTER,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
 	POWER_SUPPLY_PROP_CYCLE_COUNT,
 	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
 	POWER_SUPPLY_PROP_CHARGE_FULL,
@@ -1443,7 +1445,10 @@
 			battmgr->info.technology = le32_to_cpu(resp->intval.value);
 			break;
 		case BATT_CHG_COUNTER:
-			battmgr->info.charge_count = le32_to_cpu(resp->intval.value);
+			val = le32_to_cpu(resp->intval.value);
+			battmgr->info.charge_count = val;
+			/* SM8350-class firmware: this is the remaining charge (uAh) */
+			battmgr->status.capacity = val;
 			break;
 		case BATT_CYCLE_COUNT:
 			battmgr->info.cycle_count = le32_to_cpu(resp->intval.value);
@@ -1690,6 +1695,9 @@
 			return dev_err_probe(dev, PTR_ERR(battmgr->wls_psy),
 					     "failed to register wireless charing power supply\n");
 	} else {
+		/* no BATTMGR_BAT_INFO from this firmware: it reports mAh */
+		battmgr->unit = QCOM_BATTMGR_UNIT_mAh;
+
 		if (battmgr->variant == QCOM_BATTMGR_SM8550)
 			psy_desc = &sm8550_bat_psy_desc;
 		else
