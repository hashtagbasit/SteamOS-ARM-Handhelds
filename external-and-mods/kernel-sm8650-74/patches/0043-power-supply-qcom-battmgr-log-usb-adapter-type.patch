From: Zaviya
Subject: [PATCH] power: supply: qcom_battmgr: log USB adapter type

Qualcomm's battery manager firmware exposes both USB_TYPE and
USB_ADAP_TYPE. Keep reporting USB_TYPE through the existing power supply
interface, but query USB_ADAP_TYPE as a best-effort diagnostic whenever
USB_TYPE is read.

Log the raw pair at info level when it changes. A failed adapter-type
query is rate-limited and does not fail the existing USB_TYPE read.

7.4 port: the kernel already reports USB_ADAP_TYPE as the USB type, so the
extra query is for USB_TYPE and the log keeps the same pair.

---
 drivers/power/supply/qcom_battmgr.c |   27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index 3f5a862ec..0feb588e8 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -295,12 +295,16 @@ struct qcom_battmgr_ac {
 
 struct qcom_battmgr_usb {
 	bool online;
+	bool type_pair_reported;
 	unsigned int voltage_now;
 	unsigned int voltage_max;
 	unsigned int current_now;
 	unsigned int current_max;
 	unsigned int current_limit;
 	unsigned int usb_type;
+	unsigned int protocol_type;
+	unsigned int reported_protocol_type;
+	unsigned int reported_usb_type;
 };
 
 struct qcom_battmgr_wireless {
@@ -1057,6 +1061,7 @@ static int qcom_battmgr_usb_sm8350_update(struct qcom_battmgr *battmgr,
 					  enum power_supply_property psp)
 {
 	unsigned int prop;
+	int adapter_ret;
 	int ret;
 
 	if (psp >= ARRAY_SIZE(sm8350_usb_prop_map))
@@ -1066,6 +1071,25 @@ static int qcom_battmgr_usb_sm8350_update(struct qcom_battmgr *battmgr,
 
 	mutex_lock(&battmgr->lock);
 	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, prop, 0);
+	if (!ret && psp == POWER_SUPPLY_PROP_USB_TYPE) {
+		/* 7.4 reports USB_ADAP_TYPE as the USB type; read USB_TYPE too */
+		adapter_ret = qcom_battmgr_request_property(battmgr,
+						       BATTMGR_USB_PROPERTY_GET,
+						       USB_TYPE, 0);
+		if (adapter_ret) {
+			dev_warn_ratelimited(battmgr->dev,
+					     "failed to read USB protocol type: %d\n",
+					     adapter_ret);
+		} else if (!battmgr->usb.type_pair_reported ||
+			   battmgr->usb.protocol_type != battmgr->usb.reported_protocol_type ||
+			   battmgr->usb.usb_type != battmgr->usb.reported_usb_type) {
+			dev_info(battmgr->dev, "USB protocol type %u, adapter type %u\n",
+				 battmgr->usb.protocol_type, battmgr->usb.usb_type);
+			battmgr->usb.reported_protocol_type = battmgr->usb.protocol_type;
+			battmgr->usb.reported_usb_type = battmgr->usb.usb_type;
+			battmgr->usb.type_pair_reported = true;
+		}
+	}
 	mutex_unlock(&battmgr->lock);
 
 	return ret;
@@ -1627,6 +1651,9 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 		case USB_ADAP_TYPE:
 			battmgr->usb.usb_type = le32_to_cpu(resp->intval.value);
 			break;
+		case USB_TYPE:
+			battmgr->usb.protocol_type = le32_to_cpu(resp->intval.value);
+			break;
 		default:
 			dev_warn(battmgr->dev, "unknown property %#x\n", property);
 			break;
