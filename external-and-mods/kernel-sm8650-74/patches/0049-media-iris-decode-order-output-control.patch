From: hashtagbasit
Subject: media: iris: let decoder clients ask for decode-order output

The firmware holds decoded pictures back until they are due in display
order. A client that reorders frames itself, such as a VA-API driver built
on this decoder, needs each picture back as soon as it is decoded: with
B-frames it otherwise arrives one frame late and the client stalls.

Map V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY_ENABLE to the firmware's decode
order output property (HFI_PROP_DECODE_ORDER_OUTPUT, as the downstream
video driver sets it for a zero display delay) on the gen2 platforms
(SM8550, SM8650, SM8750). Off by default, so existing clients see no
change.

---
 drivers/media/platform/qcom/iris/iris_ctrls.c      |    4 ++++
 drivers/media/platform/qcom/iris/iris_hfi_gen2.c   |   18 ++++++++++++++++++
 .../platform/qcom/iris/iris_hfi_gen2_defines.h     |    1 +
 .../platform/qcom/iris/iris_platform_common.h      |    1 +
 4 files changed, 24 insertions(+)

diff --git a/drivers/media/platform/qcom/iris/iris_ctrls.c b/drivers/media/platform/qcom/iris/iris_ctrls.c
index 4f2633bbb..ae133e76e 100644
--- a/drivers/media/platform/qcom/iris/iris_ctrls.c
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.c
@@ -25,6 +25,8 @@ static enum platform_inst_fw_cap_type iris_get_cap_id(u32 id)
 	switch (id) {
 	case V4L2_CID_MPEG_VIDEO_H264_PROFILE:
 		return PROFILE_H264;
+	case V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY_ENABLE:
+		return DEC_OUTPUT_ORDER;
 	case V4L2_CID_MPEG_VIDEO_HEVC_PROFILE:
 		return PROFILE_HEVC;
 	case V4L2_CID_MPEG_VIDEO_VP9_PROFILE:
@@ -176,6 +178,8 @@ static u32 iris_get_v4l2_id(enum platform_inst_fw_cap_type cap_id)
 	switch (cap_id) {
 	case PROFILE_H264:
 		return V4L2_CID_MPEG_VIDEO_H264_PROFILE;
+	case DEC_OUTPUT_ORDER:
+		return V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY_ENABLE;
 	case PROFILE_HEVC:
 		return V4L2_CID_MPEG_VIDEO_HEVC_PROFILE;
 	case PROFILE_VP9:
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen2.c b/drivers/media/platform/qcom/iris/iris_hfi_gen2.c
index dedb744f9..70f90cbac 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2.c
@@ -1105,6 +1105,24 @@ static const struct platform_inst_fw_cap inst_fw_cap_sm8550_dec[] = {
 		.flags = CAP_FLAG_INPUT_PORT,
 		.set = iris_set_u32,
 	},
+	{
+		/*
+		 * V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY_ENABLE with no delay:
+		 * the firmware returns every picture as soon as it is decoded,
+		 * in decode order, instead of holding frames back for display
+		 * order. Clients that reorder themselves (VA-API on top of this
+		 * decoder) need it, or a stream with B-frames comes back a frame
+		 * late. Only a zero delay exists, so there is no delay control.
+		 */
+		.cap_id = DEC_OUTPUT_ORDER,
+		.min = 0,
+		.max = 1,
+		.step_or_mask = 1,
+		.value = 0,
+		.hfi_id = HFI_PROP_DECODE_ORDER_OUTPUT,
+		.flags = CAP_FLAG_INPUT_PORT,
+		.set = iris_set_u32,
+	},
 };
 
 static const struct platform_inst_fw_cap inst_fw_cap_sm8550_enc[] = {
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen2_defines.h b/drivers/media/platform/qcom/iris/iris_hfi_gen2_defines.h
index 2b8b057d3..e89ed4075 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_defines.h
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_defines.h
@@ -130,6 +130,7 @@ enum hfi_flip {
 
 #define HFI_PROP_FLIP				0x0300014c
 #define HFI_PROP_SIGNAL_COLOR_INFO		0x03000155
+#define HFI_PROP_DECODE_ORDER_OUTPUT		0x0300015b
 #define HFI_PROP_PICTURE_TYPE			0x03000162
 #define HFI_PROP_DEC_DEFAULT_HEADER		0x03000168
 #define HFI_PROP_DEC_START_FROM_RAP_FRAME	0x03000169
diff --git a/drivers/media/platform/qcom/iris/iris_platform_common.h b/drivers/media/platform/qcom/iris/iris_platform_common.h
index cddab9a9c..65976f57c 100644
--- a/drivers/media/platform/qcom/iris/iris_platform_common.h
+++ b/drivers/media/platform/qcom/iris/iris_platform_common.h
@@ -211,6 +211,7 @@ enum platform_inst_fw_cap_type {
 	SLICE_MODE,
 	SLICE_MAX_BYTES,
 	SLICE_MAX_MB,
+	DEC_OUTPUT_ORDER,
 	INST_FW_CAP_MAX,
 };
 
