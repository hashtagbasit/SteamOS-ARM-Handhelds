# Lenovo Legion Y700 Gen 4 (elden): what the 8 Elite rootfs takes from
# the pinned upstream port tree (ELDEN_SRC_URL):
#  - firmware.json: the files Linux needs and their SHA-256, which
#    tablet-firmware copies out of the tablet's own Android partitions
#    (the firmware is signed for the device and can't be shipped)
#  - the AudioReach topology source and the UCM profile
ELDEN_SRC_URL=https://github.com/h0cheung/tb322fc-linux/archive/731b902dbd1edfdb4ed43a5511423eb741cff350.tar.gz
# The generated topology must come out byte-identical to the one validated
# on the tablet (firmware.json, "generated": true).
ELDEN_TPLG_SHA256=597eb974b3f4927097ff213d16800385d08671901267bcb626955ed325df261b
# Where the tablet's firmware lives: not /usr, which updates replace.
ELDEN_FW_DIR=/var/lib/steamos-arm/firmware/elden

# Boot image: header v4 with an AVB hash footer, signed with AOSP's public
# test key (Lenovo's ABL wants the footer even unlocked).
AVBTOOL_URL="https://android.googlesource.com/platform/external/avb/+/refs/tags/android-15.0.0_r1/avbtool.py?format=TEXT"
AVBTOOL_SHA256=78a50c8620985709f2e131cf948dcd66ecc43f09ed735e09d75751a7e21e4eb8
AVB_TESTKEY_URL="https://android.googlesource.com/platform/external/avb/+/refs/tags/android-15.0.0_r1/test/data/testkey_rsa4096.pem?format=TEXT"
AVB_TESTKEY_SHA256=6a224754880a57ab9cbd308267cd157d94cf05a1c8cb851aec4090e045d24121
ELDEN_BOOT_PARTITION_SIZE=100663296
