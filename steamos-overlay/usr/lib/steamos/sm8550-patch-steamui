#!/bin/bash
# Frame / steamdeck_stable ARM Gamepad UI hangs the library spinner until
# AppStore sees update_complete(). This client only sends partial overviews
# (CURLStore 136/9, no asset URLs), so that flag never arrives.
# Minified names change between builds — patch by regex, not a fixed string.
set +e
root="${1:-/home/steamos/.local/share/Steam/steamui}"
python3 - "$root" <<'PY'
import re
import sys
from pathlib import Path

root = Path(sys.argv[1])
if not root.is_dir():
    sys.exit(0)

# Original (names vary):
#   await new Promise((e,t)=>{let r=e;SteamClient.Apps.RegisterForAppOverviewChanges(e=>{this.UpdateAppOverview(e)&&(this.m_bIsInitialized=!0,r&&r(),r=null)})})
# Resolve on first overview OR after 1.5s. Overlay/QAM already work; this
# is what leaves the Steam wheel spinning on a logged-in session.
# Closing sequence after `r=null` is `)})}`  →  ) } ) } )
_END = r"\)" r"\}" r"\)" r"\}" r"\)"
APP_WAIT = re.compile(
    r"await new Promise\(\((\w+),(\w+)\)=>\{let (\w+)=\1;"
    r"SteamClient\.Apps\.RegisterForAppOverviewChanges\((\w+)=>\{"
    r"this\.UpdateAppOverview\(\4\)&&\(this\.m_bIsInitialized=!0,"
    r"\3&&\3\(\),\3=null" + _END
)
APP_WAIT_NEW = (
    r"await new Promise((\1,\2)=>{let \3=\1;"
    r"const done=()=>{this.m_bIsInitialized=!0;\3&&\3();\3=null};"
    r"setTimeout(done,1500);"
    r"SteamClient.Apps.RegisterForAppOverviewChanges(\4=>{"
    r"this.UpdateAppOverview(\4);done()})})"
)

# BootStrapperInhibitAll (steam.cfg) makes the client report eresult
# Blocked (40) for its own update. Settings shows an error and the OOBE
# update step is stuck on "Unable to download the required update (40)".
# Treat Blocked like OK in both check and apply results.
#   for(const q of he)if(q.eresult!=a.R){  →  ...if(q.eresult!=a.R&&q.eresult!=40){
BLOCKED = re.compile(
    r"(GetMostSpecific(?:Check|Apply)Result\(\)\{const (\w+)=this\.m_updateState\."
    r"update_(?:check|apply)_results\?\?\[\{eresult:[\w.$]+\}\];let [\w$]+=!1;"
    r"for\(const ([\w$]+) of \2\)if\(\3\.eresult!=[\w.$]+)\)"
)

# Exact leftovers from older steamui builds.
EXACT = [
    (
        "SetAutoPairDeviceTypes(w){this.m_rgAutoPairDeviceTypes=w,this.m_rgAutoPairDeviceTypes.length",
        "SetAutoPairDeviceTypes(w){this.m_rgAutoPairDeviceTypes=w||[],this.m_rgAutoPairDeviceTypes.length",
    ),
    (
        'ResolveURL(C,...f){const D=this.m_steamUrls[C];if(!D)return;let L=D.url;',
        'ResolveURL(C,...f){const D=this.m_steamUrls[C];if(!D)return"https://store.steampowered.com/";let L=D.url;',
    ),
    (
        "this.m_vecLoginUsers=await SteamClient.User.GetLoginUsers()",
        "this.m_vecLoginUsers=(await SteamClient.User.GetLoginUsers())||[]",
    ),
    (
        "this.m_hOverlayChatBrowserInfoChanged=SteamClient.WebChat.RegisterOverlayChatBrowserInfoChanged(this.OnOverlayChatBrowserInfoChanged),this.m_CMInterface.RunWhenLoggedOn(()=>{this.OnOverlayChatBrowserInfoChanged()})",
        "this.m_hOverlayChatBrowserInfoChanged=SteamClient.WebChat&&SteamClient.WebChat.RegisterOverlayChatBrowserInfoChanged&&SteamClient.WebChat.RegisterOverlayChatBrowserInfoChanged(this.OnOverlayChatBrowserInfoChanged),this.m_CMInterface&&this.m_CMInterface.RunWhenLoggedOn(()=>{SteamClient.WebChat&&this.OnOverlayChatBrowserInfoChanged()})",
    ),
]

changed = 0
for p in list(root.glob("chunk*.js")) + list(root.glob("library.js")):
    txt = p.read_text(errors="replace")
    orig = txt
    if "setTimeout(done,1500)" not in txt or "RegisterForAppOverviewChanges" not in txt:
        txt, n = APP_WAIT.subn(APP_WAIT_NEW, txt, count=1)
        if n:
            print(f"patched AppStore wait in {p.name}", file=sys.stderr)
    txt, n = BLOCKED.subn(lambda m: f"{m.group(1)}&&{m.group(3)}.eresult!=40)", txt)
    if n:
        print(f"patched updater Blocked(40) x{n} in {p.name}", file=sys.stderr)
    for old, new in EXACT:
        if old in txt:
            txt = txt.replace(old, new)
    complete = "return l&&s.oy.ScopeRunningApps(),w.md.OnAppOverviewChange(a,n),t.update_complete()}"
    complete_new = "return l&&s.oy.ScopeRunningApps(),w.md.OnAppOverviewChange(a,n),(this.m_bIsInitialized=!0,!0)}"
    if complete in txt:
        txt = txt.replace(complete, complete_new)
        print(f"forced update_complete in {p.name}", file=sys.stderr)
    if txt != orig:
        p.write_text(txt)
        changed += 1
        print(f"wrote {p.name}", file=sys.stderr)

# The guided tour's title is fixed text in Steam's strings; it doesn't read
# os-release. Every language names the OS the same way.
WELCOME = re.compile(r'("GuidedTour_(?:SteamOS_Welcome_Title|Welcome_Title_LGS)":"[^"]*?)SteamOS')
for p in root.glob("localization/steamui_*-json.js"):
    txt = p.read_text(errors="replace")
    new, n = WELCOME.subn(r"\1Zaviya", txt)
    if n:
        p.write_text(new)
        changed += 1
        print(f"named the welcome title in {p.name}", file=sys.stderr)

print(f"steamui files patched: {changed}", file=sys.stderr)
PY
exit 0
