#!/bin/bash
# Lenovo Legion Y700 Gen 4, SteamOS started from boot_b (on the microSD card,
# or on internal storage in its own "steamos" partition, see
# tablet-dualboot-install) with ZUXOS left on slot A: switch the slot the
# bootloader starts.
#
#   tablet-slot android   start ZUXOS (slot A) from the next boot on, and restart
#   tablet-slot status    which slot is active, and whether this is a dual boot
#   tablet-slot activate a|b   make that slot the active one (no restart)
#
# With the boot menu (tablet-bootmenu-install) slot A starts a menu that offers
# ZUXOS and SteamOS: "android" then restarts into that menu, where ZUXOS is
# picked with the volume keys.
#
# The stock Qualcomm bootloader keeps the slot state in the GPT attributes of
# boot_a / boot_b: bit 50 active, 51-53 retries, 54 successful, 55 unbootable.
# Back to SteamOS from ZUXOS: fastboot set_active b.
set -euo pipefail
part() { readlink -f "/dev/disk/by-partlabel/boot_$1"; }
bits() {  # bits <slot>: the attribute bits of boot_<slot>, space separated
  local p; p=$(part "$1"); local disk=/dev/$(lsblk -no PKNAME "$p") num; num=$(cat "/sys/class/block/${p##*/}/partition")
  sfdisk --part-attrs "$disk" "$num" | sed -n 's/.*GUID:\([0-9,]*\).*/\1/p' | tr ',' ' '
}
setbits() {  # setbits <slot> <bits...>
  local s=$1; shift
  local p; p=$(part "$s"); local disk=/dev/$(lsblk -no PKNAME "$p") num; num=$(cat "/sys/class/block/${p##*/}/partition")
  local other; other=$(sfdisk --part-attrs "$disk" "$num" | sed 's/GUID:[0-9,]*//; s/^ *//; s/ *$//')
  local list; list=$(printf '%s\n' "$@" | sort -nu | tr '\n' ',' | sed 's/,$//')
  sfdisk --part-attrs "$disk" "$num" "${other:+$other }${list:+GUID:$list}" >/dev/null
}
sd_boot() { findmnt -no SOURCE / | grep -q mmcblk; }
dual_boot() { sd_boot || [[ $(lsblk -no PARTLABEL "$(findmnt -no SOURCE /)" 2>/dev/null) == steamos ]]; }
menu_installed() { [[ -f ${BOOTMENU_STATE:-/var/lib/steamos-arm/kshimc}/state.env ]]; }
# activate <slot>: that slot active with its retries back at 7 and not
# unbootable; the other one only inactive.
activate() {
  local s=$1 o x y
  [[ $s == a || $s == b ]] || { echo "usage: tablet-slot activate a|b" >&2; exit 2; }
  if [[ $s == a ]]; then o=b; else o=a; fi
  x=$(bits "$s" | tr ' ' '\n' | grep -vxE '50|55|51|52|53' || true)
  y=$(bits "$o" | tr ' ' '\n' | grep -vx 50 || true)
  # shellcheck disable=SC2086
  setbits "$s" $x 50 51 52 53
  # shellcheck disable=SC2086
  setbits "$o" $y
  sync
}
case "${1:-status}" in
  status)
    for s in a b; do echo "boot_$s: $(bits $s)"; done
    menu_installed && echo "boot menu installed (slot A shows Android / SteamOS)"
    if sd_boot; then echo "running from the microSD card (dual boot)"
    elif dual_boot; then echo "running from internal storage next to ZUXOS (dual boot)"
    else echo "running from internal storage"; fi
    ;;
  activate)
    [[ $(id -u) == 0 ]] || exec pkexec "$0" "$@"
    activate "${2:-}"
    ;;
  android)
    dual_boot || { echo "SteamOS replaced ZUXOS on this tablet: there's no ZUXOS to start" >&2; exit 1; }
    [[ $(id -u) == 0 ]] || exec pkexec "$0" "$@"
    activate a
    if menu_installed; then
      echo "Restarting into the boot menu: pick Android with the volume keys. Back to SteamOS: fastboot set_active b"
    else
      echo "ZUXOS starts from the next boot; back to SteamOS: fastboot set_active b"
    fi
    systemctl reboot
    ;;
  *) echo "usage: tablet-slot status|android|activate a|b" >&2; exit 2 ;;
esac
