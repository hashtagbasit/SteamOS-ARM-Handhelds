#!/usr/bin/env python3
"""Small fixes to Decky plugins from the store that break on the Steam client
we ship, applied where they're installed (~/homebrew/plugins) and only while
the broken code is still there: once a plugin ships its own fix, nothing
matches and nothing changes. Decky is restarted when something was fixed,
since it has already loaded the old code.

- SteamGridDB 1.7.1: the Steam beta changed its footer button glyph, so the
  plugin's lookup found nothing and its panel crashed on open. Upstream fixed
  the lookup (SteamGridDB/decky-steamgriddb#175, not released yet); this is
  the same check.

- Decky loader: 3.3.0 bundles Python 3.14, whose _ssl box64 can't load, so the
  x86-64 PluginLoader crash-looped (plugin_loader.service restarting every few
  seconds, Decky gone from Quick Access). Decky now has a native aarch64 build,
  which the image carries in /usr/share/steamos-arm/decky. If the installed
  ~/homebrew/services/PluginLoader is still an x86-64 ELF it is swapped for
  that build (plugins and settings stay), and any box64 ExecStart left in an
  /etc unit or drop-in is rewritten to run it directly. Runs before Decky at
  boot, so no restart is normally needed; idempotent.

It also installs the plugins the image bundles in /usr/share/steamos-arm/
decky-plugins, which updates can't put in the home folder themselves
(updaters before 1.4 only carry two plugin folders). Each bundled version
is installed once: a plugin removed in Decky stays removed until a newer one
comes with an update.
"""
import glob
import json
import os
import re
import shutil
import subprocess

LOADER = "/home/steamos/homebrew/services/PluginLoader"
LOADER_VERSION = "/home/steamos/homebrew/services/.loader.version"
NATIVE_LOADER = "/usr/share/steamos-arm/decky/PluginLoader-arm64"
UNIT_FILES = [
    "/etc/systemd/system/plugin_loader.service",
    "/usr/lib/systemd/system/plugin_loader.service",
]
UNIT_DROPIN_DIRS = [
    "/etc/systemd/system/plugin_loader.service.d",
    "/usr/lib/systemd/system/plugin_loader.service.d",
]
EM_X86_64, EM_AARCH64 = 0x3E, 0xB7
PLUGINS = "/home/steamos/homebrew/plugins"
BUNDLED = "/usr/share/steamos-arm/decky-plugins"
STATE = "/var/lib/steamos-arm/bundled-plugins.json"

FIXES = [
    ("SteamGridDB footer glyph", "*/dist/index.js",
     "const FooterGlyph = DFL.findModuleExport((e) => e?.toString && e.toString().includes('.Knockout') "
     "&& e.toString().includes('.additionalClassName'));",
     "const FooterGlyph = DFL.findModuleExport((e) => { if (typeof e !== 'function') return false; "
     "const s = e.toString(); return s.includes('.additionalClassName') && (s.includes('.Knockout') || "
     "(s.includes('bIsKnockout') && s.includes('#ControllerButton_A'))); });"),
]


def version(folder):
    try:
        with open(os.path.join(folder, "package.json"), encoding="utf-8") as fh:
            return json.load(fh).get("version", "")
    except (OSError, ValueError):
        return ""


def elf_machine(path):
    """e_machine of an ELF file, or None if it is missing or not ELF."""
    try:
        with open(path, "rb") as fh:
            head = fh.read(20)
    except OSError:
        return None
    if len(head) < 20 or head[:4] != b"\x7fELF":
        return None
    return int.from_bytes(head[18:20], "little")


def repair_loader():
    """Swap an x86-64 PluginLoader for the native build; drop box64 from units.
    Returns a list of what changed."""
    changed = []
    if elf_machine(LOADER) == EM_X86_64:
        if elf_machine(NATIVE_LOADER) != EM_AARCH64:
            print("decky-plugin-fixes: x86 PluginLoader found but no native build in the image")
        else:
            tmp = LOADER + ".new"
            shutil.copyfile(NATIVE_LOADER, tmp)
            os.chmod(tmp, 0o755)
            subprocess.run(["chown", "1000:1000", tmp], check=False)
            os.replace(tmp, LOADER)
            try:
                with open(NATIVE_LOADER + ".version", encoding="utf-8") as fh:
                    ver = fh.read().strip()
                with open(LOADER_VERSION, "w", encoding="utf-8") as fh:
                    fh.write(ver + "\n")
                subprocess.run(["chown", "1000:1000", LOADER_VERSION], check=False)
            except OSError:
                pass
            changed.append("PluginLoader x86-64 -> native arm64")
    # Only touch units once the binary is native, or they would stop starting it.
    if elf_machine(LOADER) == EM_AARCH64:
        files = list(UNIT_FILES)
        for d in UNIT_DROPIN_DIRS:
            files += glob.glob(os.path.join(d, "*.conf"))
        for path in files:
            try:
                with open(path, encoding="utf-8") as fh:
                    text = fh.read()
            except (OSError, UnicodeDecodeError):
                continue
            new = re.sub(r"^(ExecStart=)\S*box64\S*\s+(\S*PluginLoader\S*)\s*$",
                         r"\1\2", text, flags=re.M)
            if new == text:
                continue
            try:
                with open(path + ".fix", "w", encoding="utf-8") as fh:
                    fh.write(new)
                os.replace(path + ".fix", path)
            except OSError as e:  # overlay /etc can refuse; the /usr drop-in still wins
                print(f"decky-plugin-fixes: could not rewrite {path}: {e}")
                continue
            changed.append(f"box64 removed from {path}")
    if changed:
        subprocess.run(["systemctl", "daemon-reload"], check=False)
    return changed


def install_bundled():
    try:
        with open(STATE, encoding="utf-8") as fh:
            done = json.load(fh)
    except (OSError, ValueError):
        done = {}
    installed = []
    for src in sorted(glob.glob(f"{BUNDLED}/*/")):
        name = os.path.basename(src.rstrip("/"))
        want = version(src)
        dst = os.path.join(PLUGINS, name)
        if done.get(name) == want:
            continue
        if not os.path.isdir(dst) or version(dst) != want:
            tmp = dst + ".new"
            shutil.rmtree(tmp, ignore_errors=True)
            shutil.copytree(src, tmp, symlinks=True)
            subprocess.run(["chown", "-R", "1000:1000", tmp], check=False)
            shutil.rmtree(dst, ignore_errors=True)
            os.replace(tmp, dst)
            installed.append(f"{name} {want}")
        done[name] = want
    if done:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE + ".tmp", "w", encoding="utf-8") as fh:
            json.dump(done, fh)
        os.replace(STATE + ".tmp", STATE)
    return installed


def main() -> int:
    fixed = []
    fixed += repair_loader()
    if os.path.isdir(PLUGINS):
        fixed += [f"installed {p}" for p in install_bundled()]
    for name, pattern, old, new in FIXES:
        for path in glob.glob(f"{PLUGINS}/{pattern}"):
            try:
                with open(path, encoding="utf-8") as fh:
                    text = fh.read()
            except (OSError, UnicodeDecodeError):
                continue
            if old not in text:
                continue
            with open(path + ".fix", "w", encoding="utf-8") as fh:
                fh.write(text.replace(old, new))
            subprocess.run(["chown", "--reference", path, path + ".fix"], check=False)
            subprocess.run(["chmod", "--reference", path, path + ".fix"], check=False)
            os.replace(path + ".fix", path)
            fixed.append(f"{name} ({path})")
    for f in fixed:
        print(f"decky-plugin-fixes: {f}")
    if fixed:
        # --no-block: this unit runs before Decky, so waiting for its restart
        # here would wait on ourselves
        subprocess.run(["systemctl", "--no-block", "try-restart", "plugin_loader.service"], check=False)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
