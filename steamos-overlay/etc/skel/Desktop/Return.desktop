[Desktop Entry]
Name=Return to Gaming Mode
Comment=Leave Plasma and return to Game Mode
Exec=bash -c "exec 9>/tmp/steamos-return-to-game.lock; flock -n 9 || exit 0; steamos-session-select gamescope || { sleep 2; steamos-session-select gamescope; } || qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout"
Icon=steamos-gamemode
Terminal=false
Type=Application
StartupNotify=false
Categories=Game;
